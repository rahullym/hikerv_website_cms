# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/hikerv?retryWrites=true&w=majority

# JWT secret for signing admin session cookies (generate with: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string

# AWS S3 for image uploads
S3_BUCKET=hikerv-cms-images
S3_REGION=ap-southeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=
# CloudFront distribution URL serving the S3 bucket (no trailing slash)
CLOUDFRONT_URL=https://d1234abcd.cloudfront.net

# Vercel Deploy Hook URL — triggered by "Publish" button in admin
VERCEL_BUILD_HOOK=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy

# Bootstrap admin user (only used on first run if no users exist in Mongo)
BOOTSTRAP_ADMIN_EMAIL=admin@hikerv.com.au
BOOTSTRAP_ADMIN_PASSWORD=

# Email notifications for newsletter signups and contact-form leads.
# Powered by Resend (https://resend.com). Optional — submissions still
# save to Mongo if these aren't set; the admin just won't get emailed.
RESEND_API_KEY=
NOTIFY_EMAIL=explore@hikerv.com.au
NOTIFY_FROM_EMAIL=Hike RV <onboarding@resend.dev>
