---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MoodBoardSection from '../components/MoodBoardSection.astro';
import LayoutSection from '../components/LayoutSection.astro';
import SpecIcon from './SpecIcon.astro';
import type { VariantPublic } from '../lib/cms/products';

interface Props {
  variant: VariantPublic;
  /** Optional override: which series page to link back to. Defaults to /<seriesSlug>. */
  seriesHref?: string;
  /** Optional override: how the "Series" backlink label is displayed. */
  seriesLabel?: string;
}

const { variant, seriesHref, seriesLabel } = Astro.props;
// Precedence: explicit prop > CMS-stored backLink > derived from series slug
const backHref = seriesHref ?? variant.backLinkHref ?? `/${variant.seriesSlug || ''}`;
const backLabel = seriesLabel ?? variant.backLinkLabel ?? 'Series';
const { hero, specIcons, premiumLiving, floorplans, cta, gallery } = variant;
const quickStats = hero.quickStats ?? [];
const galleryExterior = gallery?.exterior ?? [];
const galleryInterior = gallery?.interior ?? [];
const showMoodBoard = variant.showMoodBoard !== false;

// Spec table is meaningful only when at least one tier has at least one item.
const specTableHasContent =
  variant.specTable &&
  (['ultra', 'terrain', 'hiker'] as const).some((t) =>
    (['chassis', 'furniture', 'electrical', 'plumbing'] as const).some(
      (c) => (variant.specTable?.[t]?.[c]?.length ?? 0) > 0
    )
  );
---

<Layout title={`${variant.name} | Hike RV Caravans`} description={hero.body || `Explore the ${variant.name} caravan from Hike RV.`}>
  <Navbar />

  <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

    {/* ── HERO ── */}
    <section class="relative z-10 w-full min-h-[100vh] flex flex-col lg:flex-row overflow-hidden bg-black">
      <div class="relative z-10 w-full lg:w-[45%] flex flex-col justify-center px-8 md:px-14 lg:px-20 py-32 lg:py-20">
        <div class="absolute top-0 right-0 hidden lg:block w-px h-full bg-gradient-to-b from-transparent via-white/10 to-transparent"></div>
        <a href={backHref} class="flex items-center gap-2 text-white/40 text-[10px] font-bold uppercase tracking-[0.3em] mb-10 hover:text-[#E50000] transition-colors duration-300 w-fit">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
          {backLabel}
        </a>
        {hero.kicker && (
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-1 bg-[#E50000] rounded-full"></div>
            <span class="text-[#E50000] text-[10px] font-black uppercase tracking-[0.4em]">{hero.kicker}</span>
          </div>
        )}
        <h1 class="text-white text-[3.5rem] md:text-[5rem] lg:text-[6rem] font-black uppercase tracking-tighter leading-[0.85] mb-3">{hero.title}</h1>
        {hero.subtitle && (
          <h2 class="text-[2rem] md:text-[2.5rem] lg:text-[3rem] font-black uppercase tracking-tighter leading-[0.9] mb-8 text-white">
            {hero.subtitle}
          </h2>
        )}
        {hero.body && (
          <p class="text-white/50 font-medium text-sm md:text-base leading-relaxed max-w-md mb-10">{hero.body}</p>
        )}
        <div class="flex flex-col sm:flex-row items-start gap-4">
          <a href="#contact" class="px-8 py-3.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)]">Get a Quote</a>
          {hero.brochureUrl && (
            <a href={hero.brochureUrl} target="_blank" download class="px-8 py-3.5 border border-white/20 text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full flex items-center gap-2">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
              Brochure
            </a>
          )}
        </div>
        {quickStats.length > 0 && (
          <div class="flex flex-wrap gap-x-10 gap-y-4 mt-10 pt-8 border-t border-white/10">
            {quickStats.map((s) => (
              <div class="flex flex-col">
                <span class="text-white text-2xl md:text-3xl font-black tracking-tight leading-none">
                  {s.value}{s.accent && <span class="text-[#E50000] text-base align-top ml-0.5">{s.accent}</span>}
                </span>
                <span class="text-white/40 text-[10px] font-bold uppercase tracking-[0.2em] mt-1.5">{s.label}</span>
              </div>
            ))}
          </div>
        )}
        {specIcons.length > 0 && (
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-5 mt-14 pt-8 border-t border-white/10">
            {specIcons.map((s) => <SpecIcon icon={s.icon} value={s.value} caption={s.caption} />)}
          </div>
        )}
      </div>
      <div class="relative w-full lg:w-[55%] min-h-[50vh] lg:min-h-full">
        {hero.heroImage && <img src={hero.heroImage} alt={variant.name} class="w-full h-full object-cover object-center" />}
        <div class="absolute inset-0 bg-[linear-gradient(to_right,_rgb(0_0_0)_0%,_rgb(0_0_0/0.1)_30%,_transparent_60%)] lg:block hidden"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent lg:hidden"></div>
      </div>
    </section>

    {/* ── PREMIUM LIVING ── */}
    {(premiumLiving.heading || premiumLiving.body || premiumLiving.images.length > 0) && (
      <section class="relative z-10 w-full py-24 md:py-40 bg-black text-white overflow-hidden">
        <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[40vw] h-[40vw] max-w-[500px] max-h-[500px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>
        <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row-reverse gap-16 lg:gap-20 items-center">
          {premiumLiving.images.length >= 3 && (
            <div class="w-full lg:w-1/2 flex gap-4 md:gap-6 items-start">
              <div class="flex-[1.2]">
                <div class="relative rounded-[1.5rem] md:rounded-[2.5rem] overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.4)] group aspect-[3/4]">
                  <img src={premiumLiving.images[0]} alt={`${variant.name} Interior`} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                </div>
              </div>
              <div class="flex-1 flex flex-col gap-4 md:gap-6 mt-8 md:mt-16">
                <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                  <img src={premiumLiving.images[1]} alt={`${variant.name} Interior Detail`} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                </div>
                <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                  <img src={premiumLiving.images[2]} alt={`${variant.name} Interior Detail`} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                </div>
              </div>
            </div>
          )}
          <div class="w-full lg:w-1/2 flex flex-col">
            <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block">Interior Design</span>
            {premiumLiving.heading && (
              <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10">{premiumLiving.heading}</h2>
            )}
            {premiumLiving.body && (
              <p class="text-white/60 font-medium md:text-lg leading-relaxed mb-8 border-l-4 border-[#E50000] pl-6 md:pl-10">{premiumLiving.body}</p>
            )}
            {premiumLiving.chips.length > 0 && (
              <div class="flex flex-wrap gap-3 mt-4">
                {premiumLiving.chips.map((chip) => (
                  <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">{chip}</span>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    {/* ── 3D FLOORPLANS ── */}
    {floorplans.length > 0 && <LayoutSection layouts={floorplans} title="Floorplan" subtitle="Spatial Design." />}

    {/* ── GALLERY (Exterior + Interior) ── */}
    {(galleryExterior.length > 0 || galleryInterior.length > 0) && (
      <section class="relative z-10 w-full py-24 md:py-32 bg-white text-black border-t border-black/5">
        <div class="max-w-[1600px] mx-auto px-6 md:px-14">
          <div class="mb-14">
            <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block">Gallery</span>
            <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none">See It<span class="text-[#E50000]">.</span></h2>
          </div>
          {galleryExterior.length > 0 && (
            <div class="mb-14">
              <h3 class="text-xs font-black uppercase tracking-[0.3em] text-black/40 mb-5">Exterior</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
                {galleryExterior.map((src) => (
                  <div class="aspect-[4/3] overflow-hidden rounded-[1rem] md:rounded-[1.5rem] group">
                    <img src={src} alt={`${variant.name} exterior`} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                  </div>
                ))}
              </div>
            </div>
          )}
          {galleryInterior.length > 0 && (
            <div>
              <h3 class="text-xs font-black uppercase tracking-[0.3em] text-black/40 mb-5">Interior</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
                {galleryInterior.map((src) => (
                  <div class="aspect-[4/3] overflow-hidden rounded-[1rem] md:rounded-[1.5rem] group">
                    <img src={src} alt={`${variant.name} interior`} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    {/* ── MOOD BOARDS ── */}
    {showMoodBoard && <MoodBoardSection />}

    {/* ── SPECIFICATIONS ── */}
    {specTableHasContent && (
    <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
      <div class="max-w-[1600px] mx-auto px-6 md:px-14">
        <div class="mb-16">
          <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none">Specifications<span class="text-[#E50000]">.</span></h2>
          <p class="text-black/50 font-medium md:text-lg mt-4 max-w-2xl">Compare the three available packs side by side.</p>
        </div>
        <div class="flex flex-col lg:flex-row gap-10">
          <div class="flex flex-row lg:flex-col gap-3 lg:w-[220px] shrink-0">
            <button data-tier="ultra" class="tier-tab active-tier w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Ultra Pack</button>
            <button data-tier="terrain" class="tier-tab w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Terrain Pack</button>
            <button data-tier="hiker" class="tier-tab w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Hiker Pack</button>
          </div>
          <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Chassis</h3><ul id="spec-chassis" class="flex flex-col gap-2.5"></ul></div>
            <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Furniture</h3><ul id="spec-furniture" class="flex flex-col gap-2.5"></ul></div>
            <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Electrical</h3><ul id="spec-electrical" class="flex flex-col gap-2.5"></ul></div>
            <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Plumbing</h3><ul id="spec-plumbing" class="flex flex-col gap-2.5"></ul></div>
          </div>
        </div>
      </div>
    </section>

    <script is:inline define:vars={{ specJson: JSON.stringify(variant.specTable) }}>
      const specData = JSON.parse(specJson);
      function renderSpecs(tier) {
        const d = specData[tier];
        if (!d) return;
        ['chassis','furniture','electrical','plumbing'].forEach(cat => {
          const ul = document.getElementById('spec-' + cat);
          if (!ul) return;
          ul.innerHTML = (d[cat] || []).map(item => `
            <li class="flex items-start gap-3">
              <span class="w-4 h-4 shrink-0 mt-0.5 text-[#E50000]">
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              </span>
              <span class="text-sm text-black/60 font-medium">${item}</span>
            </li>
          `).join('');
        });
      }
      document.querySelectorAll('.tier-tab').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.tier-tab').forEach(b => b.classList.remove('active-tier'));
          btn.classList.add('active-tier');
          renderSpecs(btn.dataset.tier);
        });
      });
      renderSpecs('ultra');
    </script>
    )}

    {/* ── CTA ── */}
    <section id="contact" class="relative z-10 w-full py-24 md:py-32 bg-black text-white overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#E50000]/30 to-transparent"></div>
      <div class="max-w-3xl mx-auto px-6 md:px-14 text-center relative z-10">
        {cta.kicker && <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block">{cta.kicker}</span>}
        {cta.heading && <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-8">{cta.heading}</h2>}
        {cta.body && <p class="text-white/50 font-medium md:text-lg leading-relaxed mb-12 max-w-xl mx-auto">{cta.body}</p>}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
          <a href="/#contact" class="px-12 py-5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)]">Get a Quote</a>
          {hero.brochureUrl && (
            <a href={hero.brochureUrl} target="_blank" download class="px-12 py-5 border border-white/20 text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full flex items-center gap-3">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
              Download Brochure
            </a>
          )}
        </div>
        <a href={backHref} class="inline-block mt-8 text-white/40 text-[10px] font-bold uppercase tracking-[0.3em] hover:text-white/70 transition-colors duration-300">← Back to {backLabel}</a>
      </div>
    </section>

  </main>
</Layout>

<style>
  .tier-tab { background: white; border-color: rgba(0,0,0,0.08); color: rgba(0,0,0,0.5); }
  .tier-tab:hover { border-color: #E50000; color: #E50000; }
  .tier-tab.active-tier { background: #E50000; border-color: #E50000; color: white; box-shadow: 0 8px 30px rgba(229,0,0,0.25); }
</style>
