---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { Image } from "astro:assets";
---

<Layout title="Toy Haulers | Hike RV Caravans" description="Take your adventures to the next level with our Toy Hauler series. Designed for those who don't want to leave their gear behind.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO SECTION                               -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="toy-haulers-hero" class="relative z-10 w-full min-h-[100vh] flex flex-col items-center justify-center text-center overflow-hidden">
            <!-- Background Image -->
            <div class="absolute inset-0 z-0">
                <img src="/roverbg.png" alt="Toy Haulers Hero" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-b from-black/90 via-black/70 to-black"></div>
            </div>

            <!-- Hero Content -->
            <div class="relative z-10 flex flex-col items-center px-6 md:px-14 max-w-5xl mx-auto">
                
                <div class="flex items-center justify-center gap-4 sm:gap-6 mb-8 animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">
                    <div class="w-8 sm:w-16 h-px bg-[#3b82f6]/50"></div>
                    <span class="text-[#3b82f6] text-[10px] sm:text-xs font-black uppercase tracking-[0.5em] text-center">
                        Extreme Gear Range
                    </span>
                    <div class="w-8 sm:w-16 h-px bg-[#3b82f6]/50"></div>
                </div>

                <h1 class="text-white text-5xl md:text-7xl lg:text-[8rem] font-black uppercase tracking-tighter leading-[0.85] mb-8 animate-fade-up drop-shadow-2xl" style="animation-delay: 400ms; animation-fill-mode: both;">
                    Toy <br/>
                    <span class="text-[#3b82f6]">Haulers.</span>
                </h1>

                <p class="text-white/70 font-medium text-sm md:text-lg tracking-wide max-w-3xl mb-12 leading-relaxed animate-fade-up" style="animation-delay: 600ms; animation-fill-mode: both;">
                    Engineered for the ultimate outdoor enthusiast. Our Toy Hauler series provides the perfect mobile garage for your motorcycles, ATVs, or bikes without sacrificing luxury living.
                </p>

                <div class="flex flex-col sm:flex-row items-center gap-5 animate-fade-up" style="animation-delay: 800ms; animation-fill-mode: both;">
                    <a href="#contact" class="px-10 py-4 bg-[#3b82f6] text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(59,130,246,0.3)]">
                        Get a Quote
                    </a>
                    <a href="#models" class="px-10 py-4 border border-[#3b82f6]/40 text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-[#3b82f6] hover:text-white transition-all duration-500 rounded-full backdrop-blur-sm">
                        Explore Models
                    </a>
                </div>
            </div>

            <!-- Scroll Indicator -->
            <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 animate-fade-up" style="animation-delay: 1200ms; animation-fill-mode: both;">
                <span class="text-white/40 text-[9px] uppercase tracking-[0.3em] font-bold">Scroll</span>
                <div class="w-px h-10 bg-gradient-to-b from-[#3b82f6]/60 to-transparent animate-pulse"></div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. DESCRIPTION + KEY FEATURES                 -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row gap-20">
                
                <!-- Left: Description -->
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#3b82f6] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">Built for Adventure</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                        Bring Your<br/>Adventures.
                    </h2>
                    
                    <p class="text-black/60 font-medium md:text-xl leading-relaxed mb-12 animate-fade-up border-l-4 border-[#3b82f6] pl-6 md:pl-10" style="animation-delay: 600ms; animation-fill-mode: both;">
                        Why choose between your gear and your comfort? The Hike RV Toy Hauler series is built tough to carry your toys and stylish enough to be your home away from home. Featuring heavy-duty ramps, secure tie-downs, and modular interiors.
                    </p>

                    <div class="w-full h-px bg-black/10 mb-10 animate-fade-up" style="animation-delay: 800ms; animation-fill-mode: both;"></div>

                    <!-- Caravan Image Placeholder -->
                    <div class="w-full h-96 bg-[#f4f4f4] rounded-3xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.05)] animate-fade-up flex items-center justify-center text-black/10 font-black text-6xl uppercase tracking-tighter" style="animation-delay: 900ms; animation-fill-mode: both;">
                        Toy Hauler
                    </div>
                </div>

                <!-- Right: Key Features -->
                <div class="w-full lg:w-1/2 flex flex-col justify-center animate-fade-up" style="animation-delay: 600ms; animation-fill-mode: both;">
                    <h3 class="font-black uppercase tracking-widest text-[#3b82f6] mb-10 md:text-lg">Key Features</h3>
                    
                    <div class="flex flex-col gap-5">
                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#3b82f6]/30 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#3b82f6]/10 flex items-center justify-center shrink-0 group-hover:bg-[#3b82f6] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#3b82f6] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Heavy Duty Ramp</span>
                                <span class="text-black/50 text-sm">Reinforced rear door for easy gear loading</span>
                            </div>
                        </div>

                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#3b82f6]/30 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#3b82f6]/10 flex items-center justify-center shrink-0 group-hover:bg-[#3b82f6] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#3b82f6] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Secure Tie-downs</span>
                                <span class="text-black/50 text-sm">Professional grade anchoring systems</span>
                            </div>
                        </div>

                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#3b82f6]/30 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#3b82f6]/10 flex items-center justify-center shrink-0 group-hover:bg-[#3b82f6] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#3b82f6] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Modular Interior</span>
                                <span class="text-black/50 text-sm">Flexible living spaces that adapt to your load</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. MODELS SECTION                             -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="models" class="relative z-10 w-full py-24 md:py-40 bg-black text-white">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 relative z-10">
                
                <div class="text-center mb-20">
                    <span class="text-[#3b82f6] font-black uppercase tracking-[0.5em] text-[10px] md:text-xs mb-4 block animate-fade-up">Hauler Range</span>
                    <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none animate-fade-up" style="animation-delay: 200ms;">
                        Extreme<br/><span class="text-[#3b82f6]">Performance.</span>
                    </h2>
                </div>

                <!-- Model Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 max-w-5xl mx-auto">
                    
                    <!-- HIKE X1 -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-white/10 hover:border-[#3b82f6]/40 transition-all duration-700 hover:-translate-y-2 bg-white/5 backdrop-blur-sm">
                        <div class="w-full h-56 md:h-64 bg-[#111] flex items-center justify-center overflow-hidden relative">
                            <div class="absolute inset-0 flex items-center justify-center text-white/10 font-black text-4xl uppercase tracking-tighter">Coming Soon</div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <span class="text-[#3b82f6] text-[9px] font-black uppercase tracking-[0.3em] mb-2">Compact Hauler</span>
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-3">HIKE X1</h3>
                            <p class="text-white/50 text-sm font-medium mb-8 leading-relaxed">Versatile performance for the solo adventurer or couple.</p>
                            <span class="w-fit px-8 py-3.5 border border-white/10 text-white/30 font-black uppercase tracking-[0.2em] text-[10px] rounded-full">Coming Soon</span>
                        </div>
                    </div>

                    <!-- HIKE X2 -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-white/10 hover:border-[#3b82f6]/40 transition-all duration-700 hover:-translate-y-2 bg-white/5 backdrop-blur-sm">
                        <div class="w-full h-56 md:h-64 bg-[#111] flex items-center justify-center overflow-hidden relative">
                            <div class="absolute inset-0 flex items-center justify-center text-white/10 font-black text-4xl uppercase tracking-tighter">Coming Soon</div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <span class="text-[#3b82f6] text-[9px] font-black uppercase tracking-[0.3em] mb-2">Elite Hauler</span>
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-3">HIKE X2</h3>
                            <p class="text-white/50 text-sm font-medium mb-8 leading-relaxed">Maximum capacity and uncompromised luxury for heavy gear.</p>
                            <span class="w-fit px-8 py-3.5 border border-white/10 text-white/30 font-black uppercase tracking-[0.2em] text-[10px] rounded-full">Coming Soon</span>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 4. CTA SECTION                                -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="contact" class="relative z-10 w-full py-24 md:py-32 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-3xl mx-auto px-6 md:px-14 text-center">
                <span class="text-[#3b82f6] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block">Ready to Load Up?</span>
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-8">
                    Your Gear,<br/>Anywhere.
                </h2>
                <p class="text-black/60 font-medium md:text-lg leading-relaxed mb-12 max-w-xl mx-auto">
                    Contact our specialists to configure your HIKE X series Toy Hauler. Customized layouts available to fit your specific toys and lifestyle.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
                    <a href="/#contact" class="px-12 py-5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-[#3b82f6] transition-colors duration-500 rounded-full shadow-xl">
                        Get a Quote
                    </a>
                    <a href="/" class="px-12 py-5 border border-black/20 text-black font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-black hover:text-white transition-all duration-500 rounded-full">
                        Back to Home
                    </a>
                </div>
            </div>
        </section>

    </main>
</Layout>

<style>
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>
