---
export const prerender = false;

const next = Astro.url.searchParams.get('next') ?? '/admin';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · Hike RV CMS</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; }
      body {
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background: #0a0a0a;
        color: #fff;
        min-height: 100vh;
      }
      .login-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 1fr;
      }
      .login-brand {
        display: none;
      }
      .login-pane {
        display: grid;
        place-items: center;
        padding: 2rem;
      }
      .login-card {
        width: 100%;
        max-width: 380px;
      }
      .login-eyebrow { display: none; }

      /* Tablet/small laptop */
      @media (min-width: 768px) {
        .login-pane { padding: 3rem; }
        .login-card { max-width: 420px; }
      }

      /* Laptop and up — two-column split */
      @media (min-width: 1024px) {
        .login-shell { grid-template-columns: 1.1fr 1fr; }
        .login-brand {
          position: relative;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          padding: 3rem 3.5rem;
          background:
            radial-gradient(60% 80% at 20% 10%, rgba(229,0,0,0.25), transparent 60%),
            radial-gradient(40% 60% at 90% 90%, rgba(229,0,0,0.12), transparent 70%),
            linear-gradient(180deg, #050505 0%, #0a0a0a 100%);
          border-right: 1px solid rgba(255,255,255,0.06);
          overflow: hidden;
        }
        .login-brand::after {
          content: '';
          position: absolute; inset: 0;
          background-image:
            linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
          background-size: 48px 48px;
          mask-image: radial-gradient(circle at 30% 30%, #000 30%, transparent 75%);
          pointer-events: none;
        }
        .login-brand > * { position: relative; z-index: 1; }
        .login-eyebrow {
          display: flex;
          align-items: center;
          gap: 0.75rem;
          font-size: 0.65rem;
          font-weight: 900;
          text-transform: uppercase;
          letter-spacing: 0.5em;
          color: rgba(255,255,255,0.45);
        }
        .login-eyebrow::before {
          content: '';
          width: 2.5rem; height: 1px;
          background: rgba(255,255,255,0.25);
        }
        .login-brand-title {
          font-size: clamp(2.75rem, 4.5vw, 4.25rem);
          font-weight: 900;
          line-height: 0.95;
          letter-spacing: -0.03em;
          text-transform: uppercase;
          margin: 1.5rem 0 1.25rem;
        }
        .login-brand-title em { font-style: normal; color: #E50000; }
        .login-brand-sub {
          color: rgba(255,255,255,0.55);
          font-size: 1rem;
          line-height: 1.6;
          max-width: 28rem;
          margin: 0;
        }
        .login-brand-footer {
          font-size: 0.7rem;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.3em;
          color: rgba(255,255,255,0.3);
        }
        .login-card { max-width: 440px; }
      }

      @media (min-width: 1440px) {
        .login-brand { padding: 4rem 5rem; }
        .login-pane { padding: 4rem; }
      }
    </style>
  </head>
  <body>
    <div class="login-shell">
      <aside class="login-brand">
        <span class="login-eyebrow">Hike RV · Content Studio</span>
        <div>
          <h2 class="login-brand-title">Built for the<br/><em>wild.</em></h2>
          <p class="login-brand-sub">Manage products, blog posts, FAQs and imagery for hikervcaravans.com.au from one place.</p>
        </div>
        <span class="login-brand-footer">Authorised personnel only</span>
      </aside>

      <main class="login-pane">
        <div class="login-card">
          <div style="text-align: left; margin-bottom: 2.25rem;">
            <h1 style="font-size: 1.875rem; font-weight: 900; margin: 0 0 0.5rem; letter-spacing: -0.02em;">HIKE RV<span style="color: #E50000;">.</span> CMS</h1>
            <p style="color: rgba(255,255,255,0.5); font-size: 0.9375rem; margin: 0;">Sign in to manage site content.</p>
          </div>

          <form id="login-form" style="display: flex; flex-direction: column; gap: 1rem;">
        <label style="display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.15em; color: rgba(255,255,255,0.4);">
          Email
          <input type="email" name="email" autocomplete="username" required
            style="padding: 0.75rem 1rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 0.5rem; color: #fff; font-size: 0.9375rem; outline: none;"
            onfocus="this.style.borderColor='#E50000'"
            onblur="this.style.borderColor='rgba(255,255,255,0.1)'"
          />
        </label>
        <label style="display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.15em; color: rgba(255,255,255,0.4);">
          Password
          <input type="password" name="password" autocomplete="current-password" required
            style="padding: 0.75rem 1rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 0.5rem; color: #fff; font-size: 0.9375rem; outline: none;"
            onfocus="this.style.borderColor='#E50000'"
            onblur="this.style.borderColor='rgba(255,255,255,0.1)'"
          />
        </label>
        <p id="login-error" style="display: none; color: #ff6b6b; font-size: 0.8125rem; margin: 0;"></p>
        <button type="submit" id="login-submit"
          style="margin-top: 0.5rem; padding: 0.875rem 1rem; background: #E50000; color: #fff; border: none; border-radius: 9999px; font-weight: 800; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.2em; cursor: pointer; transition: background 0.2s;"
          onmouseover="this.style.background='#fff'; this.style.color='#000'"
          onmouseout="this.style.background='#E50000'; this.style.color='#fff'">
          Sign in
        </button>
      </form>
        </div>
      </main>
    </div>

    <script define:vars={{ next }}>
      const form = document.getElementById('login-form');
      const error = document.getElementById('login-error');
      const submit = document.getElementById('login-submit');
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form || !error || !submit) return;
        error.style.display = 'none';
        submit.setAttribute('disabled', 'true');
        submit.textContent = 'Signing in…';
        const formData = new FormData(form);
        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: formData.get('email'),
              password: formData.get('password'),
            }),
          });
          if (res.ok) {
            window.location.href = next;
            return;
          }
          const body = await res.json().catch(() => ({}));
          error.textContent = body.error || 'Sign-in failed.';
          error.style.display = 'block';
        } catch (err) {
          error.textContent = 'Network error — please try again.';
          error.style.display = 'block';
        } finally {
          submit.removeAttribute('disabled');
          submit.textContent = 'Sign in';
        }
      });
    </script>
  </body>
</html>
