---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="Tanzanite 21 | Hike RV Caravans" description="Step into refined living on the road with spacious layouts, premium finishes, and smart features of the Tanzanite 21.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO — Split Editorial Layout              -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full min-h-[100vh] flex flex-col lg:flex-row overflow-hidden bg-black">
            <!-- Left: Content -->
            <div class="relative z-10 w-full lg:w-[45%] flex flex-col justify-center px-8 md:px-14 lg:px-20 py-32 lg:py-20 text-white">
                <div class="absolute top-0 right-0 hidden lg:block w-px h-full bg-gradient-to-b from-transparent via-white/10 to-transparent"></div>
                
                <a href="/drifter" class="flex items-center gap-2 text-white/40 text-[10px] font-bold uppercase tracking-[0.3em] mb-10 hover:text-[#E50000] transition-colors duration-300 w-fit animate-fade-up" style="animation-delay:100ms;animation-fill-mode:both;">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
                    Drifter Series
                </a>

                <div class="flex items-center gap-4 mb-6 animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="w-12 h-1 bg-[#E50000] rounded-full"></div>
                    <span class="text-[#E50000] text-[10px] font-black uppercase tracking-[0.4em]">Model 21</span>
                </div>

                <h1 class="text-white text-[3.5rem] md:text-[5rem] lg:text-[6rem] font-black uppercase tracking-tighter leading-[0.85] mb-3 animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Sturdy.</h1>
                <h2 class="text-[2rem] md:text-[2.5rem] lg:text-[3rem] font-black uppercase tracking-tighter leading-[0.9] mb-8 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-white/80 to-white/40">Tanzanite</span> <span class="text-[#E50000]">21</span>
                </h2>

                <p class="text-white/50 font-medium text-sm md:text-base leading-relaxed max-w-md mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">
                    Step into refined living on the road with spacious layouts, premium finishes, and smart features.
                </p>

                <div class="flex flex-col sm:flex-row items-start gap-4 animate-fade-up" style="animation-delay:600ms;animation-fill-mode:both;">
                    <a href="#contact" class="px-8 py-3.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)]">Get a Quote</a>
                    <a href="https://www.youtube.com/watch?v=034XtZHzkS4" target="_blank" class="px-8 py-3.5 border border-white/20 text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full flex items-center gap-2 group">
                        <svg class="w-4 h-4 text-[#E50000] group-hover:text-black transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                        Watch Video
                    </a>
                </div>

                <div class="flex items-center gap-8 mt-14 pt-8 border-t border-white/10 animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                    <div><span class="block text-2xl md:text-3xl font-black text-white">21<span class="text-[#E50000]">ft</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Length</span></div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div><span class="block text-2xl md:text-3xl font-black text-white">3<span class="text-[#E50000]"> Packs</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Available</span></div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div><span class="block text-2xl md:text-3xl font-black text-white">~3500<span class="text-[#E50000]">kg</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Rating</span></div>
                </div>
            </div>
            <!-- Right: Image -->
            <div class="relative w-full lg:w-[55%] min-h-[50vh] lg:min-h-full">
                <img src="/drifter/tanzinite/tanzinite.png" alt="Tanzanite 21" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-r from-black via-black/30 to-transparent lg:block hidden"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent lg:hidden"></div>
                <div class="absolute bottom-8 right-8 hidden lg:flex flex-col items-end gap-2 animate-fade-up" style="animation-delay:1000ms;animation-fill-mode:both;">
                    <span class="text-white/20 text-[9px] font-bold uppercase tracking-[0.3em]">Scroll to explore</span>
                    <div class="w-px h-12 bg-gradient-to-b from-white/30 to-transparent animate-pulse"></div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. BUILT FOR ENDURANCE                        -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row gap-16 lg:gap-20 items-start">
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">Durability</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">Built For<br/><span class="text-[#E50000]">Endurance.</span></h2>
                    
                    <p class="text-black/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay:600ms;animation-fill-mode:both;">
                        Tanzanite 21 balances luxury, practicality, and strength in a refined, feature-rich touring caravan.
                    </p>
                    
                    <p class="text-black/50 font-medium md:text-base leading-relaxed mb-8 animate-fade-up" style="animation-delay:700ms;animation-fill-mode:both;">
                        Inside the Tanzanite 21, you'll find a queen-size innerspring mattress, café lounge, large pull-out pantry, leatherette seating, and premium cabinetry. The ensuite features a glass-door shower and vanity. Every interior surface is designed for usability, comfort, and durability, so you feel at ease in every environment.
                    </p>

                    <p class="text-black/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                        Externally, the caravan rides on a 3,500 kg-rated chassis with 10" electric brakes, dual alloy wheels, twin battery boxes, a spare wheel on the rear, a large twinslide toolbox, and checker plate protection. With robust construction and modern features, this caravan is road-ready and adventure-ready from the first mile.
                    </p>

                    <div class="flex flex-wrap gap-3 mt-10 animate-fade-up" style="animation-delay:900ms;animation-fill-mode:both;">
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Queen Innerspring</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Café Lounge</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Leatherette Seating</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">3500KG Chassis</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Twinslide Toolbox</span>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <div class="relative rounded-[2rem] overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.08)] group">
                        <img src="/drifter/tanzinite/tanzinite.png" alt="Tanzanite 21 Exterior" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700" />
                        <div class="absolute inset-0 rounded-[2rem] border border-black/5 pointer-events-none"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. INTERIORS THAT INSPIRE JOY                 -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-black text-white overflow-hidden">
            <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[40vw] h-[40vw] max-w-[500px] max-h-[500px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row-reverse gap-16 lg:gap-20 items-center">
                
                <!-- Premium three-image collage layout (using placeholders from Wild Drifter for now) -->
                <div class="w-full lg:w-1/2 flex gap-4 md:gap-6 animate-fade-up items-start" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="flex-[1.2]">
                        <div class="relative rounded-[1.5rem] md:rounded-[2.5rem] overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.4)] group aspect-[3/4]">
                            <img src="/drifter/tanzinite/interior1.png" alt="Tanzanite 21 Interior Main" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.5rem] md:rounded-[2.5rem] pointer-events-none"></div>
                        </div>
                    </div>
                    <div class="flex-1 flex flex-col gap-4 md:gap-6 mt-8 md:mt-16">
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                            <img src="/drifter/tanzinite/interior2.png" alt="Tanzanite 21 Interior Detail" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                            <img src="/drifter/tanzinite/interior3.png" alt="Tanzanite 21 Interior Detail" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                    </div>
                </div>

                <!-- Text -->
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Interior Elegance</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">Interiors That<br/><span class="text-[#E50000]">Inspire Joy.</span></h2>
                    
                    <p class="text-white/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay:700ms;animation-fill-mode:both;">
                        Every interior detail is crafted to delight your senses: soft lighting, quality upholstery, intelligent storage, and seamless finishes. The space feels open, warm, and refined, relaxing at every turn.
                    </p>
                    
                    <p class="text-white/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay:900ms;animation-fill-mode:both;">
                        Large, glazed windows let in natural light, while good ventilation keeps the environment fresh. The layout flows effortlessly between living, sleeping, dining, and ensuite zones so you never feel cramped or compromised.
                    </p>

                    <!-- Feature chips -->
                    <div class="flex flex-wrap gap-3 mt-10 animate-fade-up" style="animation-delay:1000ms;animation-fill-mode:both;">
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Soft Lighting</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Seamless Finishes</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Glazed Windows</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Fresh Ventilation</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 4. SPECIFICATIONS — Tabbed Comparison         -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                <div class="mb-16">
                    <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none">Specifications<span class="text-[#E50000]">.</span></h2>
                    <p class="text-black/50 font-medium md:text-lg mt-4 max-w-2xl">High-strength chassis, robust suspension and quality materials make the Tanzanite 21 tough yet elegant.</p>
                </div>
                
                <div class="flex flex-col lg:flex-row gap-10">
                    <div class="flex flex-row lg:flex-col gap-3 lg:w-[220px] shrink-0">
                        <button data-tier="ultra" class="tier-tab active-tier w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Ultra Pack</button>
                        <button data-tier="terrain" class="tier-tab w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Terrain Pack</button>
                        <button data-tier="hiker" class="tier-tab w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Hiker Pack</button>
                    </div>

                    <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="spec-columns">
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Chassis</h3><ul id="spec-chassis" class="flex flex-col gap-2.5"></ul></div>
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Furniture</h3><ul id="spec-furniture" class="flex flex-col gap-2.5"></ul></div>
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Electrical</h3><ul id="spec-electrical" class="flex flex-col gap-2.5"></ul></div>
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Plumbing</h3><ul id="spec-plumbing" class="flex flex-col gap-2.5"></ul></div>
                    </div>
                </div>
            </div>
        </section>

        <script>
        const specData: Record<string, Record<string, string[]>> = {
            ultra: {
                chassis: ["Silver shine chassis", '6" Chassis', '2" Chassis Raiser', '6" Extended A-frame', "Drop Legs x 4", "2 X Battery Boxes"],
                furniture: ["White stipple Furniture", "Front robe port Holes", "postform Benchtops", "Recessed Mini grill", "Air conditioner Frame", "smoke detector"],
                electrical: ["Led Internal Down lights", "Led Boot Lights", "External 240 Power point", "HV Wingard sensor", "Grey Anderson Plug", "12 Pin Trailer Plug"],
                plumbing: ["Water fillers X 2 Lockable", "224L DOMETIC 3 way Fridge", "Fridge/Freezer", "Swift Mini grill", "Water filter system", "Thetford Cassette Toilet"]
            },
            terrain: {
                chassis: ["Silver shine chassis", '6" Chassis', '2" Chassis Raiser', '6" Extended A-frame', "Drop Step", "Do-35 Coupling"],
                furniture: ["White stipple Furniture", "Front robe port Holes", "postform Benchtops", "Queen Bed 1900 x 500mm bed", "smoke detector", "Bottom MountRangehood"],
                electrical: ["3500 Gree air conditioner", "Led Internal Down lights", "Led Boot Lights", "Bottom mount Rangehood", "BM-pro Trail safe", "Grey Anderson Plug"],
                plumbing: ["Water fillers X 2 Lockable", "188L DOMETIC 3 way", "Fridge/Freezer", "Swift Mini grill", "1 x Elec + 3 x gas", "White Ceramic Basin"]
            },
            hiker: {
                chassis: ["Silver shine chassis", '6" Chassis', '2" Chassis Raiser', '6" A-frame', "3 Arm Bumber Bar", '8" Jockey Wheels'],
                furniture: ["White stipple Furniture", "Front robe port Holes", "postform Benchtops", "Recessed Mini grill", "20L Microwave", "smoke detector"],
                electrical: ["Gree 3500 air conditioner", "Annex lights x 2", "Led Boot Lights", "External 240 Power point", "BM-pro Trail safe", "Grey Anderson Plug"],
                plumbing: ["Water fillers X 2 Lockable", "188L DOMETIC 12v", "Fridge/Freezer", "Swift Mini grill", "1 x Elec + 3 x gas", "Water filter system"]
            }
        };

        function renderSpecs(tier: string) {
            const d = specData[tier];
            ['chassis', 'furniture', 'electrical', 'plumbing'].forEach(cat => {
                const ul = document.getElementById('spec-' + cat);
                if (ul) ul.innerHTML = d[cat].map((item: string) =>
                    `<li class="flex items-start gap-3"><span class="w-4 h-4 shrink-0 mt-0.5 text-[#E50000]"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg></span><span class="text-sm text-black/60 font-medium">${item}</span></li>`
                ).join('');
            });
        }

        document.querySelectorAll('.tier-tab').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tier-tab').forEach(b => b.classList.remove('active-tier'));
                btn.classList.add('active-tier');
                renderSpecs((btn as HTMLElement).dataset.tier!);
            });
        });
        renderSpecs('ultra');
        </script>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 5. CTA                                        -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="contact" class="relative z-10 w-full py-24 md:py-32 bg-black text-white overflow-hidden">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>
            <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#E50000]/30 to-transparent"></div>
            <div class="max-w-3xl mx-auto px-6 md:px-14 text-center relative z-10">
                <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block">Touring Redefined</span>
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-8">Ready For The<br/><span class="text-[#E50000]">Tanzanite 21?</span></h2>
                <p class="text-white/50 font-medium md:text-lg leading-relaxed mb-12 max-w-xl mx-auto">Contact our team to configure the perfect Tanzanite 21 for your touring lifestyle.</p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
                    <a href="/#contact" class="px-12 py-5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)]">Get a Quote</a>
                    <a href="#" class="px-12 py-5 border border-white/20 text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full flex items-center gap-3">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                        Download Brochure
                    </a>
                </div>
                <a href="/drifter" class="inline-block mt-8 text-white/40 text-[10px] font-bold uppercase tracking-[0.3em] hover:text-white/70 transition-colors duration-300">← Back to Drifter Series</a>
            </div>
        </section>
    </main>
</Layout>

<style>
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up { animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .tier-tab { background: white; border-color: rgba(0,0,0,0.08); color: rgba(0,0,0,0.5); }
    .tier-tab:hover { border-color: #E50000; color: #E50000; }
    .tier-tab.active-tier { background: #E50000; border-color: #E50000; color: white; box-shadow: 0 8px 30px rgba(229,0,0,0.25); }
</style>
