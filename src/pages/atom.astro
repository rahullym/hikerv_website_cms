---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import LayoutSection from "../components/LayoutSection.astro";
import MoodBoardSection from "../components/MoodBoardSection.astro";

const exteriorImages = [
    "Copy of IMG_0006.jpg", "Copy of IMG_0008.jpg", "Copy of IMG_0010.jpg", "Copy of IMG_0013.jpg", 
    "Copy of IMG_0015.jpg", "Copy of IMG_0020.jpg", "Copy of IMG_0022.jpg", "Copy of IMG_0025.jpg", 
    "Copy of IMG_0029.jpg", "Copy of IMG_0031.jpg", "Copy of IMG_0036.jpg", "Copy of IMG_0039.jpg", 
    "Copy of IMG_0731.jpg", "Copy of IMG_0735.jpg", "Copy of IMG_0738.jpg", "Copy of IMG_0742.jpg", 
    "Copy of IMG_0746.jpg", "Copy of IMG_0749.jpg"
].map(img => `/Atom/Images/External/${img}`);

const interiorImages = [
    // Highlighted Internal shots
    "Copy of IMG_0069.jpg", "Copy of IMG_0750.jpg", "Copy of IMG_0757.jpg", "Copy of IMG_0759.jpg", 
    "Copy of IMG_0766.jpg", "Copy of IMG_0769.jpg", "Copy of IMG_0775.jpg", "Copy of IMG_0781.jpg", 
    "Copy of IMG_0783.jpg", "Copy of IMG_0785.jpg", "Copy of IMG_0787.jpg",
    // Selected Internal 2 details
    "Copy of IMG_0044.jpg", "Copy of IMG_0048.jpg", "Copy of IMG_0051.jpg", "Copy of IMG_0054.jpg", 
    "Copy of IMG_0058.jpg", "Copy of IMG_0063.jpg", "Copy of IMG_0067.jpg", "Copy of IMG_0071.jpg", 
    "Copy of IMG_0074.jpg", "Copy of IMG_0077.jpg", "Copy of IMG_0081.jpg", "Copy of IMG_0085.jpg", 
    "Copy of IMG_0091.jpg", "Copy of IMG_0096.jpg", "Copy of IMG_0101.jpg", "Copy of IMG_0110.jpg", 
    "Copy of IMG_0115.jpg", "Copy of IMG_0119.jpg"
].map(img => img.includes("07") || img === "Copy of IMG_0069.jpg" ? `/Atom/Images/Internal/${img}` : `/Atom/Images/Internal 2/${img}`);

const layoutImages = [
    { title: "Atom 17.2", desc: "Single Axle Compact", src: "/3D LAYOUTS 2024/3D LAYOUT NEW UPDATED AUG 2025/ATOM 17.2.png" },
    { title: "Atom 17.6", desc: "Touring Perfection", src: "/3D LAYOUTS 2024/3D LAYOUT NEW UPDATED AUG 2025/GTH ATOM 17.6.png" },
    { title: "Atom 17.8", desc: "The Ultra Layout", src: "/3D LAYOUTS 2024/3D LAYOUT NEW UPDATED AUG 2025/GTH ATOM 17.8.png" }
];
---

<Layout title="Atom Caravan | Hike RV Caravans" description="A caravan with sleek design and rugged off-road capability; tailored for couples seeking adventure without compromise.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">
        
        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO — Split Editorial Layout              -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full min-h-[100vh] flex flex-col lg:flex-row overflow-hidden bg-black">
            <div class="relative z-10 w-full lg:w-[45%] flex flex-col justify-center px-8 md:px-14 lg:px-20 py-32 lg:py-20">
                <div class="absolute top-0 right-0 hidden lg:block w-px h-full bg-gradient-to-b from-transparent via-white/10 to-transparent"></div>
                <a href="/rover" class="flex items-center gap-2 text-white/40 text-[10px] font-bold uppercase tracking-[0.3em] mb-10 hover:text-[#E50000] transition-colors duration-300 w-fit animate-fade-up" style="animation-delay:100ms;animation-fill-mode:both;">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
                    Rover Series
                </a>
                <div class="flex items-center gap-4 mb-6 animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="w-12 h-1 bg-[#E50000] rounded-full"></div>
                    <span class="text-[#E50000] text-[10px] font-black uppercase tracking-[0.4em]">Compact Range</span>
                </div>
                <h1 class="text-white text-[3.5rem] md:text-[5rem] lg:text-[6rem] font-black uppercase tracking-tighter leading-[0.85] mb-3 animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Compact.</h1>
                <h2 class="text-[2rem] md:text-[2.5rem] lg:text-[3rem] font-black uppercase tracking-tighter leading-none mb-8 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-white/80 to-white/40">Atom</span> <span class="text-[#E50000]">Caravan</span>
                </h2>
                <p class="text-white/50 font-medium text-sm md:text-base leading-relaxed max-w-md mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">
                    A caravan with sleek design and rugged off-road capability; tailored for couples seeking adventure without compromise.
                </p>
                <div class="flex flex-col sm:flex-row items-start gap-4 animate-fade-up" style="animation-delay:600ms;animation-fill-mode:both;">
                    <a href="#contact" class="px-8 py-3.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)]">Get a Quote</a>
                    <a href="/brochures/gtaatom.pdf" target="_blank" download class="px-8 py-3.5 border border-white/20 text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full flex items-center gap-2">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                        Brochure
                    </a>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-5 mt-14 pt-8 border-t border-white/10 animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">1000W</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Inverter</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 12v3.75h18V12zM4.5 15.75v3M19.5 15.75v3M6.75 9.75V8.25A2.25 2.25 0 019 6h6a2.25 2.25 0 012.25 2.25v1.5"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">L-Lounge</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Café Style</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 3h13.5a1.5 1.5 0 011.5 1.5v15a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-15a1.5 1.5 0 011.5-1.5zM3.75 11.25h16.5M7.5 7.5v-.75M7.5 15v-.75"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">224L Dometic</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Fridge</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75A2.25 2.25 0 016 4.5h12a2.25 2.25 0 012.25 2.25v10.5A2.25 2.25 0 0118 19.5H6a2.25 2.25 0 01-2.25-2.25V6.75zM3.75 10.5h16.5M7.5 4.5v15M16.5 4.5v15"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">Single-Axle</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">6" Chassis</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v3M12 18v3M5.636 5.636l2.121 2.121M16.243 16.243l2.121 2.121M3 12h3M18 12h3M5.636 18.364l2.121-2.121M16.243 7.757l2.121-2.121"/><circle cx="12" cy="12" r="4" stroke-width="1.8"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">Independent</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Suspension</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="4" y="3" width="16" height="18" rx="1.5"/><circle cx="12" cy="13" r="4"/><circle cx="8" cy="6.5" r=".5" fill="currentColor"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">2.5kg</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Washer</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 10.5h.375c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125H21M4.5 10.5H18V15H4.5v-4.5zM3.75 18h15A2.25 2.25 0 0021 15.75v-6a2.25 2.25 0 00-2.25-2.25h-15A2.25 2.25 0 001.5 9.75v6A2.25 2.25 0 003.75 18z"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">2 × 100Ah</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">AGM</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="14" rx="1"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 8.5h18M3 13h18M9 4v14M15 4v14M9 21h6"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">2 × 200W</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Solar Panel</span>
                    </div>
                </div>
            </div>
            <div class="relative w-full lg:w-[55%] min-h-[50vh] lg:min-h-full">
                <img src="/rover/atomrover.png" alt="Atom Caravan" class="w-full h-full object-cover object-center" />
                <div class="absolute inset-0 bg-[linear-gradient(to_right,_rgb(0_0_0)_0%,_rgb(0_0_0/0.1)_30%,_transparent_60%)] lg:block hidden"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent lg:hidden"></div>
                <div class="absolute bottom-8 right-8 hidden lg:flex flex-col items-end gap-2 animate-fade-up" style="animation-delay:1000ms;animation-fill-mode:both;">
                    <span class="text-white/20 text-[9px] font-bold uppercase tracking-[0.3em]">Scroll to explore</span>
                    <div class="w-px h-12 bg-gradient-to-b from-white/30 to-transparent animate-pulse"></div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. MODELS / VARIANTS SECTION                  -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="variants" class="relative z-10 w-full py-24 md:py-36 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                
                <div class="text-center mb-20">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.5em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">ATom Range</span>
                    <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                        Choose Your<br/><span class="text-[#E50000]">Configuration.</span>
                    </h2>
                </div>

                <!-- Variant Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
                    
                    <!-- ATom 17.6 — Currently Viewing -->
                    <div class="group relative rounded-[2rem] overflow-hidden border-2 border-[#E50000]/40 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(229,0,0,0.08)]">
                        <div class="absolute top-4 right-4 z-10 px-3 py-1.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[9px] rounded-full">Currently Viewing</div>
                        <div class="w-full h-52 md:h-60 bg-[#f4f4f4] flex items-center justify-center overflow-hidden relative">
                            <img src="/rover/atom/exterior.png" alt="ATom 17.6" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                            <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-3 text-black">ATom <span class="text-[#E50000]">17.6</span></h3>
                            <p class="text-black/50 text-sm font-medium mb-8">Touring perfection — the flagship Atom layout, available now.</p>
                            <a href="#contact" class="w-fit px-8 py-3.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-black transition-all duration-500 rounded-full shadow-md">
                                Get a Quote
                            </a>
                        </div>
                    </div>

                    <!-- ATom 17.2 -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-black flex items-center justify-center overflow-hidden relative">
                             <div class="absolute inset-0 opacity-20 bg-[url('/roverbg.png')] bg-cover bg-center"></div>
                             <div class="relative z-10 flex flex-col items-center gap-3">
                                <span class="text-white/20 font-black italic text-4xl tracking-tighter uppercase text-white/20">17.2</span>
                                <span class="text-white/40 font-black uppercase tracking-[0.3em] text-[8px] border border-white/10 px-4 py-1.5 rounded-full">Coming Soon</span>
                             </div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">ATom <span class="text-[#E50000]">17.2</span></h3>
                            <p class="text-black/40 text-sm font-medium mb-8">The agile single-axle compact performer.</p>
                            <div class="w-fit px-8 py-3.5 bg-black/5 text-black/20 font-black uppercase tracking-[0.2em] text-[10px] rounded-full">Coming Soon</div>
                        </div>
                    </div>

                    <!-- ATom 17.8 -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-black flex items-center justify-center overflow-hidden relative">
                             <div class="absolute inset-0 opacity-20 bg-[url('/roverbg.png')] bg-cover bg-center"></div>
                             <div class="relative z-10 flex flex-col items-center gap-3">
                                <span class="text-white/20 font-black italic text-4xl tracking-tighter uppercase text-white/20">17.8</span>
                                <span class="text-white/40 font-black uppercase tracking-[0.3em] text-[8px] border border-white/10 px-4 py-1.5 rounded-full">Coming Soon</span>
                             </div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">ATom <span class="text-[#E50000]">17.8</span></h3>
                            <p class="text-black/40 text-sm font-medium mb-8">The Ultra layout with maximum space efficiency.</p>
                            <div class="w-fit px-8 py-3.5 bg-black/5 text-black/20 font-black uppercase tracking-[0.2em] text-[10px] rounded-full">Coming Soon</div>
                        </div>
                    </div>



                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2.5. OVERVIEW — Compact Luxury Redefined      -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-white text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row gap-16 lg:gap-20 items-start">
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">Overview</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">Compact Luxury<br/><span class="text-[#E50000]">Redefined.</span></h2>
                    <p class="text-black/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay:600ms;animation-fill-mode:both;">
                        The Atom transforms compact caravanning expectations completely. Our caravan redefines space and comfort efficiently.
                    </p>
                    <p class="text-black/50 font-medium md:text-base leading-relaxed mb-8 animate-fade-up" style="animation-delay:700ms;animation-fill-mode:both;">
                        Available in 6 versatile layouts ranging from 17ft to 20ft, the Atom showcases Hike RV Caravans' innovative approach to space efficiency, featuring separate shower and toilet facilities, a comfortable island bed, and an L-lounge that doubles as additional sleeping space.
                    </p>
                    <p class="text-black/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                        With an external body length of 5.33 metres, the caravan is engineered for those who desire style and substance. Its single-axle design ensures easy towing, while the robust construction easily handles diverse terrains. The dual 95-litre freshwater tanks deliver exceptional self-sufficiency for extended off-grid adventures.
                    </p>
                    <div class="flex flex-wrap gap-3 mt-10 animate-fade-up" style="animation-delay:900ms;animation-fill-mode:both;">
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Single Axle</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Island Bed</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">L-Lounge</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Full Ensuite</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">6 Layouts</span>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <div class="relative rounded-[2rem] overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.08)] group">
                        <img src="/rover/atom/exterior.png" alt="Atom Caravan" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700 object-center" />
                        <div class="absolute inset-0 rounded-[2rem] border border-black/5 pointer-events-none"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. INNOVATIVE DESIGN                          -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-black text-white overflow-hidden">
            <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[40vw] h-[40vw] max-w-[500px] max-h-[500px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row-reverse gap-16 lg:gap-20 items-center">
                <!-- Premium three-image collage layout -->
                <div class="w-full lg:w-1/2 flex gap-4 md:gap-6 animate-fade-up items-start" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="flex-[1.2]">
                        <div class="relative rounded-[1.5rem] md:rounded-[2.5rem] overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.4)] group aspect-[3/4]">
                            <img src="/rover/atom/interior1.png" alt="Atom Interior – Bed & Vanity" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.5rem] md:rounded-[2.5rem] pointer-events-none"></div>
                        </div>
                    </div>
                    <div class="flex-1 flex flex-col gap-4 md:gap-6 mt-8 md:mt-16">
