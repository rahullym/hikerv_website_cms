        <script>
            function initGalleryTabs() {
                const tabs = document.querySelectorAll('.gallery-tab');
                const contents = document.querySelectorAll('.gallery-content');

                tabs.forEach(tab => {
                    tab.addEventListener('click', () => {
                        const target = tab.getAttribute('data-cat');

                        // Reset tabs
                        tabs.forEach(t => t.classList.remove('active-gallery-tab', 'bg-black', 'text-white'));
                        tab.classList.add('active-gallery-tab', 'bg-black', 'text-white');

                        // Switch content
                        contents.forEach(content => {
                            const id = content.getAttribute('id');
                            if (id === `gallery-${target}`) {
                                content.classList.remove('hidden-gallery', 'opacity-0', 'pointer-events-none', 'absolute');
                                content.classList.add('visible-gallery', 'opacity-100', 'z-10', 'relative');
                            } else {
                                content.classList.add('hidden-gallery', 'opacity-0', 'pointer-events-none', 'absolute');
                                content.classList.remove('visible-gallery', 'opacity-100', 'z-10', 'relative');
                            }
                        });
                        
                        // Scroll slightly to ensure visibility if tab is at bottom
                        // window.scrollTo({ top: document.querySelector('.gallery-tab').offsetTop - 100, behavior: 'smooth' });
                    });
                });
            }
            initGalleryTabs();
        </script>

