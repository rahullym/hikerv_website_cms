---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="Eco 18.6 | Hike RV Caravans" description="Lightweight yet robust, the Eco 18.6 combines smart living space and off-road capabilities for truly memorable journeys.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO — Split Editorial Layout              -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full min-h-[100vh] flex flex-col lg:flex-row overflow-hidden bg-black">
            <div class="relative z-10 w-full lg:w-[45%] flex flex-col justify-center px-8 md:px-14 lg:px-20 py-32 lg:py-20">
                <div class="absolute top-0 right-0 hidden lg:block w-px h-full bg-gradient-to-b from-transparent via-white/10 to-transparent"></div>
                <a href="/rover" class="flex items-center gap-2 text-white/40 text-[10px] font-bold uppercase tracking-[0.3em] mb-10 hover:text-[#E50000] transition-colors duration-300 w-fit animate-fade-up" style="animation-delay:100ms;animation-fill-mode:both;">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
                    Rover Series
                </a>
                <div class="flex items-center gap-4 mb-6 animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="w-12 h-1 bg-[#E50000] rounded-full"></div>
                    <span class="text-[#E50000] text-[10px] font-black uppercase tracking-[0.4em]">Eco Collection</span>
                </div>
                <h1 class="text-white text-[3.5rem] md:text-[5rem] lg:text-[6rem] font-black uppercase tracking-tighter leading-[0.85] mb-3 animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Pure.</h1>
                <h2 class="text-[2rem] md:text-[2.5rem] lg:text-[3rem] font-black uppercase tracking-tighter leading-[0.9] mb-8 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-white/80 to-white/40">The Eco</span> <span class="text-[#E50000]">Series</span>
                </h2>
                <p class="text-white/50 font-medium text-sm md:text-base leading-relaxed max-w-md mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">
                    Engineered for high-performance efficiency and sustainable adventure, the Eco series offers multiple layouts to suit every voyager.
                </p>
                <div class="flex flex-col sm:flex-row items-start gap-4 animate-fade-up" style="animation-delay:600ms;animation-fill-mode:both;">
                    <a href="#contact" class="px-8 py-3.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)]">Get a Quote</a>
                    <a href="#" class="px-8 py-3.5 border border-white/20 text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full flex items-center gap-2">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                        Brochure
                    </a>
                </div>
                <div class="flex items-center gap-8 mt-14 pt-8 border-t border-white/10 animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                    <div><span class="block text-2xl md:text-3xl font-black text-white">18.6<span class="text-[#E50000]">ft</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Length</span></div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div><span class="block text-2xl md:text-3xl font-black text-white">3<span class="text-[#E50000]"> Packs</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Available</span></div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div><span class="block text-2xl md:text-3xl font-black text-white">Eco<span class="text-[#E50000]">+</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Smart</span></div>
                </div>
            </div>
            <div class="relative w-full lg:w-[55%] min-h-[50vh] lg:min-h-full">
                <img src="/rover/ecorover.png" alt="Eco 18.6" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-r from-black via-black/30 to-transparent lg:block hidden"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent lg:hidden"></div>
                <div class="absolute bottom-8 right-8 hidden lg:flex flex-col items-end gap-2 animate-fade-up" style="animation-delay:1000ms;animation-fill-mode:both;">
                    <span class="text-white/20 text-[9px] font-bold uppercase tracking-[0.3em]">Scroll to explore</span>
                    <div class="w-px h-12 bg-gradient-to-b from-white/30 to-transparent animate-pulse"></div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. MODELS / VARIANTS SECTION                  -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="variants" class="relative z-10 w-full py-24 md:py-36 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                
                <div class="text-center mb-20">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.5em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">Eco Range</span>
                    <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                        Choose Your<br/><span class="text-[#E50000]">Configuration.</span>
                    </h2>
                </div>

                <!-- Variant Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
                    
                    <!-- Eco 18.6 -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-[#f4f4f4] flex items-center justify-center overflow-hidden relative">
                            <img src="/rover/eco/exterior.png" alt="Eco 18.6" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                            <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">Eco <span class="text-[#E50000]">18.6</span></h3>
                            <a href="/eco" class="w-fit px-8 py-3.5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-[#E50000] transition-all duration-500 rounded-full shadow-md">
                                Know More
                            </a>
                        </div>
                    </div>

                    <!-- Eco 17.6 -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-black flex items-center justify-center overflow-hidden relative">
                             <div class="absolute inset-0 opacity-20 bg-[url('/roverbg.png')] bg-cover bg-center"></div>
                             <div class="relative z-10 flex flex-col items-center gap-3">
                                <span class="text-white/20 font-black italic text-4xl tracking-tighter uppercase">17.6</span>
                                <span class="text-white/40 font-black uppercase tracking-[0.3em] text-[8px] border border-white/10 px-4 py-1.5 rounded-full">Coming Soon</span>
                             </div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">Eco <span class="text-[#E50000]">17.6</span></h3>
                            <p class="text-black/40 text-sm font-medium mb-8">The lightweight agile voyager, perfectly balanced for efficiency.</p>
                            <div class="w-fit px-8 py-3.5 bg-black/5 text-black/20 font-black uppercase tracking-[0.2em] text-[9px] rounded-full">Coming Soon</div>
                        </div>
                    </div>

                    <!-- Eco Quad Bunk -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-black flex items-center justify-center overflow-hidden relative">
                             <div class="absolute inset-0 opacity-20 bg-[url('/roverbg.png')] bg-cover bg-center"></div>
                             <div class="relative z-10 flex flex-col items-center gap-3">
                                <span class="text-white/20 font-black italic text-4xl tracking-tighter uppercase font-black uppercase">Quad Bunk</span>
                                <span class="text-white/40 font-black uppercase tracking-[0.3em] text-[8px] border border-white/10 px-4 py-1.5 rounded-full">Coming Soon</span>
                             </div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">Eco <span class="text-[#E50000]">Quad Bunk</span></h3>
                            <p class="text-black/40 text-sm font-medium mb-8">Redefining space for large families with four dedicated berths.</p>
                            <div class="w-fit px-8 py-3.5 bg-black/5 text-black/20 font-black uppercase tracking-[0.2em] text-[9px] rounded-full">Coming Soon</div>
                        </div>
                    </div>



                </div>
            </div>
        </section>



        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. CUSTOMISED FOR YOUR LIFESTYLE              -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row gap-16 lg:gap-20 items-start">
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">Overview</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">Customised For<br/><span class="text-[#E50000]">Your Lifestyle.</span></h2>
                    <p class="text-black/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay:600ms;animation-fill-mode:both;">
                        From romantic getaways to family adventures, customise your Eco 18.6 layout for your travel dream.
                    </p>
                    <p class="text-black/50 font-medium md:text-base leading-relaxed mb-8 animate-fade-up" style="animation-delay:700ms;animation-fill-mode:both;">
                        Each caravan is meticulously built at Hike RV with precision craftsmanship and local expertise. We design our models, from the Eco to the Grand Rover, to enhance your adventure, offering smart layouts, premium materials, and seamless off-road capability to elevate your travel experience.
                    </p>
                    <p class="text-black/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                        From adventurous family escapes to romantic couple's journeys, this 18.6-model caravan blends innovation and versatility. Supported by outstanding warranty coverage and trusted build quality, every journey is backed by reliability, comfort, and a passion for exploration.
                    </p>
                    <div class="flex flex-wrap gap-3 mt-10 animate-fade-up" style="animation-delay:900ms;animation-fill-mode:both;">
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Lightweight</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Off-Road Ready</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Smart Layout</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Premium Build</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Full Ensuite</span>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <div class="relative rounded-[2rem] overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.08)] group">
                        <img src="/rover/eco/exterior.png" alt="Eco 18.6" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700" />
                        <div class="absolute inset-0 rounded-[2rem] border border-black/5 pointer-events-none"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. BUILT FOR EVERY TRAVELLER                  -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-black text-white overflow-hidden">
            <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[40vw] h-[40vw] max-w-[500px] max-h-[500px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row-reverse gap-16 lg:gap-20 items-center">
                <!-- Premium three-image collage layout -->
                <div class="w-full lg:w-1/2 flex gap-4 md:gap-6 animate-fade-up items-start" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="flex-[1.2]">
                        <div class="relative rounded-[1.5rem] md:rounded-[2.5rem] overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.4)] group aspect-[3/4]">
                            <img src="/rover/eco/interior1.png" alt="Eco 18.6 Interior Main" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.5rem] md:rounded-[2.5rem] pointer-events-none"></div>
                        </div>
                    </div>
                    <div class="flex-1 flex flex-col gap-4 md:gap-6 mt-8 md:mt-16">
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                            <img src="/rover/eco/interior2.png" alt="Eco 18.6 Kitchen" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                            <img src="/rover/eco/interior3.png" alt="Eco 18.6 Ensuite" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Every Traveller</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">Built For<br/><span class="text-[#E50000]">Adventure.</span></h2>
                    <p class="text-white/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay:700ms;animation-fill-mode:both;">
                        Whether it's the compact Eco 18.6, rugged Drifter Series, or luxurious Elite models, each range has stylish interiors, smart storage, and durable construction tailored to both on-road and off-grid adventures.
                    </p>
                    <p class="text-white/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay:900ms;animation-fill-mode:both;">
                        Choose true freedom and luxury with Hike RV Caravans. Every model offers ultimate comfort, innovative yet practical design, and reliable performance, ensuring you enjoy every twist, turn, and stop on your next adventure.
                    </p>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 4. SPECIFICATIONS — Tabbed Comparison         -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                <div class="mb-16">
                    <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none">Specifications<span class="text-[#E50000]">.</span></h2>
                    <p class="text-black/50 font-medium md:text-lg mt-4 max-w-2xl">Compare the three available packs side by side.</p>
                </div>
                <div class="flex flex-col lg:flex-row gap-10">
                    <div class="flex flex-row lg:flex-col gap-3 lg:w-[220px] shrink-0">
                        <button data-tier="ultra" class="tier-tab active-tier w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Ultra Pack</button>
                        <button data-tier="terrain" class="tier-tab w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Terrain Pack</button>
                        <button data-tier="hiker" class="tier-tab w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Hiker Pack</button>
                    </div>
                    <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Chassis</h3><ul id="spec-chassis" class="flex flex-col gap-2.5"></ul></div>
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Furniture</h3><ul id="spec-furniture" class="flex flex-col gap-2.5"></ul></div>
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Electrical</h3><ul id="spec-electrical" class="flex flex-col gap-2.5"></ul></div>
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Plumbing</h3><ul id="spec-plumbing" class="flex flex-col gap-2.5"></ul></div>
                    </div>
                </div>
            </div>
        </section>

        <script>
        const specData={ultra:{chassis:["Silver shine chassis",'6" Chassis','2" Chassis Raiser','6" Extended A-frame',"Drop Legs x 4","2 X Battery Boxes"],furniture:["White stipple Furniture","Front robe port Holes","Postform Benchtops","Recessed Mini grill","Air conditioner Frame","Smoke detector"],electrical:["LED Internal Down lights","LED Boot Lights","External 240 Power point","HV Wingard sensor","Grey Anderson Plug","12 Pin Trailer Plug"],plumbing:["Water fillers X 2 Lockable","224L DOMETIC 3 way Fridge","Fridge/Freezer","Swift Mini grill","Water filter system","Thetford Cassette Toilet"]},terrain:{chassis:["Silver shine chassis",'6" Chassis','2" Chassis Raiser','6" Extended A-frame',"Drop Step","Do-35 Coupling"],furniture:["White stipple Furniture","Front robe port Holes","Postform Benchtops","Queen Bed 1900 x 500mm","Smoke detector","Bottom Mount Rangehood"],electrical:["Belair 3400 air conditioner","LED Internal Down lights","LED Boot Lights","External 240 Power point","Bottom mount Rangehood","BM-pro Trail safe"],plumbing:["Water fillers X 2 Lockable","188L DOMETIC 3 way","Fridge/Freezer","Swift Mini grill","1 x Elec + 3 x gas","White Ceramic Basin"]},hiker:{chassis:["Silver shine chassis",'6" Chassis','2" Chassis Raiser','6" Extended A-frame','2800KG 12" Brakes',"8\" Jockey Wheels"],furniture:["White stipple Furniture","Front robe port Holes","Postform Benchtops","Recessed Mini grill","20L Microwave","Smoke detector"],electrical:["Belair 3400 air conditioner","LED Internal Down lights","LED Boot Lights","External 240 Power point","BM-pro Trail safe","Grey Anderson Plug"],plumbing:["Water fillers X 2 Lockable","188L DOMETIC 12v","Fridge/Freezer","Swift Mini grill","1 x Elec + 3 x gas","Water filter system"]}};
        function renderSpecs(tier){const d=specData[tier];['chassis','furniture','electrical','plumbing'].forEach(cat=>{const ul=document.getElementById('spec-'+cat);if(ul)ul.innerHTML=d[cat].map(item=>`<li class="flex items-start gap-3"><span class="w-4 h-4 shrink-0 mt-0.5 text-[#E50000]"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg></span><span class="text-sm text-black/60 font-medium">${item}</span></li>`).join('');});}
        document.querySelectorAll('.tier-tab').forEach(btn=>{btn.addEventListener('click',()=>{document.querySelectorAll('.tier-tab').forEach(b=>b.classList.remove('active-tier'));btn.classList.add('active-tier');renderSpecs(btn.dataset.tier);});});
        renderSpecs('ultra');
        </script>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 5. CTA                                        -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="contact" class="relative z-10 w-full py-24 md:py-32 bg-black text-white overflow-hidden">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>
            <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#E50000]/30 to-transparent"></div>
            <div class="max-w-3xl mx-auto px-6 md:px-14 text-center relative z-10">
                <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block">Your Adventure Starts Here</span>
