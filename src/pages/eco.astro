---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="Eco Series | Hike RV Caravans" description="The Eco Series — lightweight, smart layouts and off-road capability for sustainable adventure.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO — Split Editorial Layout              -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full min-h-[100vh] flex flex-col lg:flex-row overflow-hidden bg-black">
            <div class="relative z-10 w-full lg:w-[45%] flex flex-col justify-center px-8 md:px-14 lg:px-20 py-32 lg:py-20">
                <div class="absolute top-0 right-0 hidden lg:block w-px h-full bg-gradient-to-b from-transparent via-white/10 to-transparent"></div>
                <a href="/rover" class="flex items-center gap-2 text-white/40 text-[10px] font-bold uppercase tracking-[0.3em] mb-10 hover:text-[#E50000] transition-colors duration-300 w-fit animate-fade-up" style="animation-delay:100ms;animation-fill-mode:both;">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
                    Rover Series
                </a>
                <div class="flex items-center gap-4 mb-6 animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="w-12 h-1 bg-[#E50000] rounded-full"></div>
                    <span class="text-[#E50000] text-[10px] font-black uppercase tracking-[0.4em]">Eco Collection</span>
                </div>
                <h1 class="text-white text-[3.5rem] md:text-[5rem] lg:text-[6rem] font-black uppercase tracking-tighter leading-[0.85] mb-3 animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Pure.</h1>
                <h2 class="text-[2rem] md:text-[2.5rem] lg:text-[3rem] font-black uppercase tracking-tighter leading-[0.9] mb-8 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-white/80 to-white/40">The Eco</span> <span class="text-[#E50000]">Series</span>
                </h2>
                <p class="text-white/50 font-medium text-sm md:text-base leading-relaxed max-w-md mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">
                    Engineered for high-performance efficiency and sustainable adventure, the Eco series offers multiple layouts to suit every voyager.
                </p>
                <div class="flex flex-col sm:flex-row items-start gap-4 animate-fade-up" style="animation-delay:600ms;animation-fill-mode:both;">
                    <a href="#variants" class="px-8 py-3.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)]">Explore Range</a>
                    <a href="/eco-186" class="px-8 py-3.5 border border-white/20 text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full">View Eco 18.6</a>
                </div>
                <div class="flex items-center gap-8 mt-14 pt-8 border-t border-white/10 animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                    <div><span class="block text-2xl md:text-3xl font-black text-white">18.6<span class="text-[#E50000]">ft</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Length</span></div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div><span class="block text-2xl md:text-3xl font-black text-white">3<span class="text-[#E50000]"> Packs</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Available</span></div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div><span class="block text-2xl md:text-3xl font-black text-white">Eco<span class="text-[#E50000]">+</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Smart</span></div>
                </div>
            </div>
            <div class="relative w-full lg:w-[55%] min-h-[50vh] lg:min-h-full">
                <img src="/rover/ecorover.png" alt="Eco 18.6" class="w-full h-full object-cover object-center" />
                <div class="absolute inset-0 bg-[linear-gradient(to_right,_rgb(0_0_0)_0%,_rgb(0_0_0/0.1)_30%,_transparent_60%)] lg:block hidden"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent lg:hidden"></div>
                <div class="absolute bottom-8 right-8 hidden lg:flex flex-col items-end gap-2 animate-fade-up" style="animation-delay:1000ms;animation-fill-mode:both;">
                    <span class="text-white/20 text-[9px] font-bold uppercase tracking-[0.3em]">Scroll to explore</span>
                    <div class="w-px h-12 bg-gradient-to-b from-white/30 to-transparent animate-pulse"></div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. MODELS / VARIANTS SECTION                  -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="variants" class="relative z-10 w-full py-24 md:py-36 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">

                <div class="text-center mb-20">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.5em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">Eco Range</span>
                    <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                        Choose Your<br/><span class="text-[#E50000]">Configuration.</span>
                    </h2>
                </div>

                <!-- Variant Cards Grid -->
                <div class="grid grid-cols-1 gap-8 lg:gap-10 max-w-md mx-auto">

                    <!-- Eco 18.6 -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-[#f4f4f4] flex items-center justify-center overflow-hidden relative">
                            <img src="/rover/eco/exterior.png" alt="Eco 18.6" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                            <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">Eco <span class="text-[#E50000]">18.6ft</span></h3>
                            <a href="/eco-186" class="w-fit px-8 py-3.5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-[#E50000] transition-all duration-500 rounded-full shadow-md">
                                Know More
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. CTA                                        -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="contact" class="relative z-10 w-full py-24 md:py-32 bg-black text-white overflow-hidden">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>
            <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#E50000]/30 to-transparent"></div>
            <div class="max-w-3xl mx-auto px-6 md:px-14 text-center relative z-10">
                <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block">Your Adventure Starts Here</span>
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-8">Go<br/><span class="text-[#E50000]">Eco.</span></h2>
                <p class="text-white/50 font-medium md:text-lg leading-relaxed mb-12 max-w-xl mx-auto">Contact our team to configure the perfect Eco for your next adventure.</p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
                    <a href="/#contact" class="px-12 py-5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)]">Get a Quote</a>
                    <a href="/eco-186" class="px-12 py-5 border border-white/20 text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full">View Eco 18.6</a>
                </div>
                <a href="/rover" class="inline-block mt-8 text-white/40 text-[10px] font-bold uppercase tracking-[0.3em] hover:text-white/70 transition-colors duration-300">← Back to Rover Series</a>
            </div>
        </section>
    </main>
</Layout>

<style>
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up { animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
</style>
