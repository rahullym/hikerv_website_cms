---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="Videos | Hike RV Caravans" description="Watch our caravans in action.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">
        
        <!-- Background Accents -->
        <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[80vw] h-[80vw] max-w-[800px] max-h-[800px] bg-[#E50000]/5 rounded-full blur-[150px] opacity-50 z-0 pointer-events-none"></div>

        <!-- 1. HERO SECTION -->
        <section class="relative z-10 w-full bg-black pt-40 pb-24 md:pt-48 md:pb-32 px-6 md:px-14 flex flex-col items-center justify-center text-center overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-b from-black via-black/90 to-[#111] z-0"></div>
            
            <div class="relative z-10 flex items-center justify-center gap-4 sm:gap-6 mb-8 animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">
                <div class="w-8 sm:w-16 h-px bg-white/20"></div>
                <span class="text-white text-[10px] sm:text-xs font-black uppercase tracking-[0.5em] text-center drop-shadow-md">
                    Media
                </span>
                <div class="w-8 sm:w-16 h-px bg-white/20"></div>
            </div>

            <h1 class="relative z-10 text-white text-4xl md:text-6xl lg:text-[7rem] font-black uppercase tracking-tighter leading-[0.85] mb-8 animate-fade-up drop-shadow-2xl" style="animation-delay: 400ms; animation-fill-mode: both;">
                Video <br/>
                <span class="text-[#E50000]">Gallery.</span>
            </h1>

            <p class="relative z-10 text-white/70 font-semibold text-sm md:text-lg tracking-wide max-w-2xl animate-fade-up drop-shadow-lg" style="animation-delay: 600ms; animation-fill-mode: both;">
                Explore the craftsmanship, features, and adventures of Hike RV Caravans.
            </p>
        </section>

        <!-- 2. GALLERY SECTION (Simple & Elegant Grid) -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-white text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16">
                    
                    <!-- Video 1 -->
                    <div class="flex flex-col gap-8 animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">
                        <div class="w-full aspect-video bg-black rounded-3xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.05)] border border-black/5">
                            <iframe 
                                class="w-full h-full"
                                src="https://www.youtube.com/embed/yromWNwZPRo?rel=0" 
                                title="Hike RV Feature" 
                                frameborder="0" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                                allowfullscreen>
                            </iframe>
                        </div>
                        <div class="flex flex-col items-center text-center px-4">
                            <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] mb-3">Feature</span>
                            <h3 class="text-3xl font-black uppercase tracking-tight text-black mb-4">The Off-Grid Series</h3>
                            <p class="text-black/50 font-medium text-base leading-relaxed max-w-sm">
                                A cinematic look at our most rugged, adventure-ready caravans.
                            </p>
                        </div>
                    </div>

                    <!-- Video 2 -->
                    <div class="flex flex-col gap-8 animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                        <div class="w-full aspect-video bg-black rounded-3xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.05)] border border-black/5">
                            <iframe 
                                class="w-full h-full"
                                src="https://www.youtube.com/embed/aqQDL4BXYWY?rel=0" 
                                title="Hike RV Walkthrough" 
                                frameborder="0" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                                allowfullscreen>
                            </iframe>
                        </div>
                        <div class="flex flex-col items-center text-center px-4">
                            <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] mb-3">Walkthrough</span>
                            <h3 class="text-3xl font-black uppercase tracking-tight text-black mb-4">Complete Walkthrough</h3>
                            <p class="text-black/50 font-medium text-base leading-relaxed max-w-sm">
                                Deep dive into the premium finishes and customs structural integrations.
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </section>

    </main>
</Layout>

<style>
    /* Shared keyframes for unified animations */
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>
