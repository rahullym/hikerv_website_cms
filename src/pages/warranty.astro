---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout
	title="Caravan Warranty Australia | Hike RV Coverage"
	description="Hike RV warranty — comprehensive coverage on Australian made off road, family and luxury caravans. Peace of mind on every journey."
	keywords="caravan warranty Australia, Hike RV warranty, Australian made caravans, off road caravans Australia, luxury caravans Australia, caravan service Australia"
>
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">
        
        <!-- Background Accents -->
        <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[80vw] h-[80vw] max-w-[800px] max-h-[800px] bg-[#E50000]/5 rounded-full blur-[150px] opacity-50 z-0 pointer-events-none"></div>

        <!-- 1. HERO SECTION -->
        <section class="relative z-10 w-full bg-black pt-40 pb-24 md:pt-48 md:pb-32 px-6 md:px-14 flex flex-col items-center justify-center text-center overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-b from-black via-black/90 to-[#111] z-0"></div>
            
            <div class="relative z-10 flex items-center justify-center gap-4 sm:gap-6 mb-8 animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">
                <div class="w-8 sm:w-16 h-px bg-white/20"></div>
                <span class="text-white text-[10px] sm:text-xs font-black uppercase tracking-[0.5em] text-center drop-shadow-md">
                    Customer Care
                </span>
                <div class="w-8 sm:w-16 h-px bg-white/20"></div>
            </div>

            <h1 class="relative z-10 text-white text-4xl md:text-6xl lg:text-[7rem] font-black uppercase tracking-tighter leading-[0.85] mb-8 animate-fade-up drop-shadow-2xl" style="animation-delay: 400ms; animation-fill-mode: both;">
                Manufacturer <br/>
                <span class="text-[#E50000]">Warranty.</span>
            </h1>

            <p class="relative z-10 text-white/70 font-semibold text-sm md:text-lg tracking-wide max-w-2xl animate-fade-up drop-shadow-lg" style="animation-delay: 600ms; animation-fill-mode: both;">
                2 Years Manufacturer Warranty. Details to claim warranty below.
            </p>
        </section>

        <!-- 2. CONTENT SECTION -->
        <section class="relative z-10 w-full py-24 md:py-32 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1400px] mx-auto px-6 md:px-14 flex flex-col">

                <!-- Text content -->
                <div class="w-full flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">Confidence Built In</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                        Comprehensive<br/>Warranty Promise.
                    </h2>
                    
                    <p class="text-black/60 font-medium md:text-xl leading-relaxed mb-12 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay: 600ms; animation-fill-mode: both;">
                        At HIKE RV, we believe your journey should come with confidence built in. That’s why every HIKE caravan is backed by our comprehensive warranty promise — including 2 years manufacturing warranty and 5 years structural coverage.
                    </p>

                    <p class="text-black/60 font-medium md:text-lg leading-relaxed mb-10 animate-fade-up" style="animation-delay: 800ms; animation-fill-mode: both;">
                        Whether you’re close to home or exploring off-grid, our nationwide network of authorised dealers and service agents is here to support you with expert care and genuine parts. 
                        Repairs carried out by unauthorised providers are not covered unless formally approved by HIKE RV, ensuring every fix meets our high standards.
                    </p>

                    <div class="w-full h-px bg-black/10 mb-10 animate-fade-up" style="animation-delay: 1000ms; animation-fill-mode: both;"></div>
                    
                    <h3 class="font-black uppercase tracking-widest text-[#E50000] mb-8 md:text-lg animate-fade-up" style="animation-delay: 1100ms; animation-fill-mode: both;">Coverage Includes:</h3>
                    
                    <ul class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 text-black/70 font-black uppercase tracking-widest text-xs md:text-sm animate-fade-up" style="animation-delay: 1200ms; animation-fill-mode: both;">
                        <li class="flex items-center gap-3 bg-white p-5 md:p-6 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <span class="w-2 h-2 rounded-full bg-[#E50000] shrink-0"></span> Plumbing
                        </li>
                        <li class="flex items-center gap-3 bg-white p-5 md:p-6 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <span class="w-2 h-2 rounded-full bg-[#E50000] shrink-0"></span> Structural
                        </li>
                        <li class="flex items-center gap-3 bg-white p-5 md:p-6 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <span class="w-2 h-2 rounded-full bg-[#E50000] shrink-0"></span> Electrical
                        </li>
                        <li class="flex items-center gap-3 bg-white p-5 md:p-6 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <span class="w-2 h-2 rounded-full bg-[#E50000] shrink-0"></span> General Construction
                        </li>
                    </ul>
                </div>

            </div>
        </section>

        <!-- 3. WARRANTY CLAIM FORM SECTION -->
        <section id="claim-form" class="relative z-10 w-full pt-8 pb-24 md:pt-12 md:pb-32 bg-[#fdfdfd] text-black overflow-hidden">
            <!-- Subtle accent glow -->
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[60vw] h-[40vw] max-w-[800px] max-h-[500px] bg-[#E50000]/[0.06] rounded-full blur-[120px] pointer-events-none"></div>

            <div class="max-w-[1100px] mx-auto px-6 md:px-14 relative">
                <div class="text-center mb-12 md:mb-16">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">Submit a Claim</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-6 animate-fade-up" style="animation-delay: 300ms; animation-fill-mode: both;">
                        Warranty Claim<br/><span class="text-[#E50000]">Form.</span>
                    </h2>
                    <p class="text-black/55 font-medium md:text-lg leading-relaxed max-w-2xl mx-auto animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                        We’re sorry to hear you’re experiencing an issue. Fill out the form below — our team will be in touch shortly to make things right.
                    </p>
                </div>

                <div class="relative animate-fade-up" style="animation-delay: 600ms; animation-fill-mode: both;">
                    <!-- Decorative frame -->
                    <div class="absolute -inset-3 md:-inset-4 rounded-[2.5rem] bg-gradient-to-br from-[#E50000]/30 via-black/5 to-transparent pointer-events-none"></div>
                    <div class="relative bg-white rounded-[2rem] border border-black/5 shadow-[0_30px_80px_rgba(0,0,0,0.10)] overflow-hidden">
                        <iframe
                            src="https://hikecaravans.rework.com/workflows/a/webform/MzI1LndlYmZvcm1z?mode=iframe"
                            title="Warranty Claim Form"
                            loading="lazy"
                            class="w-full h-[900px] md:h-[1100px] lg:h-[1200px] border-0 bg-white block"
                        >Loading…</iframe>
                    </div>
                    <p class="text-center text-black/30 text-[10px] font-bold uppercase tracking-[0.3em] mt-6">
                        Form unable to load? <a href="mailto:info@hikerv.com.au" class="text-[#E50000] hover:underline">Email us at info@hikerv.com.au</a>
                    </p>
                </div>
            </div>
        </section>

    </main>
</Layout>

<style>
    /* Shared keyframes for unified animations */
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    /* Smooth input autofill styling reset */
    input:-webkit-autofill,
    input:-webkit-autofill:hover, 
    input:-webkit-autofill:focus, 
    input:-webkit-autofill:active,
    textarea:-webkit-autofill,
    textarea:-webkit-autofill:hover,
    textarea:-webkit-autofill:focus,
    textarea:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 30px white inset !important;
        -webkit-text-fill-color: black !important;
        transition: background-color 5000s ease-in-out 0s;
    }
</style>
