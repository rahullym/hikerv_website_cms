---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="Warranty | Hike RV Caravans" description="Our comprehensive warranty coverage ensures your peace of mind on every journey.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">
        
        <!-- Background Accents -->
        <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[80vw] h-[80vw] max-w-[800px] max-h-[800px] bg-[#E50000]/5 rounded-full blur-[150px] opacity-50 z-0 pointer-events-none"></div>

        <!-- 1. HERO SECTION -->
        <section class="relative z-10 w-full bg-black pt-40 pb-24 md:pt-48 md:pb-32 px-6 md:px-14 flex flex-col items-center justify-center text-center overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-b from-black via-black/90 to-[#111] z-0"></div>
            
            <div class="relative z-10 flex items-center justify-center gap-4 sm:gap-6 mb-8 animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">
                <div class="w-8 sm:w-16 h-px bg-white/20"></div>
                <span class="text-white text-[10px] sm:text-xs font-black uppercase tracking-[0.5em] text-center drop-shadow-md">
                    Customer Care
                </span>
                <div class="w-8 sm:w-16 h-px bg-white/20"></div>
            </div>

            <h1 class="relative z-10 text-white text-4xl md:text-6xl lg:text-[7rem] font-black uppercase tracking-tighter leading-[0.85] mb-8 animate-fade-up drop-shadow-2xl" style="animation-delay: 400ms; animation-fill-mode: both;">
                Manufacturer <br/>
                <span class="text-[#E50000]">Warranty.</span>
            </h1>

            <p class="relative z-10 text-white/70 font-semibold text-sm md:text-lg tracking-wide max-w-2xl animate-fade-up drop-shadow-lg" style="animation-delay: 600ms; animation-fill-mode: both;">
                2 Years Manufacturer Warranty. Details to claim warranty below.
            </p>
        </section>

        <!-- 2. CONTENT & FORM SECTION -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row gap-20">
                
                <!-- Left Side (Text content) -->
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">Confidence Built In</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                        Comprehensive<br/>Warranty Promise.
                    </h2>
                    
                    <p class="text-black/60 font-medium md:text-xl leading-relaxed mb-12 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay: 600ms; animation-fill-mode: both;">
                        At HIKE RV, we believe your journey should come with confidence built in. That’s why every HIKE caravan is backed by our comprehensive warranty promise — including 2 years manufacturing warranty and 5 years structural coverage.
                    </p>

                    <p class="text-black/60 font-medium md:text-lg leading-relaxed mb-10 animate-fade-up" style="animation-delay: 800ms; animation-fill-mode: both;">
                        Whether you’re close to home or exploring off-grid, our nationwide network of authorised dealers and service agents is here to support you with expert care and genuine parts. 
                        Repairs carried out by unauthorised providers are not covered unless formally approved by HIKE RV, ensuring every fix meets our high standards.
                    </p>

                    <div class="w-full h-px bg-black/10 mb-10 animate-fade-up" style="animation-delay: 1000ms; animation-fill-mode: both;"></div>
                    
                    <h3 class="font-black uppercase tracking-widest text-[#E50000] mb-8 md:text-lg animate-fade-up" style="animation-delay: 1100ms; animation-fill-mode: both;">Coverage Includes:</h3>
                    
                    <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 text-black/70 font-black uppercase tracking-widest text-sm md:text-base animate-fade-up" style="animation-delay: 1200ms; animation-fill-mode: both;">
                        <li class="flex items-center gap-4 bg-white p-6 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <span class="w-2 h-2 rounded-full bg-[#E50000]"></span> Plumbing
                        </li>
                        <li class="flex items-center gap-4 bg-white p-6 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <span class="w-2 h-2 rounded-full bg-[#E50000]"></span> Structural
                        </li>
                        <li class="flex items-center gap-4 bg-white p-6 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <span class="w-2 h-2 rounded-full bg-[#E50000]"></span> Electrical
                        </li>
                        <li class="flex items-center gap-4 bg-white p-6 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <span class="w-2 h-2 rounded-full bg-[#E50000]"></span> General Construction
                        </li>
                    </ul>
                </div>

                <!-- Right Side (Form) -->
                <div class="w-full lg:w-1/2 animate-fade-up" style="animation-delay: 800ms; animation-fill-mode: both;">
                    <div class="flex flex-col gap-8 w-full max-w-xl bg-white p-10 md:p-14 rounded-[3rem] border border-black/5 shadow-[0_20px_60px_rgba(0,0,0,0.05)] mx-auto lg:ml-auto lg:mr-0">
                        
                        <div class="flex flex-col gap-4 mb-4">
                            <h3 class="text-3xl font-black uppercase tracking-tighter text-black">Warranty Claim Form</h3>
                            <p class="text-black/50 text-xs md:text-sm font-medium leading-relaxed italic border-l-2 border-black/10 pl-4 py-1">
                                “Thank you for choosing Hike Rv! We’re sorry to hear that you’re experiencing an issue with your product. Don’t worry, we’ve got you covered! Please fill out the warranty claim form below, and our team will jump into action to assist you. We’re here to make things right and ensure your satisfaction. Let’s get started!”
                            </p>
                            <p class="text-[#E50000] text-[10px] md:text-xs font-bold uppercase tracking-wider mt-2">
                                Please fill out the form below with the required details, and we’ll be in touch with you shortly.
                            </p>
                        </div>
                        
                        <form class="flex flex-col gap-8">
                            <div class="flex flex-col gap-2 relative group">
                                <label for="name" class="text-[10px] font-black uppercase tracking-[0.2em] text-black/50 group-focus-within:text-[#E50000] transition-colors">Full Name *</label>
                                <input type="text" id="name" required class="w-full bg-transparent border-b border-black/10 pb-2 text-black placeholder-black/20 focus:outline-none focus:border-[#E50000] transition-colors font-medium">
                            </div>

                            <div class="flex flex-col gap-2 relative group">
                                <label for="email" class="text-[10px] font-black uppercase tracking-[0.2em] text-black/50 group-focus-within:text-[#E50000] transition-colors">Email Address *</label>
                                <input type="email" id="email" required class="w-full bg-transparent border-b border-black/10 pb-2 text-black placeholder-black/20 focus:outline-none focus:border-[#E50000] transition-colors font-medium">
                            </div>

                            <div class="flex flex-col gap-2 relative group">
                                <label for="phone" class="text-[10px] font-black uppercase tracking-[0.2em] text-black/50 group-focus-within:text-[#E50000] transition-colors">Phone Number *</label>
                                <input type="tel" id="phone" required class="w-full bg-transparent border-b border-black/10 pb-2 text-black placeholder-black/20 focus:outline-none focus:border-[#E50000] transition-colors font-medium">
                            </div>

                            <div class="flex flex-col gap-2 relative group">
                                <label for="chassis" class="text-[10px] font-black uppercase tracking-[0.2em] text-black/50 group-focus-within:text-[#E50000] transition-colors">Chassis Number (VIN) *</label>
                                <input type="text" id="chassis" required class="w-full bg-transparent border-b border-black/10 pb-2 text-black placeholder-black/20 focus:outline-none focus:border-[#E50000] transition-colors font-medium">
                            </div>
                            
                            <div class="flex flex-col gap-2 mb-4 relative group">
                                <label for="issue" class="text-[10px] font-black uppercase tracking-[0.2em] text-black/50 group-focus-within:text-[#E50000] transition-colors">Issue Description *</label>
                                <textarea id="issue" rows="4" required class="w-full bg-transparent border-b border-black/10 pb-2 text-black placeholder-black/20 focus:outline-none focus:border-[#E50000] transition-colors font-medium resize-none"></textarea>
                            </div>

                            <button type="submit" class="w-fit px-12 py-5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-[#E50000] transition-colors duration-500 mt-2 rounded-full shadow-xl">
                                Submit Claim
                            </button>
                        </form>
                    </div>
                </div>

            </div>
        </section>

    </main>
</Layout>

<style>
    /* Shared keyframes for unified animations */
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    /* Smooth input autofill styling reset */
    input:-webkit-autofill,
    input:-webkit-autofill:hover, 
    input:-webkit-autofill:focus, 
    input:-webkit-autofill:active,
    textarea:-webkit-autofill,
    textarea:-webkit-autofill:hover,
    textarea:-webkit-autofill:focus,
    textarea:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 30px white inset !important;
        -webkit-text-fill-color: black !important;
        transition: background-color 5000s ease-in-out 0s;
    }
</style>
