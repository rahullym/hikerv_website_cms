---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import MoodBoardSection from "../components/MoodBoardSection.astro";
---

<Layout title="Armadillo | Elite Series | Hike RV Caravans" description="Discover unmatched durability and comfort designed for explorers seeking the ultimate off-road caravan experience. Built tough to take you anywhere with ease.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO — Split Editorial Layout (Elite Style) -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full min-h-[100vh] flex flex-col lg:flex-row overflow-hidden bg-black text-white">
            <!-- Left: Content -->
            <div class="relative z-10 w-full lg:w-[45%] flex flex-col justify-center px-8 md:px-14 lg:px-20 py-32 lg:py-20">
                <div class="absolute top-0 right-0 hidden lg:block w-px h-full bg-gradient-to-b from-transparent via-[#D4AF37]/20 to-transparent"></div>
                
                <a href="/elite" class="flex items-center gap-2 text-white/40 text-[10px] font-bold uppercase tracking-[0.3em] mb-10 hover:text-[#D4AF37] transition-colors duration-300 w-fit animate-fade-up" style="animation-delay:100ms;animation-fill-mode:both;">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
                    Elite Series
                </a>

                <div class="flex items-center gap-4 mb-6 animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="w-12 h-0.5 bg-[#D4AF37]/60"></div>
                    <span class="text-[#D4AF37] text-[10px] font-black uppercase tracking-[0.4em]">Flagship Model</span>
                </div>

                <h1 class="text-white text-[3.5rem] md:text-[5rem] lg:text-[6rem] font-black uppercase tracking-tighter leading-[0.85] mb-3 animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Luxurious.</h1>
                <h2 class="text-white text-[2rem] md:text-[2.5rem] lg:text-[3rem] font-black uppercase tracking-tighter leading-[0.9] mb-8 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    Armadillo
                </h2>

                <p class="text-white/50 font-medium text-sm md:text-base leading-relaxed max-w-md mb-10 animate-fade-up" style="animation-delay: 500ms; animation-fill-mode: both;">
                    Discover unmatched durability and comfort designed for explorers seeking the ultimate off-road caravan experience. Built tough to take you anywhere with ease.
                </p>

                <div class="flex flex-col sm:flex-row items-start gap-4 animate-fade-up" style="animation-delay: 600ms; animation-fill-mode: both;">
                    <a href="#contact" class="px-8 py-3.5 bg-gradient-to-r from-[#D4AF37] to-[#B8941E] text-black font-black uppercase tracking-[0.2em] text-[10px] hover:from-white hover:to-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(212,175,55,0.3)]">Get Quote</a>
                    <a href="#" class="px-8 py-3.5 border border-[#D4AF37]/30 text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full flex items-center gap-2 group">
                        <svg class="w-4 h-4 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                        Brochure
                    </a>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-5 mt-14 pt-8 border-t border-white/10 animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">3000W</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Inverter</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 12v3.75h18V12zM4.5 15.75v3M19.5 15.75v3M6.75 9.75V8.25A2.25 2.25 0 019 6h6a2.25 2.25 0 012.25 2.25v1.5"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">Separate Shower</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Toilet</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 3h13.5a1.5 1.5 0 011.5 1.5v15a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-15a1.5 1.5 0 011.5-1.5zM3.75 11.25h16.5M7.5 7.5v-.75M7.5 15v-.75"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">188L Dometic</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Compressor Fridge</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75A2.25 2.25 0 016 4.5h12a2.25 2.25 0 012.25 2.25v10.5A2.25 2.25 0 0118 19.5H6a2.25 2.25 0 01-2.25-2.25V6.75zM3.75 10.5h16.5M7.5 4.5v15M16.5 4.5v15"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">Aluminum/Celuka</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Hybrid Framing</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v3M12 18v3M5.636 5.636l2.121 2.121M16.243 16.243l2.121 2.121M3 12h3M18 12h3M5.636 18.364l2.121-2.121M16.243 7.757l2.121-2.121"/><circle cx="12" cy="12" r="4" stroke-width="1.8"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">Shine XT</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Independent Susp.</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="4" y="3" width="16" height="18" rx="1.5"/><circle cx="12" cy="13" r="4"/><circle cx="8" cy="6.5" r=".5" fill="currentColor"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">2.5kg Wall</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Mount Washer</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 10.5h.375c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125H21M4.5 10.5H18V15H4.5v-4.5zM3.75 18h15A2.25 2.25 0 0021 15.75v-6a2.25 2.25 0 00-2.25-2.25h-15A2.25 2.25 0 001.5 9.75v6A2.25 2.25 0 003.75 18z"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">2 × 150Ah</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Lithium</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="14" rx="1"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 8.5h18M3 13h18M9 4v14M15 4v14M9 21h6"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">3 × 200W</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Solar Panel</span>
                    </div>
                </div>
            </div>
            <!-- Right: Image -->
            <div class="relative w-full lg:w-[55%] min-h-[50vh] lg:min-h-full">
                <img src="/elite/armadillo.png" alt="Armadillo Expedition" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-r from-black via-black/20 to-transparent lg:block hidden"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent lg:hidden"></div>
                <!-- Small Floating Text -->
                <div class="absolute bottom-10 right-10 hidden lg:flex flex-col items-end gap-2 animate-fade-up" style="animation-delay: 1000ms; animation-fill-mode: both;">
                   <span class="text-white/30 text-[10px] uppercase font-black tracking-widest leading-none mb-1">Adventure Awaits</span>
                   <div class="w-20 h-px bg-[#D4AF37]/50"></div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. BUILT FOR EXPLORATION                      -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-white text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row gap-16 lg:gap-24 items-start">
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#D4AF37] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">Engineering Excellence</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-[0.9] mb-10 animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">Built For<br/><span class="text-[#D4AF37]">Exploration.</span></h2>
                    
                    <p class="text-black/60 font-medium md:text-xl leading-relaxed mb-8 animate-fade-up border-l-4 border-[#D4AF37] pl-6 md:pl-10" style="animation-delay: 600ms; animation-fill-mode: both;">
                        The Armadillo caravan is crafted with a full aluminium-framed structure for strength and longevity. Built tough to take you anywhere with ease.
                    </p>
                    
                    <p class="text-black/50 font-medium md:text-base leading-relaxed mb-8 animate-fade-up" style="animation-delay: 700ms; animation-fill-mode: both;">
                        Designed with adventurers in mind, the Armadillo boasts a spacious interior, smart layout, and all the modern amenities you need. Every detail elevates your journey from the high-capacity battery and solar setup to the insulated walls and quality fittings. Whether you’re crossing dusty outbacks or cruising coastal roads, this caravan guarantees reliability and style.
                    </p>

                    <p class="text-black/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay: 800ms; animation-fill-mode: both;">
                        Experience next-level innovation and performance, with features like a top-load washing machine and a 3-way 188L fridge. The Armadillo is perfect for couples or small families wanting a dependable, luxurious base camp wherever you roam. Get ready to make memories off the beaten path with confidence.
                    </p>

                    <!-- Feature chips -->
                    <div class="flex flex-wrap gap-3 mt-10 animate-fade-up" style="animation-delay: 900ms; animation-fill-mode: both;">
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#D4AF37]/50 transition-all duration-300">Aluminium Frame</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#D4AF37]/50 transition-all duration-300">Off-Road Suspension</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#D4AF37]/50 transition-all duration-300">Washing Machine</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#D4AF37]/50 transition-all duration-300">Solar Power</span>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                    <div class="relative rounded-[2rem] overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.1)] group aspect-video">
                        <img src="/elite/armadillo.png" alt="Armadillo Exterior" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                        <!-- Gold Border -->
                        <div class="absolute inset-0 rounded-[2rem] border-2 border-[#D4AF37]/30 pointer-events-none"></div>
                    </div>

                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. ADVENTURE-READY FEATURES                   -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-black text-white overflow-hidden">
            <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[40vw] h-[40vw] max-w-[500px] max-h-[500px] bg-[#D4AF37]/10 rounded-full blur-[150px] pointer-events-none opacity-40"></div>
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row-reverse gap-16 lg:gap-24 items-center text-left">
                
                <!-- Collage using placeholders from Drifter interiors -->
                <div class="w-full lg:w-1/2 flex gap-4 md:gap-6 animate-fade-up items-start" style="animation-delay: 200ms; animation-fill-mode: both;">
                    <div class="flex-[1.2]">
                        <div class="relative rounded-[1.5rem] md:rounded-[2.5rem] overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.5)] group aspect-[3/4]">
                            <img src="/elite/interior1.png" alt="Armadillo Interior Main" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-[#D4AF37]/20 rounded-[1.5rem] md:rounded-[2.5rem] pointer-events-none"></div>
                        </div>
                    </div>
                    <div class="flex-1 flex flex-col gap-4 md:gap-6 mt-8 md:mt-16">
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] group aspect-square">
                            <img src="/elite/interior2.png" alt="Armadillo Interior Detail" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-[#D4AF37]/20 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] group aspect-square">
                            <img src="/elite/interior3.png" alt="Armadillo Interior Detail" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-[#D4AF37]/20 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                    </div>
                </div>

                <!-- Text -->
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#D4AF37] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 300ms; animation-fill-mode: both;">Uncompromising Luxury</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-[0.9] mb-10 animate-fade-up" style="animation-delay: 500ms; animation-fill-mode: both;">Adventure-Ready<br/><span class="text-[#D4AF37]">Included.</span></h2>
                    
                    <p class="text-white/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#D4AF37] pl-6 md:pl-10" style="animation-delay: 700ms; animation-fill-mode: both;">
                        The Armadillo boasts a full aluminium frame, ensuring strength and durability for off-road journeys. Spacious interior with modern conveniences enhances every trip. Off-road suspension and water tanks increase travel independence.
                    </p>
                    
                    <p class="text-white/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay: 900ms; animation-fill-mode: both;">
                        The seamless blend of rugged capability and elegant design sets the Armadillo apart. With thoughtful storage solutions and advanced technology onboard, it redefines outdoor comfort. Adventure seekers will appreciate the caravan’s resilience and refined interior aesthetics alike.
                    </p>

                    <div class="flex flex-wrap gap-3 mt-10 animate-fade-up" style="animation-delay: 1000ms; animation-fill-mode: both;">
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/50 hover:text-[#D4AF37] transition-all duration-300">188L 3-Way Fridge</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/50 hover:text-[#D4AF37] transition-all duration-300">Rear Club Lounge</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/50 hover:text-[#D4AF37] transition-all duration-300">Queen Bed</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/50 hover:text-[#D4AF37] transition-all duration-300">Diesel Heater</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 4. INTERIOR STYLING — Mood Boards             -->
        <!-- ══════════════════════════════════════════════ -->
        <MoodBoardSection />

        <!-- ══════════════════════════════════════════════ -->
        <!-- 5. CTA SECTION                                -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="contact" class="relative z-10 w-full py-24 md:py-32 bg-black text-white overflow-hidden">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-[#D4AF37]/5 rounded-full blur-[150px] pointer-events-none opacity-40"></div>
            <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#D4AF37]/40 to-transparent opacity-30"></div>
            <div class="max-w-3xl mx-auto px-6 md:px-14 text-center relative z-10">
                <span class="text-[#D4AF37] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block">Ultimate Expedition</span>
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-[0.9] mb-8">Elevate Your<br/><span class="text-[#D4AF37]">Adventures.</span></h2>
                <p class="text-white/50 font-medium md:text-lg leading-relaxed mb-12 max-w-xl mx-auto">Take the first step toward unmatched luxury explorer living. Contact us to configure your Armadillo.</p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
                    <a href="/#contact" class="px-12 py-5 bg-gradient-to-r from-[#D4AF37] to-[#B8941E] text-black font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:from-white hover:to-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(212,175,55,0.3)]">Inquire Now</a>
                    <a href="#" class="px-12 py-5 border border-[#D4AF37]/30 text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full flex items-center gap-3">
                        <svg class="w-4 h-4 text-[#D4AF37]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                        Download PDF
                    </a>
                </div>
                <a href="/elite" class="inline-block mt-10 text-white/30 text-[10px] font-bold uppercase tracking-[0.3em] hover:text-[#D4AF37] transition-colors duration-300">← Back to Elite Lineup</a>
            </div>
        </section>
    </main>
</Layout>

<style>
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up { animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .tier-tab { background: white; border-color: rgba(0,0,0,0.08); color: rgba(0,0,0,0.5); }
    .tier-tab:hover { border-color: #D4AF37; color: #D4AF37; }
    .tier-tab.active-tier { background: #D4AF37; border-color: #D4AF37; color: black; font-weight: 900; box-shadow: 0 8px 30px rgba(212,175,55,0.3); }
</style>
