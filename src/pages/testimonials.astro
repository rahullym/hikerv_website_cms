---
import { loadPageSeo } from "../lib/cms/sitePages";
const pageSeo = await loadPageSeo('testimonials');
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";

const reviews = [
  {
    name: "L Macwan",
    date: "July 2, 2025",
    rating: 5,
    text: "Great and affordable caravans and best people to deal with for a great life long caravan experience.",
    source: "Google Reviews",
    initials: "LM"
  },
  {
    name: "Devendra Khatik",
    date: "March 15, 2025",
    rating: 5,
    text: "Hike RV exceeded expectations! Attention to detail, innovative designs, and quality commitment make them the best in the industry.",
    source: "Google Reviews",
    initials: "DK"
  },
  {
    name: "Steve Watt",
    date: "June 11, 2024",
    rating: 5,
    text: "We are Very Happy customers of our Hike Wild Drifter that we picked up in December 2023. Every request was delivered, the changes were exactly what we asked for (and there were plenty). Niyas and his Team have been Excellent to deal with as we are NSW based; nothing has been a problem. Thank you, Hike RV.",
    source: "Google Reviews",
    initials: "SW"
  },
  {
    name: "Rachelle Baskett",
    date: "August 4, 2023",
    rating: 5,
    text: "We absolutely love our beautiful van, everything is finished to such a high standard and was exactly what we were looking for. We had a couple of very minor things missed during our build as they weren’t standard but we were able to take the van back and have this rectified at our convenience. The team was so easy to deal with right from the initial enquiry through to pick up including the millions of questions I had throughout the build. 100% recommend the team at Hike RV.",
    source: "Google Reviews",
    initials: "RB"
  },
  {
    name: "Fred Cadile",
    date: "August 28, 2023",
    rating: 5,
    text: "Very happy with our van, more options than other companies out there and great communication throughout the entire process.",
    source: "Google Reviews",
    initials: "FC"
  },
  {
    name: "Jabir",
    date: "September 1, 2024",
    rating: 5,
    text: "Simply the best caravan experience we've had. Quality and service are unmatched.",
    source: "Google Reviews",
    initials: "J"
  }
];
---

<Layout
	title={pageSeo.title}
	description={pageSeo.description}
	keywords={pageSeo.keywords}
	ogImage={pageSeo.ogImage}
	canonical={pageSeo.canonical}
>
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">
        
        <!-- Luxury Gradient Backdrop -->
        <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[90vw] h-[90vw] max-w-[1000px] bg-[#E50000]/3 rounded-full blur-[120px] opacity-40 z-0 pointer-events-none"></div>

        <!-- 1. HERO SECTION -->
        <section class="relative z-10 w-full bg-black pt-40 pb-24 md:pt-52 md:pb-36 px-6 md:px-14 flex flex-col items-center justify-center text-center overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-black via-[#0a0a0a] to-black z-0"></div>
            
            <!-- Animated background pattern -->
            <div class="absolute inset-0 opacity-10 bg-[url('/roverbg.png')] bg-repeat bg-[length:200px_200px] z-0 animate-pulse-slow"></div>

            <div class="relative z-10 flex items-center justify-center gap-4 sm:gap-6 mb-8 animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">
                <div class="w-8 sm:w-16 h-px bg-[#E50000]/40"></div>
                <span class="text-[#E50000] text-[10px] sm:text-xs font-black uppercase tracking-[0.5em] text-center">
                    Community Reviews
                </span>
                <div class="w-8 sm:w-16 h-px bg-[#E50000]/40"></div>
            </div>

            <h1 class="relative z-10 text-white text-5xl md:text-7xl lg:text-[8rem] font-black uppercase tracking-tighter leading-[0.85] mb-8 animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                Trusted by<br/>
                <span class="text-[#E50000]">Explorers.</span>
            </h1>

            <p class="relative z-10 text-white/50 font-medium text-sm md:text-lg tracking-wide max-w-2xl animate-fade-up mb-12" style="animation-delay: 600ms; animation-fill-mode: both;">
                Real experiences from real owners. Join thousands of satisfied travelers who chose Hike RV for their lifelong journey.
            </p>

            <!-- Google Rating Highlight -->
            <div class="relative z-10 flex flex-col items-center animate-fade-up" style="animation-delay: 800ms; animation-fill-mode: both;">
                <div class="flex items-center gap-1 mb-3">
                    {[1,2,3,4,5].map(() => (
                        <svg class="w-5 h-5 text-[#fabb05]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    ))}
                </div>
                <span class="text-white/60 text-[10px] font-bold uppercase tracking-widest">5.0 Star Average on Google</span>
            </div>
        </section>

        <!-- 2. TESTIMONIALS GRID -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-white">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                
                <div class="columns-1 md:columns-2 lg:columns-3 gap-8 space-y-8">
                    {reviews.map((item, i) => (
                        <div class="break-inside-avoid group relative p-10 bg-[#fdfdfd] border border-black/5 rounded-[2.5rem] shadow-[0_10px_40px_rgba(0,0,0,0.02)] hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 animate-fade-up" style={`animation-delay: ${200 + (i * 100)}ms; animation-fill-mode: both;`}>
                            
                            <!-- Large Quote Icon -->
                            <div class="absolute top-8 right-10 opacity-[0.03] group-hover:opacity-[0.08] transition-opacity duration-700">
                                <svg class="w-20 h-20 text-black shrink-0" fill="currentColor" viewBox="0 0 32 32"><path d="M10 8v8h6l-2.5 6h-4l2.5-6h-3.5v-8h1.5zm12 0v8h6l-2.5 6h-4l2.5-6h-3.5v-8h1.5z"/></svg>
                            </div>

                            <!-- Rating Stars -->
                            <div class="flex items-center gap-1 mb-8">
                                {[1,2,3,4,5].map(() => (
                                    <svg class="w-3.5 h-3.5 text-[#E50000]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                ))}
                            </div>

                            <!-- Review Text -->
                            <blockquote class="text-black/70 font-medium text-lg md:text-xl leading-relaxed mb-10 italic">
                                "{item.text}"
                            </blockquote>

                            <!-- Divider -->
                            <div class="w-12 h-px bg-[#E50000]/20 mb-8 group-hover:w-full transition-all duration-700"></div>

                            <!-- Author Info -->
                            <div class="flex items-center gap-5">
                                <div class="w-14 h-14 rounded-full bg-black text-white flex items-center justify-center font-black text-sm uppercase tracking-tighter shrink-0 border-4 border-white shadow-xl">
                                    {item.initials}
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-black font-black uppercase tracking-wider text-sm">{item.name}</span>
                                    <span class="text-black/30 text-[10px] font-bold uppercase tracking-widest">{item.date} • {item.source}</span>
                                </div>
                            </div>

                        </div>
                    ))}
                </div>

                <!-- Bottom CTA -->
                <div class="mt-32 pt-20 border-t border-black/5 flex flex-col items-center">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] mb-8">Ready to start your story?</span>
                    <div class="flex flex-col sm:flex-row gap-6">
                         <a href="/contact" class="px-10 py-5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] rounded-full hover:bg-[#E50000] transition-colors duration-500 shadow-xl">Get a Quote</a>
                         <a href="/videos" class="px-10 py-5 border border-black/10 text-black font-black uppercase tracking-[0.2em] text-[10px] rounded-full hover:bg-black hover:text-white transition-all duration-500">Watch Owner Videos</a>
                    </div>
                </div>

            </div>
        </section>

    </main>
</Layout>

<style>
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes pulseSlow {
        0%, 100% { opacity: 0.05; }
        50% { opacity: 0.15; }
    }
    .animate-pulse-slow {
        animation: pulseSlow 8s ease-in-out infinite;
    }
</style>
