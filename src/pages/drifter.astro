---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { Image } from "astro:assets";
import drifterSeries from "../assets/drifter-series.png";
---

<Layout title="Drifter Series | Hike RV Caravans" description="Perfect for couples seeking freedom and flexibility, the Drifter Series combines compact efficiency with luxurious comfort.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO SECTION                               -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="drifter-hero" class="relative z-10 w-full min-h-[100vh] flex flex-col items-center justify-center text-center overflow-hidden">
            <!-- Background Image -->
            <div class="absolute inset-0 z-0">
                <img src="/drifterbg.png" alt="Drifter Series Hero" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black"></div>
            </div>

            <!-- Hero Content -->
            <div class="relative z-10 flex flex-col items-center px-6 md:px-14 max-w-5xl mx-auto">
                
                <div class="flex items-center justify-center gap-4 sm:gap-6 mb-8 animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">
                    <div class="w-8 sm:w-16 h-px bg-white/30"></div>
                    <span class="text-white/80 text-[10px] sm:text-xs font-black uppercase tracking-[0.5em] text-center">
                        Couple's Escape Range
                    </span>
                    <div class="w-8 sm:w-16 h-px bg-white/30"></div>
                </div>

                <h1 class="text-white text-5xl md:text-7xl lg:text-[8rem] font-black uppercase tracking-tighter leading-[0.85] mb-8 animate-fade-up drop-shadow-2xl" style="animation-delay: 400ms; animation-fill-mode: both;">
                    Drifter <br/>
                    <span class="text-[#E50000]">Series.</span>
                </h1>

                <p class="text-white/70 font-medium text-sm md:text-lg tracking-wide max-w-3xl mb-12 leading-relaxed animate-fade-up" style="animation-delay: 600ms; animation-fill-mode: both;">
                    Perfect for couples seeking freedom and flexibility, the Drifter Series combines compact efficiency with luxurious comfort. These thoughtfully designed caravans offer everything needed for two people to travel in style.
                </p>

                <div class="flex flex-col sm:flex-row items-center gap-5 animate-fade-up" style="animation-delay: 800ms; animation-fill-mode: both;">
                    <a href="#contact" class="px-10 py-4 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)] hover:shadow-[0_10px_40px_rgba(255,255,255,0.2)]">
                        Get a Quote
                    </a>
                    <a href="#models" class="px-10 py-4 border border-white/30 text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full backdrop-blur-sm">
                        Explore Models
                    </a>
                </div>
            </div>

            <!-- Scroll Indicator -->
            <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 animate-fade-up" style="animation-delay: 1200ms; animation-fill-mode: both;">
                <span class="text-white/40 text-[9px] uppercase tracking-[0.3em] font-bold">Scroll</span>
                <div class="w-px h-10 bg-gradient-to-b from-white/40 to-transparent animate-pulse"></div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. DESCRIPTION + KEY FEATURES                 -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row gap-20">
                
                <!-- Left: Description -->
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">Designed for Two</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                        Chase The<br/>Horizon.
                    </h2>
                    
                    <p class="text-black/60 font-medium md:text-xl leading-relaxed mb-12 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay: 600ms; animation-fill-mode: both;">
                        Whether it's a weekend getaway or an extended journey, the Drifter Series lets you chase the horizon without compromise. With its nimble size and comprehensive features, every moment on the road becomes an unforgettable escape.
                    </p>

                    <div class="w-full h-px bg-black/10 mb-10 animate-fade-up" style="animation-delay: 800ms; animation-fill-mode: both;"></div>

                    <!-- Caravan Image -->
                    <div class="w-full rounded-3xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.08)] animate-fade-up" style="animation-delay: 900ms; animation-fill-mode: both;">
                        <Image src={drifterSeries} alt="Drifter Series Caravan" class="w-full h-auto object-cover hover:scale-105 transition-transform duration-700" />
                    </div>
                </div>

                <!-- Right: Key Features -->
                <div class="w-full lg:w-1/2 flex flex-col justify-center animate-fade-up" style="animation-delay: 600ms; animation-fill-mode: both;">
                    <h3 class="font-black uppercase tracking-widest text-[#E50000] mb-10 md:text-lg">Key Features</h3>
                    
                    <div class="flex flex-col gap-5">
                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#E50000]/10 flex items-center justify-center shrink-0 group-hover:bg-[#E50000] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#E50000] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Premium Queen Bed</span>
                                <span class="text-black/50 text-sm">Luxurious queen bed setup for ultimate comfort</span>
                            </div>
                        </div>

                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#E50000]/10 flex items-center justify-center shrink-0 group-hover:bg-[#E50000] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#E50000] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.87c1.355 0 2.697.055 4.024.165C17.155 8.51 18 9.473 18 10.608v2.513m-3-4.87v-1.5m-6 1.5v-1.5m12 9.75l-1.5.75a3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0 3.354 3.354 0 00-3 0 3.354 3.354 0 01-3 0L3 16.5m18-4.5H3"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Gourmet Kitchen</span>
                                <span class="text-black/50 text-sm">Compact gourmet kitchen designed for two</span>
                            </div>
                        </div>

                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#E50000]/10 flex items-center justify-center shrink-0 group-hover:bg-[#E50000] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#E50000] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Spacious Ensuite</span>
                                <span class="text-black/50 text-sm">Full ensuite bathroom with premium fittings</span>
                            </div>
                        </div>

                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#E50000]/10 flex items-center justify-center shrink-0 group-hover:bg-[#E50000] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#E50000] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Smart Storage</span>
                                <span class="text-black/50 text-sm">Cleverly designed storage throughout</span>
                            </div>
                        </div>

                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#E50000]/10 flex items-center justify-center shrink-0 group-hover:bg-[#E50000] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#E50000] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Easy Towing</span>
                                <span class="text-black/50 text-sm">Nimble profile for effortless towing</span>
                            </div>
                        </div>

                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#E50000]/10 flex items-center justify-center shrink-0 group-hover:bg-[#E50000] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#E50000] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Indoor / Outdoor Living</span>
                                <span class="text-black/50 text-sm">Seamless indoor-outdoor living spaces</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. MODELS SECTION                             -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="models" class="relative z-10 w-full py-24 md:py-40 bg-black text-white">
            <!-- Background Accent -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vw] max-w-[700px] max-h-[700px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>

            <div class="max-w-[1600px] mx-auto px-6 md:px-14 relative z-10">
                
                <div class="text-center mb-20">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.5em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">Drifter Collection</span>
                    <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                        Find Your<br/><span class="text-[#E50000]">Drifter.</span>
                    </h2>
                </div>

                <!-- Model Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12 pb-20">
                    
                    <!-- Wild Drifter -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-white/10 hover:border-[#E50000]/40 transition-all duration-700 hover:-translate-y-2 bg-white/5 backdrop-blur-sm">
                        <div class="w-full h-56 md:h-64 bg-[#111] flex items-center justify-center overflow-hidden relative">
                            <img src="/Wild Drifter/Images/External/Copy of IMG_4170.JPG" alt="Wild Drifter" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <span class="text-[#E50000] text-[9px] font-black uppercase tracking-[0.3em] mb-2">Adventure</span>
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-3 text-white">Wild Drifter</h3>
                            <p class="text-white/50 text-sm font-medium mb-8 leading-relaxed">Couple's Escape Range.</p>
                            <a href="/wild-drifter" class="w-fit px-8 py-3.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_8px_30px_rgba(229,0,0,0.25)]">
                                Explore Range
                            </a>
                        </div>
                    </div>

                    <!-- Tanzanite -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-white/10 hover:border-[#E50000]/40 transition-all duration-700 hover:-translate-y-2 bg-white/5 backdrop-blur-sm">
                        <div class="w-full h-56 md:h-64 bg-[#111] flex items-center justify-center overflow-hidden relative">
                            <img src="/Tanzanite/Images/External/Copy of IMG-20250402-WA0091.jpg" alt="Tanzanite" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <span class="text-[#E50000]/60 text-[9px] font-black uppercase tracking-[0.3em] mb-2">Premium</span>
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-3 text-white">Tanzanite</h3>
                            <p class="text-white/50 text-sm font-medium mb-8 leading-relaxed">Couple's Escape Range.</p>
                            <a href="/tanzanite-21" class="w-fit px-8 py-3.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_8px_30px_rgba(229,0,0,0.25)]">
                                Know More
                            </a>
                        </div>
                    </div>

                    <!-- Amore -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-white/10 hover:border-[#E50000]/40 transition-all duration-700 hover:-translate-y-2 bg-white/5 backdrop-blur-sm">
                        <div class="w-full h-56 md:h-64 bg-[#111] flex items-center justify-center overflow-hidden relative">
                            <img src="/drifter/amore/amor.png" alt="Amore" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <span class="text-[#E50000]/60 text-[9px] font-black uppercase tracking-[0.3em] mb-2">Romance</span>
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-3 text-white">Amore</h3>
                            <p class="text-white/50 text-sm font-medium mb-8 leading-relaxed">Couple's Escape Range.</p>
                            <a href="/amore-22" class="w-fit px-8 py-3.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_8px_30px_rgba(229,0,0,0.25)]">
                                Know More
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 4. CTA SECTION                                -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="contact" class="relative z-10 w-full py-24 md:py-32 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-3xl mx-auto px-6 md:px-14 text-center">
                <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block">Ready to Escape?</span>
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-8">
                    Your Journey<br/>Starts Here.
                </h2>
                <p class="text-black/60 font-medium md:text-lg leading-relaxed mb-12 max-w-xl mx-auto">
                    Contact our team to discover which Drifter model is the perfect companion for your couple's getaway. Freedom and luxury await.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
                    <a href="/#contact" class="px-12 py-5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-[#E50000] transition-colors duration-500 rounded-full shadow-xl">
                        Get a Quote
                    </a>
                    <a href="/" class="px-12 py-5 border border-black/20 text-black font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-black hover:text-white transition-all duration-500 rounded-full">
                        Back to Home
                    </a>
                </div>
            </div>
        </section>

    </main>
</Layout>

<style>
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>
