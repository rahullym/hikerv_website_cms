---


<Layout title="Wild Drifter | Hike RV Caravans" description="A symphony of elegance on wheels. The Wild Drifter is a masterpiece tailored caravan for couples, where style meets freedom.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO SECTION                               -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="wild-drifter-hero" class="relative z-10 w-full min-h-[100vh] flex flex-col items-center justify-center text-center overflow-hidden">
            <!-- Background Image -->
            <div class="absolute inset-0 z-0">
                <img src="/Wild Drifter/Images/External/Copy of IMG_4170.JPG" alt="Wild Drifter" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-b from-black/90 via-black/70 to-black"></div>
            </div>

            <!-- Hero Content -->
            <div class="relative z-10 flex flex-col items-center px-6 md:px-14 max-w-5xl mx-auto">
                
                <div class="flex items-center justify-center gap-4 sm:gap-6 mb-6 animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">
                    <div class="w-8 sm:w-16 h-px bg-white/30"></div>
                    <span class="text-white/80 text-[10px] sm:text-xs font-black uppercase tracking-[0.5em] text-center">
                        Drifter Series
                    </span>
                    <div class="w-8 sm:w-16 h-px bg-white/30"></div>
                </div>

                <h1 class="text-white text-5xl md:text-7xl lg:text-[8rem] font-black uppercase tracking-tighter leading-[0.85] mb-4 animate-fade-up drop-shadow-2xl" style="animation-delay: 400ms; animation-fill-mode: both;">
                    Wild<br/>
                    <span class="text-[#E50000]">Drifter.</span>
                </h1>

                <p class="text-white/50 font-medium text-xs md:text-sm uppercase tracking-[0.3em] mb-8 animate-fade-up" style="animation-delay: 500ms; animation-fill-mode: both;">A Symphony of Elegance on Wheels</p>

                <p class="text-white/70 font-medium text-sm md:text-lg tracking-wide max-w-3xl mb-12 leading-relaxed animate-fade-up" style="animation-delay: 600ms; animation-fill-mode: both;">
                    Enter a realm where elegance finds its home on wheels, and adventure is an art form. The Wild Drifter, a masterpiece tailored caravan for couples, beckons you to embark on an odyssey where style meets freedom.
                </p>

                <div class="flex flex-col sm:flex-row items-center gap-5 animate-fade-up" style="animation-delay: 800ms; animation-fill-mode: both;">
                    <a href="#contact" class="px-10 py-4 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)] hover:shadow-[0_10px_40px_rgba(255,255,255,0.2)]">
                        Get a Quote!
                    </a>
                    <a href="/brochures/GTH WILD DRIFTER (4 Pages).pdf" target="_blank" download class="px-10 py-4 border border-white/30 text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full backdrop-blur-sm flex items-center gap-3">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                        Download Brochure
                    </a>
                </div>
            </div>

            <!-- Scroll Indicator -->
            <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 animate-fade-up" style="animation-delay: 1200ms; animation-fill-mode: both;">
                <span class="text-white/40 text-[9px] uppercase tracking-[0.3em] font-bold">Scroll</span>
                <div class="w-px h-10 bg-gradient-to-b from-white/40 to-transparent animate-pulse"></div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. MODELS / VARIANTS SECTION                  -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="variants" class="relative z-10 w-full py-24 md:py-36 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                
                <div class="text-center mb-20">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.5em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">Wild Drifter Range</span>
                    <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                        Choose Your<br/><span class="text-[#E50000]">Configuration.</span>
                    </h2>
                </div>

                <!-- Variant Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
                    
                    <!-- Wild Drifter 19.6 -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-[#f4f4f4] flex items-center justify-center overflow-hidden relative">
                            <img src="/Wild Drifter/Images/External/Copy of IMG_4171.JPG" alt="Wild Drifter 19.6" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                            <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-3 text-black">Wild Drifter <span class="text-[#E50000]">19.6</span></h3>
                            <p class="text-black/50 text-sm font-medium mb-8 leading-relaxed">Your grand family fiesta.</p>
                            <a href="/wild-drifter-196" class="w-fit px-8 py-3.5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-[#E50000] transition-all duration-500 rounded-full shadow-md">
                                Know More
                            </a>
                        </div>
                    </div>

                    <!-- Wild Drifter 20.6 -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-[#f4f4f4] flex items-center justify-center overflow-hidden relative">
                            <img src="/Wild Drifter/Images/External/Copy of IMG-20250402-WA0082.jpg" alt="Wild Drifter 20.6" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                            <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-3 text-black">Wild Drifter <span class="text-[#E50000]">20.6</span></h3>
                            <p class="text-black/50 text-sm font-medium mb-8 leading-relaxed">Your grand family fiesta.</p>
                            <a href="/wild-drifter-206" class="w-fit px-8 py-3.5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-[#E50000] transition-all duration-500 rounded-full shadow-md">
                                Know More
                            </a>
                        </div>
                    </div>

                    <!-- Wild Drifter CD -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-black flex items-center justify-center overflow-hidden relative">
                             <div class="absolute inset-0 opacity-20 bg-[url('/roverbg.png')] bg-cover bg-center"></div>
                             <div class="relative z-10 flex flex-col items-center gap-3">
                                <span class="text-white/20 font-black italic text-4xl tracking-tighter uppercase font-black uppercase">CD</span>
                                <span class="text-white/40 font-black uppercase tracking-[0.3em] text-[8px] border border-white/10 px-4 py-1.5 rounded-full">Coming Soon</span>
                             </div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">Wild Drifter <span class="text-[#E50000]">CD</span></h3>
                            <p class="text-black/40 text-sm font-medium mb-8">Redefining couple's comfort with central door access.</p>
                            <div class="w-fit px-8 py-3.5 bg-black/5 text-black/20 font-black uppercase tracking-[0.2em] text-[9px] rounded-full">Coming Soon</div>
                        </div>
                    </div>

                    <!-- Wild Drifter Rear club -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-black flex items-center justify-center overflow-hidden relative">
                             <div class="absolute inset-0 opacity-20 bg-[url('/roverbg.png')] bg-cover bg-center"></div>
                             <div class="relative z-10 flex flex-col items-center gap-3">
                                <span class="text-white/20 font-black italic text-4xl tracking-tighter uppercase font-black uppercase text-xs">Rear Club</span>
                                <span class="text-white/40 font-black uppercase tracking-[0.3em] text-[8px] border border-white/10 px-4 py-1.5 rounded-full">Coming Soon</span>
                             </div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">Wild Drifter <span class="text-[#E50000]">Rear Club</span></h3>
                            <p class="text-black/40 text-sm font-medium mb-8">Ultimate relaxation with a spacious rear club lounge.</p>
                            <div class="w-fit px-8 py-3.5 bg-black/5 text-black/20 font-black uppercase tracking-[0.2em] text-[9px] rounded-full">Coming Soon</div>
                        </div>
                    </div>

                    <!-- Wild Drifter 2.0 -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-black flex items-center justify-center overflow-hidden relative">
                             <div class="absolute inset-0 opacity-20 bg-[url('/roverbg.png')] bg-cover bg-center"></div>
                             <div class="relative z-10 flex flex-col items-center gap-3">
                                <span class="text-white/20 font-black italic text-4xl tracking-tighter uppercase font-black uppercase">2.0</span>
                                <span class="text-white/40 font-black uppercase tracking-[0.3em] text-[8px] border border-white/10 px-4 py-1.5 rounded-full">Coming Soon</span>
                             </div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">Wild Drifter <span class="text-[#E50000]">2.0</span></h3>
                            <p class="text-black/40 text-sm font-medium mb-8">The next evolution of the Wild Drifter series.</p>
                            <div class="w-fit px-8 py-3.5 bg-black/5 text-black/20 font-black uppercase tracking-[0.2em] text-[10px] rounded-full">Coming Soon</div>
                        </div>
                    </div>

                    <!-- Wild Drifter Recliners -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-black flex items-center justify-center overflow-hidden relative">
                             <div class="absolute inset-0 opacity-20 bg-[url('/roverbg.png')] bg-cover bg-center"></div>
                             <div class="relative z-10 flex flex-col items-center gap-3">
                                <span class="text-white/20 font-black italic text-4xl tracking-tighter uppercase font-black uppercase text-xs">Recliners</span>
                                <span class="text-white/40 font-black uppercase tracking-[0.3em] text-[8px] border border-white/10 px-4 py-1.5 rounded-full">Coming Soon</span>
                             </div>
                            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">Wild Drifter <span class="text-[#E50000]">Recliners</span></h3>
                            <p class="text-black/40 text-sm font-medium mb-8">Cinema-style comfort on the road with luxury recliners.</p>
                            <div class="w-fit px-8 py-3.5 bg-black/5 text-black/20 font-black uppercase tracking-[0.2em] text-[10px] rounded-full">Coming Soon</div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. VISUAL GALLERY — The Wild Experience         -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-white">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                <div class="flex flex-col items-center text-center max-w-2xl mx-auto mb-16 gap-6">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs block">Wild Visuals</span>
                    <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none text-black">The <span class="text-[#E50000]">Gallery.</span></h2>
                    <p class="text-black/50 font-medium md:text-lg">Experience the Wild Drifter in detail. {exteriorImages.length + interiorImages.length + layoutImages.length} snapshots of couple's luxury.</p>
                </div>

                <!-- Tab Navigation -->
                <div class="flex items-center justify-center gap-1 sm:gap-4 mb-20 overflow-x-auto no-scrollbar py-2">
                    <button data-cat="exterior" class="gallery-tab active-gallery-tab px-8 py-3.5 rounded-full font-black uppercase tracking-[0.2em] text-[9px] md:text-[11px] transition-all duration-500 border border-black/5">Exterior <span class="ml-2 text-black/50">({exteriorImages.length})</span></button>
                    <button data-cat="interior" class="gallery-tab px-8 py-3.5 rounded-full font-black uppercase tracking-[0.2em] text-[9px] md:text-[11px] transition-all duration-500 border border-black/5">Interior <span class="ml-2 text-black/50">({interiorImages.length})</span></button>
                    <button data-cat="layout" class="gallery-tab px-8 py-3.5 rounded-full font-black uppercase tracking-[0.2em] text-[9px] md:text-[11px] transition-all duration-500 border border-black/5">Layouts <span class="ml-2 text-black/50">({layoutImages.length})</span></button>
                </div>

                <!-- Gallery Grids -->
                <div class="relative min-h-[800px]">
                    <!-- EXTERIOR GRID -->
                    <div id="gallery-exterior" class="gallery-content visible-gallery grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 transition-all duration-700">
                        {exteriorImages.map((src, i) => (
                            <div class={`relative group overflow-hidden rounded-[2rem] bg-black/5 aspect-square ${i === 0 ? 'lg:col-span-2 lg:row-span-2' : ''}`}>
                                <img src={src} data-src={src} alt={`Wild Drifter External ${i + 1}`} loading="lazy" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
                                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                            </div>
                        ))}
                    </div>

                    <!-- INTERIOR GRID -->
                    <div id="gallery-interior" class="gallery-content hidden-gallery grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 transition-all duration-700 absolute inset-0">
                        {interiorImages.map((src, i) => (
                            <div class={`relative group overflow-hidden rounded-[1.5rem] bg-black/5 aspect-square ${i === 2 ? 'lg:col-span-2 lg:row-span-2' : ''}`}>
                                <img src={src} data-src={src} alt={`Wild Drifter Internal ${i + 1}`} loading="lazy" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
                                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                            </div>
                        ))}
                    </div>

                    <!-- LAYOUT GRID -->
                    <div id="gallery-layout" class="gallery-content hidden-gallery grid grid-cols-1 lg:grid-cols-2 gap-8 transition-all duration-700 absolute inset-0">
                        {layoutImages.map((item, i) => (
                            <div class="relative group overflow-hidden rounded-[2.5rem] bg-black/2 pb-12 border border-black/5 flex flex-col items-center justify-center transition-all duration-500 hover:shadow-[0_20px_50px_rgba(0,0,0,0.05)]">
                                <div class="p-8 md:p-12 w-full">
                                    <img src={item.src} alt={item.title} class="w-full h-auto object-contain transition-transform duration-700 group-hover:scale-105" />
                                </div>
                                <div class="px-8 text-center text-black">
                                    <span class="text-[#E50000] font-black tracking-[0.4em] text-[12px] uppercase">{item.title}</span>
                                    <h4 class="text-3xl font-black mt-2 tracking-tight">{item.desc}</h4>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- Gallery CTA -->
                <div class="mt-24 pt-20 border-t border-black/5 flex flex-col items-center">
                    <p class="text-black/30 text-[10px] font-bold uppercase tracking-[0.3em] mb-10">Unmatched Quality in Every Detail</p>
                    <div class="flex flex-col sm:flex-row gap-6">
                         <a href="/brochures/GTH WILD DRIFTER (4 Pages).pdf" target="_blank" download class="group relative px-10 py-5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] rounded-full overflow-hidden transition-all duration-300">
                             <div class="absolute inset-0 bg-[#E50000] translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
                             <span class="relative z-10 flex items-center gap-3">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                                Save Series PDF
                             </span>
                         </a>
                        <a href="#contact" class="px-10 py-5 border border-black/20 text-black font-black uppercase tracking-[0.2em] text-[10px] rounded-full hover:bg-black hover:text-white transition-all duration-500">Book A Tour</a>
                    </div>
                </div>
            </div>
        </section>

        <script>
            function initGallery() {
                const tabs = document.querySelectorAll('.gallery-tab');
                const contents = document.querySelectorAll('.gallery-content');

                tabs.forEach(tab => {
                    tab.addEventListener('click', () => {
                        const target = tab.getAttribute('data-cat');

                        tabs.forEach(t => t.classList.remove('active-gallery-tab', 'bg-black', 'text-white'));
                        tab.classList.add('active-gallery-tab', 'bg-black', 'text-white');

                        contents.forEach(content => {
                            const id = content.getAttribute('id');
                            if (id === `gallery-${target}`) {
                                content.classList.remove('hidden-gallery', 'opacity-0', 'pointer-events-none', 'absolute', 'translate-y-[30px]');
                                content.classList.add('visible-gallery', 'opacity-100', 'z-10', 'relative', 'translate-y-0');
                            } else {
                                content.classList.add('hidden-gallery', 'opacity-0', 'pointer-events-none', 'absolute', 'translate-y-[30px]');
