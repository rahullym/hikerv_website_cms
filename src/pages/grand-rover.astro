---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import LayoutSection from "../components/LayoutSection.astro";
import MoodBoardSection from "../components/MoodBoardSection.astro";

const layoutImages = [
    { title: "Grand Rover 20.6", desc: "Optimised Family Living", src: "/3D LAYOUTS 2024/3D LAYOUT NEW UPDATED AUG 2025/GRAND ROVER 19.6 2 BUNK.png" },
    { title: "Grand Rover 21.6", desc: "Extended Luxury Space", src: "/3D LAYOUTS 2024/3D LAYOUT NEW UPDATED AUG 2025/GRAND ROVER 21.6 v1.0.png" },
    { title: "Grand Rover Infinity", desc: "The Ultimate 24.6ft Flagship", src: "/3D LAYOUTS 2024/3D LAYOUT NEW UPDATED AUG 2025/GRAND ROVER 24.6 INFINITY.png" }
];

const exteriorImages = [
    "/rover/grandrover/Gallery New/IMG_0759.jpg",
    "/rover/grandrover/Gallery New/IMG_0878.jpg",
    "/rover/grandrover/Gallery New/IMG_0880.jpg",
    "/rover/grandrover/Gallery New/IMG_0948.jpg",
    "/rover/grandrover/Gallery New/IMG_1203.jpg",
    "/rover/grandrover/Gallery New/IMG_0984.jpg",
    "/rover/grandrover/Gallery New/IMG_8154.jpg",
    "/rover/grandrover/Gallery New/IMG_0916.jpg",
    "/rover/grandrover/Gallery New/IMG_0908.jpg"
];

const interiorImages = [
    "/rover/grandrover/interior.png",
    "/rover/grandrover/luxury_interior.png",
    "/rover/grandrover/20.6/interior.png",
    "/rover/grandrover/20.6/interior1.png",
    "/rover/grandrover/20.6/interior2.png",
    "/rover/grandrover/20.6/interior3.png",
    "/rover/grandrover/21.6/interior.png",
    "/rover/grandrover/21.6/interior1.png",
    "/rover/grandrover/21.6/interior2.png",
    "/rover/grandrover/21.6/interior3.png",
    "/rover/grandrover/infinity/interior.png",
    "/rover/grandrover/infinity/interior1.png",
    "/rover/grandrover/infinity/interior2.png",
    "/rover/grandrover/infinity/interior3.png"
];

---


<Layout title="Grand Rover | Hike RV Caravans" description="Step inside Grand Rover — your family's cocoon on wheels. Spacious beds, tailored storage, and luxury amenities for the ultimate family adventure.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO SECTION                               -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="grand-rover-hero" class="relative z-10 w-full min-h-[100vh] flex flex-col items-center justify-center text-center overflow-hidden">
            <!-- Background Image -->
            <div class="absolute inset-0 z-0">
                <img src="/rover/grandrover.png" alt="Grand Rover" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-b from-black/90 via-black/70 to-black"></div>
            </div>

            <!-- Hero Content -->
            <div class="relative z-10 flex flex-col items-center px-6 md:px-14 max-w-5xl mx-auto">
                
                <div class="flex items-center justify-center gap-4 sm:gap-6 mb-6 animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">
                    <div class="w-8 sm:w-16 h-px bg-white/30"></div>
                    <span class="text-white/80 text-[10px] sm:text-xs font-black uppercase tracking-[0.5em] text-center">
                        Rover Series
                    </span>
                    <div class="w-8 sm:w-16 h-px bg-white/30"></div>
                </div>

                <h1 class="text-white text-5xl md:text-7xl lg:text-[8rem] font-black uppercase tracking-tighter leading-[0.85] mb-8 animate-fade-up drop-shadow-2xl" style="animation-delay: 400ms; animation-fill-mode: both;">
                    Grand<br/>
                    <span class="text-[#E50000]">Rover.</span>
                </h1>

                <p class="text-white/70 font-medium text-sm md:text-lg tracking-wide max-w-3xl mb-12 leading-relaxed animate-fade-up" style="animation-delay: 600ms; animation-fill-mode: both;">
                    Step inside Grand Rover, and you'll find a spacious bed that cradles you after a day of exploration. The tailored storage solutions ensure your family's every need is met. It's more than just a caravan; it's your family's cocoon on wheels.
                </p>

                <div class="flex flex-col sm:flex-row items-center gap-5 animate-fade-up" style="animation-delay: 800ms; animation-fill-mode: both;">
                    <a href="#contact" class="px-10 py-4 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)] hover:shadow-[0_10px_40px_rgba(255,255,255,0.2)]">
                        Get a Quote!
                    </a>
                    <a href="/brochures/GRANDROVER.pdf" target="_blank" download class="px-10 py-4 border border-white/30 text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-white hover:text-black transition-all duration-500 rounded-full backdrop-blur-sm flex items-center gap-3">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                        Download Brochure
                    </a>
                </div>
            </div>

            <!-- Scroll Indicator -->
            <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 animate-fade-up" style="animation-delay: 1200ms; animation-fill-mode: both;">
                <span class="text-white/40 text-[9px] uppercase tracking-[0.3em] font-bold">Scroll</span>
                <div class="w-px h-10 bg-gradient-to-b from-white/40 to-transparent animate-pulse"></div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. MODELS / VARIANTS SECTION                  -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="variants" class="relative z-10 w-full py-24 md:py-36 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                
                <div class="text-center mb-20">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.5em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">Grand Rover Range</span>
                    <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                        Choose Your<br/><span class="text-[#E50000]">Configuration.</span>
                    </h2>
                </div>

                <!-- Variant Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">

                    <!-- Grand Rover 19.6ft -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-[#f4f4f4] flex items-center justify-center overflow-hidden relative">
                            <img src="/assets/GRANDROVER 20.6.jpg" alt="Grand Rover 19.6ft" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                            <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">Grand Rover <span class="text-[#E50000]">19.6ft</span></h3>
                            <a href="/grand-rover-196" class="w-fit px-8 py-3.5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-[#E50000] transition-all duration-500 rounded-full shadow-md">
                                Know More
                            </a>
                        </div>
                    </div>

                    <!-- Grand Rover 20.6 -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-[#f4f4f4] flex items-center justify-center overflow-hidden relative">
                            <img src="/rover/grandrover/Grand Rover 20.6.png" alt="Grand Rover 20.6" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                            <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">Grand Rover <span class="text-[#E50000]">20.6ft</span></h3>
                            <a href="/grand-rover-206" class="w-fit px-8 py-3.5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-[#E50000] transition-all duration-500 rounded-full shadow-md">
                                Know More
                            </a>
                        </div>
                    </div>

                    <!-- Grand Rover 21.6 -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-[#f4f4f4] flex items-center justify-center overflow-hidden relative">
                            <img src="/rover/grandrover/Grand Rover 21.6.png" alt="Grand Rover 21.6" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                            <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">Grand Rover <span class="text-[#E50000]">21.6ft</span></h3>
                            <a href="/grand-rover-216" class="w-fit px-8 py-3.5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-[#E50000] transition-all duration-500 rounded-full shadow-md">
                                Know More
                            </a>
                        </div>
                    </div>

                    <!-- Grand Rover Infinity 24.6 -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-[#E50000]/10 hover:border-[#E50000]/30 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-52 md:h-60 bg-[#f4f4f4] flex items-center justify-center overflow-hidden relative">
                            <img src="/rover/grandrover/Grand Rover Infinity.png" alt="Grand Rover Infinity 24.6" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                            <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-6 text-black">Grand Rover Infinity <span class="text-[#E50000]">24.6ft</span></h3>
                             <a href="/grand-rover-infinity" class="w-fit px-8 py-3.5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-[#E50000] transition-all duration-500 rounded-full shadow-md">
                                Know More
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. LUXURY AWAITS — Interior Feature           -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-black text-white overflow-hidden">
            <!-- Subtle glow -->
            <div class="absolute top-1/2 left-0 -translate-y-1/2 w-[40vw] h-[40vw] max-w-[500px] max-h-[500px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>

            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row gap-16 lg:gap-20 items-center">

                <!-- Left: Image -->
                <div class="w-full lg:w-1/2 animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">
                    <div class="relative rounded-[2rem] overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.4)] group">
                        <img src="/rover/grandrover/interior.png" alt="Grand Rover Luxury Interior" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700" />
                        <!-- Subtle overlay frame -->
                        <div class="absolute inset-0 rounded-[2rem] border border-white/10 pointer-events-none"></div>
                    </div>
                </div>

                <!-- Right: Text -->
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 300ms; animation-fill-mode: both;">Interior</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay: 500ms; animation-fill-mode: both;">
                        Luxury<br/><span class="text-[#E50000]">Awaits.</span>
                    </h2>
                    
                    <p class="text-white/60 font-medium md:text-xl leading-relaxed mb-10 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay: 700ms; animation-fill-mode: both;">
                        Grand Rover offers the finest amenities, from a separate shower and toilet area to optional 2/3 bunk beds. You'll find a large refrigerator and a spacious kitchen area with convenient drawers and abundant storage options. It's a home on wheels, designed to make every family member feel pampered.
                    </p>

                    <!-- Feature chips -->
                    <div class="flex flex-wrap gap-3 animate-fade-up" style="animation-delay: 900ms; animation-fill-mode: both;">
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Separate Shower</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">2/3 Bunk Beds</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Large Fridge</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Spacious Kitchen</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Abundant Storage</span>
                    </div>
                </div>

            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 4. EMPOWER YOUR JOURNEY — Power Feature       -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black overflow-hidden">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row-reverse gap-16 lg:gap-20 items-center">

                <!-- Right: Image -->
                <div class="w-full lg:w-1/2 animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">
                    <div class="relative rounded-[2rem] overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.08)] group">
                        <img src="/rover/grandrover/power.png" alt="Grand Rover Power System" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700" />
                        <div class="absolute inset-0 rounded-[2rem] border border-black/5 pointer-events-none"></div>
                    </div>
                </div>

                <!-- Left: Text -->
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 300ms; animation-fill-mode: both;">Off Grid Ready</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay: 500ms; animation-fill-mode: both;">
                        Empower<br/>Your <span class="text-[#E50000]">Journey.</span>
                    </h2>
                    
                    <p class="text-black/60 font-medium md:text-xl leading-relaxed mb-10 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay: 700ms; animation-fill-mode: both;">
                        Grand Rover isn't just about luxury; it's also about empowerment. Powered by a BM PRO battery management system, you have control over your power needs. Customize your battery and solar options and ensure you're always prepared for your adventures.
                    </p>

                    <!-- Power specs -->
                    <div class="grid grid-cols-2 gap-4 animate-fade-up" style="animation-delay: 900ms; animation-fill-mode: both;">
                        <div class="flex flex-col gap-2 bg-white p-6 rounded-2xl border border-black/5 shadow-[0_6px_20px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <svg class="w-7 h-7 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
                            <span class="text-xs font-black uppercase tracking-wider text-black/70">BM PRO System</span>
                        </div>
                        <div class="flex flex-col gap-2 bg-white p-6 rounded-2xl border border-black/5 shadow-[0_6px_20px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <svg class="w-7 h-7 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>
                            <span class="text-xs font-black uppercase tracking-wider text-black/70">Solar Ready</span>
                        </div>
                        <div class="flex flex-col gap-2 bg-white p-6 rounded-2xl border border-black/5 shadow-[0_6px_20px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <svg class="w-7 h-7 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 10.5h.375c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125H21M4.5 10.5H18V15H4.5v-4.5zM3.75 18h15A2.25 2.25 0 0021 15.75v-6a2.25 2.25 0 00-2.25-2.25h-15A2.25 2.25 0 001.5 9.75v6A2.25 2.25 0 003.75 18z"/></svg>
                            <span class="text-xs font-black uppercase tracking-wider text-black/70">Custom Battery</span>
                        </div>
                        <div class="flex flex-col gap-2 bg-white p-6 rounded-2xl border border-black/5 shadow-[0_6px_20px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#E50000]/30 transition-all duration-500">
                            <svg class="w-7 h-7 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75"/></svg>
                            <span class="text-xs font-black uppercase tracking-wider text-black/70">Full Control</span>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 5. THE GRAND ROVER GALLERY — Visual Experience -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-white">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                <div class="flex flex-col items-center text-center max-w-2xl mx-auto mb-16 gap-6">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs block">Grand Visuals</span>
                    <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none text-black">The <span class="text-[#E50000]">Gallery.</span></h2>
                    <p class="text-black/50 font-medium md:text-lg">Experience the Grand Rover in detail. {exteriorImages.length + interiorImages.length + layoutImages.length} snapshots of family luxury.</p>
                </div>

                <!-- Tab Navigation -->
                <div class="flex items-center justify-center gap-1 sm:gap-4 mb-20 overflow-x-auto no-scrollbar py-2">
                    <button data-cat="exterior" class="gallery-tab active-gallery-tab px-8 py-3.5 rounded-full font-black uppercase tracking-[0.2em] text-[9px] md:text-[11px] transition-all duration-500 border border-black/5">Exterior <span class="ml-2 text-black/50">({exteriorImages.length})</span></button>
                    <button data-cat="interior" class="gallery-tab px-8 py-3.5 rounded-full font-black uppercase tracking-[0.2em] text-[9px] md:text-[11px] transition-all duration-500 border border-black/5">Interior <span class="ml-2 text-black/50">({interiorImages.length})</span></button>
                </div>

                <!-- Gallery Grids -->
                <div class="relative min-h-[800px]">
                    <!-- EXTERIOR GRID -->
                    <div id="gallery-exterior" class="gallery-content visible-gallery grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 transition-all duration-700">
                        {exteriorImages.map((src, i) => (
                            <div class={`relative group overflow-hidden rounded-[2rem] bg-black/5 aspect-square ${i === 0 ? 'lg:col-span-2 lg:row-span-2' : ''}`}>
                                <img src={src} data-src={src} alt={`Grand Rover External ${i + 1}`} loading="lazy" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
                                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                            </div>
                        ))}
                    </div>

                    <!-- INTERIOR GRID -->
                    <div id="gallery-interior" class="gallery-content hidden-gallery grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 transition-all duration-700 absolute inset-0">
                        {interiorImages.map((src, i) => (
