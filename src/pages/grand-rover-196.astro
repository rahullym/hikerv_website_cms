---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import MoodBoardSection from "../components/MoodBoardSection.astro";
import LayoutSection from "../components/LayoutSection.astro";

const floorplans = [
    { title: "Grand Rover 19.6 · 2 Bunk", desc: "Family-Ready Floorplan", src: "/3D LAYOUTS 2024/3D LAYOUT NEW UPDATED AUG 2025/GRAND ROVER 19.6 2 BUNK.png" },
    { title: "Grand Rover 19.6 · Ultra Off-Grid", desc: "Self-Sufficient Touring", src: "/3D LAYOUTS 2024/3D LAYOUT NEW UPDATED AUG 2025/GTH ULTRA OFF GRID 19.6.png" }
];
---

<Layout title="Grand Rover 19.6ft | Hike RV Caravans" description="The Grand Rover 19.6ft — a compact family caravan with a clever 2-bunk layout, full ensuite, and proven Grand Rover engineering.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO — Split Editorial Layout              -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full min-h-[100vh] flex flex-col lg:flex-row overflow-hidden bg-black">
            <!-- Left: Content -->
            <div class="relative z-10 w-full lg:w-[45%] flex flex-col justify-center px-8 md:px-14 lg:px-20 py-32 lg:py-20">
                <div class="absolute top-0 right-0 hidden lg:block w-px h-full bg-gradient-to-b from-transparent via-white/10 to-transparent"></div>
                <a href="/grand-rover" class="flex items-center gap-2 text-white/40 text-[10px] font-bold uppercase tracking-[0.3em] mb-10 hover:text-[#E50000] transition-colors duration-300 w-fit animate-fade-up" style="animation-delay:100ms;animation-fill-mode:both;">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
                    Grand Rover Series
                </a>
                <div class="flex items-center gap-4 mb-6 animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="w-12 h-1 bg-[#E50000] rounded-full"></div>
                    <span class="text-[#E50000] text-[10px] font-black uppercase tracking-[0.4em]">Model 19.6ft · 2 Bunk</span>
                </div>
                <h1 class="text-white text-[3.5rem] md:text-[5rem] lg:text-[6rem] font-black uppercase tracking-tighter leading-[0.85] mb-3 animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Family.</h1>
                <h2 class="text-[2rem] md:text-[2.5rem] lg:text-[3rem] font-black uppercase tracking-tighter leading-[0.9] mb-8 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-white/80 to-white/40">Grand Rover</span> <span class="text-[#E50000]">19.6ft</span>
                </h2>
                <p class="text-white/50 font-medium text-sm md:text-base leading-relaxed max-w-md mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">
                    The compact Grand Rover, sized for easier towing and tighter sites — without losing the bunk beds, ensuite, or kitchen the family relies on.
                </p>
                <div class="flex flex-col sm:flex-row items-start gap-4 animate-fade-up" style="animation-delay:600ms;animation-fill-mode:both;">
                    <a href="#contact" class="px-8 py-3.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)]">Get a Quote</a>
                    <a href="/brochures/gthgrandrover.pdf" target="_blank" download class="px-8 py-3.5 border border-white/20 text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full flex items-center gap-2">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                        Brochure
                    </a>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-5 mt-14 pt-8 border-t border-white/10 animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">1500W</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Inverter</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 12v3.75h18V12zM4.5 15.75v3M19.5 15.75v3M6.75 9.75V8.25A2.25 2.25 0 019 6h6a2.25 2.25 0 012.25 2.25v1.5"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">Straight</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Lounge</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 3h13.5a1.5 1.5 0 011.5 1.5v15a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-15a1.5 1.5 0 011.5-1.5zM3.75 11.25h16.5M7.5 7.5v-.75M7.5 15v-.75"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">188L Dometic</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Fridge</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75A2.25 2.25 0 016 4.5h12a2.25 2.25 0 012.25 2.25v10.5A2.25 2.25 0 0118 19.5H6a2.25 2.25 0 01-2.25-2.25V6.75zM3.75 10.5h16.5M7.5 4.5v15M16.5 4.5v15"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">Silver Shine</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">6" Chassis</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v3M12 18v3M5.636 5.636l2.121 2.121M16.243 16.243l2.121 2.121M3 12h3M18 12h3M5.636 18.364l2.121-2.121M16.243 7.757l2.121-2.121"/><circle cx="12" cy="12" r="4" stroke-width="1.8"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">Roller Rocker</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Suspension</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="4" y="3" width="16" height="18" rx="1.5"/><circle cx="12" cy="13" r="4"/><circle cx="8" cy="6.5" r=".5" fill="currentColor"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">3kg Front-Load</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Washer</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 10.5h.375c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125H21M4.5 10.5H18V15H4.5v-4.5zM3.75 18h15A2.25 2.25 0 0021 15.75v-6a2.25 2.25 0 00-2.25-2.25h-15A2.25 2.25 0 001.5 9.75v6A2.25 2.25 0 003.75 18z"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">2 × 150Ah</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Lithium</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-7 h-7 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="14" rx="1"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 8.5h18M3 13h18M9 4v14M15 4v14M9 21h6"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">2 × 200W</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Solar Panel</span>
                    </div>
                </div>
            </div>
            <!-- Right: Image -->
            <div class="relative w-full lg:w-[55%] min-h-[50vh] lg:min-h-full">
                <img src="/assets/GRANDROVER 19.6.jpg" alt="Grand Rover 19.6" class="w-full h-full object-cover object-center" />
                <div class="absolute inset-0 bg-[linear-gradient(to_right,_rgb(0_0_0)_0%,_rgb(0_0_0/0.1)_30%,_transparent_60%)] lg:block hidden"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent lg:hidden"></div>
                <div class="absolute bottom-8 right-8 hidden lg:flex flex-col items-end gap-2 animate-fade-up" style="animation-delay:1000ms;animation-fill-mode:both;">
                    <span class="text-white/20 text-[9px] font-bold uppercase tracking-[0.3em]">Scroll to explore</span>
                    <div class="w-px h-12 bg-gradient-to-b from-white/30 to-transparent animate-pulse"></div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. COMPACT, COMPLETE                          -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row gap-16 lg:gap-20 items-start">
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">Overview</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">Compact,<br/><span class="text-[#E50000]">Complete.</span></h2>
                    <p class="text-black/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay:600ms;animation-fill-mode:both;">
                        The Grand Rover 19.6 is the easy-towing entry to the Grand Rover range — same chassis DNA, same kitchen and ensuite quality, packaged into a footprint that fits more driveways and more campsites.
                    </p>
                    <p class="text-black/50 font-medium md:text-base leading-relaxed mb-8 animate-fade-up" style="animation-delay:700ms;animation-fill-mode:both;">
                        Inside, the 2-bunk layout makes weekend trips with the kids effortless. The island queen sits up front, the family kitchen and L-shape lounge run down the middle, and a fully separated shower-and-toilet ensuite finishes the rear — privacy preserved at every stop.
                    </p>
                    <p class="text-black/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                        Choose between Hiker, Terrain, or Ultra Off-Grid packs to match how far off the bitumen you plan to roam. All three share the same silver-shine 6" chassis, 2" raiser, drop step, and the proven Grand Rover plumbing and electrical platform.
                    </p>
                    <div class="flex flex-wrap gap-3 mt-10 animate-fade-up" style="animation-delay:900ms;animation-fill-mode:both;">
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">2 Bunk Beds</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Island Queen</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Full Ensuite</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">L-Shape Lounge</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Off-Grid Ready</span>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <div class="relative rounded-[2rem] overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.08)] group">
                        <img src="/assets/GRANDROVER 20.6.jpg" alt="Grand Rover 19.6" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700" />
                        <div class="absolute inset-0 rounded-[2rem] border border-black/5 pointer-events-none"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. INTERIOR COMFORT                           -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-black text-white overflow-hidden">
            <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[40vw] h-[40vw] max-w-[500px] max-h-[500px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row-reverse gap-16 lg:gap-20 items-center">
                <!-- Premium three-image collage layout -->
                <div class="w-full lg:w-1/2 flex gap-4 md:gap-6 animate-fade-up items-start" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="flex-[1.2]">
                        <div class="relative rounded-[1.5rem] md:rounded-[2.5rem] overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.4)] group aspect-[3/4]">
                            <img src="/rover/grandrover/luxury_interior.png" alt="Grand Rover 19.6 Interior Main" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.5rem] md:rounded-[2.5rem] pointer-events-none"></div>
                        </div>
                    </div>
                    <div class="flex-1 flex flex-col gap-4 md:gap-6 mt-8 md:mt-16">
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                            <img src="/rover/grandrover/interior.png" alt="Grand Rover 19.6 Interior Detail" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                            <img src="/rover/grandrover/20.6/interior2.png" alt="Grand Rover 19.6 Interior Detail" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Interior Design</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">Family-First<br/><span class="text-[#E50000]">Layout.</span></h2>
                    <p class="text-white/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay:700ms;animation-fill-mode:both;">
                        Two dedicated bunks for the kids, an island queen for the parents, and a swing-around dinette that converts to extra sleeping when needed — the 19.6 carries four (or five) without ever feeling cramped.
                    </p>
                    <p class="text-white/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay:900ms;animation-fill-mode:both;">
                        The full kitchen runs a 188-litre fridge, recessed mini-grill, microwave, and proper benchtop space. The fully separate shower and toilet keeps the morning routine flowing — and the L-shape lounge is the after-dark headquarters when the kids are down.
                    </p>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 4. 3D FLOORPLANS                              -->
        <!-- ══════════════════════════════════════════════ -->
        <LayoutSection layouts={floorplans} title="Family-Ready" subtitle="Floorplan Variants." />

        <!-- ══════════════════════════════════════════════ -->
        <!-- 5. INTERIOR STYLING — Mood Boards             -->
        <!-- ══════════════════════════════════════════════ -->
        <MoodBoardSection />

        <!-- ══════════════════════════════════════════════ -->
        <!-- 6. SPECIFICATIONS — Tabbed Comparison         -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                <div class="mb-16">
                    <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none">Specifications<span class="text-[#E50000]">.</span></h2>
                    <p class="text-black/50 font-medium md:text-lg mt-4 max-w-2xl">Compare the three available packs side by side.</p>
                </div>
                <div class="flex flex-col lg:flex-row gap-10">
                    <div class="flex flex-row lg:flex-col gap-3 lg:w-[220px] shrink-0">
                        <button data-tier="ultra" class="tier-tab active-tier w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Ultra Pack</button>
                        <button data-tier="terrain" class="tier-tab w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Terrain Pack</button>
                        <button data-tier="hiker" class="tier-tab w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Hiker Pack</button>
                    </div>
                    <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="spec-columns">
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Chassis</h3><ul id="spec-chassis" class="flex flex-col gap-2.5"></ul></div>
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Furniture</h3><ul id="spec-furniture" class="flex flex-col gap-2.5"></ul></div>
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Electrical</h3><ul id="spec-electrical" class="flex flex-col gap-2.5"></ul></div>
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Plumbing</h3><ul id="spec-plumbing" class="flex flex-col gap-2.5"></ul></div>
                    </div>
                </div>
            </div>
        </section>

        <script>
        const specData: Record<string, Record<string, string[]>> = {
            ultra: {
                chassis: ["Silver shine chassis", '6" Chassis', '2" Chassis Raiser', '6" Extended A-frame', "Drop Step", "3200KG 10\" Brakes", "Roller Rocker suspension", "DO35 Coupling", "3 Arm Bumper Bar", '15" Alloy wheels', "2 X 95L freshwater tanks"],
                furniture: ["Meranti Frame Walls", "White stipple Furniture", "1900 x 1500 Island Queen bed", "Inner spring pillow top mattress", "Waterfall B Top in kitchen", "Squaredge Benchtops", "Recessed Full Oven", "20L NCE microwave", "Concertina door for ensuite", "Softclose Draw runners", "1 pc Polytech Flooring"],
                electrical: ["Gree 3500 Aircon", "LED Internal Down lights", "LED reading Lights with USB", "3X LED striplighting above OHC", "BM Pro HA BMS + Trek3 display", "24\" Smart TV", "Safety Dave Reverse Camera", "2 x 200W Solar Panels", "2 x 150Ah Lithium Batteries", "Smoke detector + Fire Extinguisher", "Omni Antenna"],
                plumbing: ["Water fillers X 2 Lockable", "188L DOMETIC 3 way Fridge", "Swift full oven", "Swift 28L HWS Gas + Elec", "Thetford Cassette Toilet", "Black Flick Mixer Taps", "12V Shurflo Water pump", "Black Ceramic Square Basin", "Black S.S Sink no drain", "External shower", "Tap on A-frame"]
            },
            terrain: {
                chassis: ["Silver shine chassis", '6" Chassis', '2" Chassis Raiser', '6" A-frame', "Drop Step", "3200KG 10\" Brakes", "Roller Rocker suspension", "DO35 Coupling", "3 Arm Bumper Bar", '1850mm Extended A-frame', '8" Jockey Wheels', "Spare wheel x 1 On Rear", "Gas Bottles 2 X 9KG", "2 X Battery Boxes", '15" Alloy wheels', "235/75/R15 A/T Tyres x 5", "2 X 95L freshwater tanks", "1 x 95L grey water tank"],
                furniture: ["Meranti Frame Walls", "White stipple Furniture", "Front robe port Holes", "1900 x 1500 Island Queen bed", "Inner spring pillow top mattress", "Waterfall B Top in kitchen", "Squaredge Benchtops", "Straight Lounge", "Fridge next to main partition", "2 Bunks off side", "Drws & Frontload Washing M/C", "Recessed Full Oven", "20L NCE microwave", "Bottom Mount Rangehood", "Concertina door for ensuite", "Frosted Glass Doors for Shower", "Piano Hinges + Gas struts", "Softclose Draw runners", "1 pc Polytech Flooring", "3x LED striplighting above OHC"],
