---
import VariantPage from '../templates/VariantPage.astro';
import { loadVariantBySlug } from '../lib/cms/products';

const variant = await loadVariantBySlug('grand-rover-196');
if (!variant) {
  return Astro.redirect('/grand-rover');
}
---

<VariantPage
  variant={variant}
  seriesHref="/grand-rover"
  seriesLabel="Grand Rover Series"
/>
