    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0046.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0043.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0057.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0056.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0068.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0054.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0055.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0069.jpg"
];

const layoutImages = [
    { title: "Wild Drifter 19.6 Layout", desc: "The Ultimate Family Fiesta", src: "/Wild Drifter/Layouts Wild Drifter/3D-Layout-WILD-DRIFTER-19.6.jpg" }
];
---


<Layout title="Wild Drifter 19.6 | Hike RV Caravans" description="Explore the wild in comfort and style with the rugged Wild Drifter 19.6 caravan, built for all terrains.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO — Split Editorial Layout              -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full min-h-[100vh] flex flex-col lg:flex-row overflow-hidden bg-black">
            <!-- Left: Content -->
            <div class="relative z-10 w-full lg:w-[45%] flex flex-col justify-center px-8 md:px-14 lg:px-20 py-32 lg:py-20">
                <div class="absolute top-0 right-0 hidden lg:block w-px h-full bg-gradient-to-b from-transparent via-white/10 to-transparent"></div>
                <a href="/wild-drifter" class="flex items-center gap-2 text-white/40 text-[10px] font-bold uppercase tracking-[0.3em] mb-10 hover:text-[#E50000] transition-colors duration-300 w-fit animate-fade-up" style="animation-delay:100ms;animation-fill-mode:both;">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
                    Wild Drifter Series
                </a>
                <div class="flex items-center gap-4 mb-6 animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="w-12 h-1 bg-[#E50000] rounded-full"></div>
                    <span class="text-[#E50000] text-[10px] font-black uppercase tracking-[0.4em]">Model 19.6</span>
                </div>
                <h1 class="text-white text-[3.5rem] md:text-[5rem] lg:text-[6rem] font-black uppercase tracking-tighter leading-[0.85] mb-3 animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Adventure.</h1>
                <h2 class="text-[2rem] md:text-[2.5rem] lg:text-[3rem] font-black uppercase tracking-tighter leading-[0.9] mb-8 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-white/80 to-white/40">Wild Drifter</span> <span class="text-[#E50000]">19.6</span>
                </h2>
                <p class="text-white/50 font-medium text-sm md:text-base leading-relaxed max-w-md mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">
                    Explore the wild in comfort and style with the rugged Wild Drifter 19.6 caravan, built for all terrains.
                </p>
                <div class="flex flex-col sm:flex-row items-start gap-4 animate-fade-up" style="animation-delay:600ms;animation-fill-mode:both;">
                    <a href="#contact" class="px-8 py-3.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)]">Get a Quote</a>
                    <a href="/brochures/GTH WILD DRIFTER (4 Pages).pdf" target="_blank" download class="px-8 py-3.5 border border-white/20 text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full flex items-center gap-2">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                        Brochure
                    </a>
                </div>
                <div class="flex items-center gap-8 mt-14 pt-8 border-t border-white/10 animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                    <div><span class="block text-2xl md:text-3xl font-black text-white">19.6<span class="text-[#E50000]">ft</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Length</span></div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div><span class="block text-2xl md:text-3xl font-black text-white">3<span class="text-[#E50000]"> Packs</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Available</span></div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div><span class="block text-2xl md:text-3xl font-black text-white">~3300<span class="text-[#E50000]">kg</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">ATM</span></div>
                </div>
            </div>
            <!-- Right: Image -->
            <div class="relative w-full lg:w-[55%] min-h-[50vh] lg:min-h-full">
                <img src="/Wild Drifter/Images/External/Copy of IMG_4177.JPG" alt="Wild Drifter 19.6" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-r from-black via-black/30 to-transparent lg:block hidden"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent lg:hidden"></div>
                <div class="absolute bottom-8 right-8 hidden lg:flex flex-col items-end gap-2 animate-fade-up" style="animation-delay:1000ms;animation-fill-mode:both;">
                    <span class="text-white/20 text-[9px] font-bold uppercase tracking-[0.3em]">Scroll to explore</span>
                    <div class="w-px h-12 bg-gradient-to-b from-white/30 to-transparent animate-pulse"></div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. KEY FEATURES UNVEILED                      -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row gap-16 lg:gap-20 items-start">
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">Overview</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">Key Features<br/><span class="text-[#E50000]">Unveiled.</span></h2>
                    <p class="text-black/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay:600ms;animation-fill-mode:both;">
                        Every detail of Wild Drifter 19.6 is engineered for performance, comfort, and dependability on every trip.
                    </p>
                    <p class="text-black/50 font-medium md:text-base leading-relaxed mb-8 animate-fade-up" style="animation-delay:700ms;animation-fill-mode:both;">
                        Inside, you'll find a practical and elegant layout: an island queen bed, full kitchen with pull-out pantry, café lounge seating and a separate ensuite; blending usability with refined touches. Thoughtful insulation, double glazing, and robust cabinetry ensure your interior stays comfortable in changing conditions.
                    </p>
                    <p class="text-black/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                        Externally, the 19.6 boasts a reinforced frame, strong composite panelling, checker plate protection, and off-road capable tyres. With a balance weight of around 160 kg, ATM of around 3300 kg, and a modern suspension setup, it's ready for highway cruising and bush access. It's a caravan that delivers in function and form.
                    </p>
                    <div class="flex flex-wrap gap-3 mt-10 animate-fade-up" style="animation-delay:900ms;animation-fill-mode:both;">
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Island Queen</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Pull-Out Pantry</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Café Lounge</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Full Ensuite</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Off-Road Ready</span>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <div class="relative rounded-[2rem] overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.08)] group">
                        <img src="/Wild Drifter/Images/External/Copy of IMG_4171.JPG" alt="Wild Drifter 19.6 Overview" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700" />
                        <div class="absolute inset-0 rounded-[2rem] border border-black/5 pointer-events-none"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. PREMIUM LIVING — Interior                  -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-black text-white overflow-hidden">
            <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[40vw] h-[40vw] max-w-[500px] max-h-[500px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row-reverse gap-16 lg:gap-20 items-center">
                <!-- Premium three-image collage layout -->
                <div class="w-full lg:w-1/2 flex gap-4 md:gap-6 animate-fade-up items-start" style="animation-delay:200ms;animation-fill-mode:both;">
                    <!-- Main image featuring interior1 -->
                    <div class="flex-[1.2]">
                        <div class="relative rounded-[1.5rem] md:rounded-[2.5rem] overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.4)] group aspect-[3/4]">
                            <img src={interiorImages[5]} alt="Wild Drifter 19.6 Interior Main" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.5rem] md:rounded-[2.5rem] pointer-events-none"></div>
                        </div>
                    </div>
                    <!-- Secondary stacked images featuring interior2 and interior3 -->
                    <div class="flex-1 flex flex-col gap-4 md:gap-6 mt-8 md:mt-16">
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                            <img src={interiorImages[4]} alt="Wild Drifter 19.6 Interior Detail" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                            <img src={interiorImages[13]} alt="Wild Drifter 19.6 Interior Detail" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                    </div>
                </div>
                <!-- Text -->
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Interior Design</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">Premium Living<br/><span class="text-[#E50000]">On Wheels.</span></h2>
                    <p class="text-white/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay:700ms;animation-fill-mode:both;">
                        Relax in the plush lounge or in soft innerspring comfort in your bed. Ambient lighting, ventilation, and neat storage zones create a space that invites rest and recuperation.
                    </p>
                    <p class="text-white/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay:900ms;animation-fill-mode:both;">
                        Your ensuite includes a compact shower, vanity, and cassette toilet, which offers privacy and convenience in a small footprint. The finish quality and careful layout ensure that your comfort is never an afterthought.
                    </p>
                    <!-- Feature chips -->
                    <div class="flex flex-wrap gap-3 mt-10 animate-fade-up" style="animation-delay:1000ms;animation-fill-mode:both;">
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Plush Lounge</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Innerspring Bed</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Ambient Lighting</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Compact Ensuite</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 4. VISUAL GALLERY — The 19.6 Experience        -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-white">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                <div class="flex flex-col items-center text-center max-w-2xl mx-auto mb-16 gap-6">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs block">Visual Experience</span>
                    <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none text-black">The <span class="text-[#E50000]">Gallery.</span></h2>
                    <p class="text-black/50 font-medium md:text-lg">Experience the Wild Drifter 19.6 in detail. {exteriorImages.length + interiorImages.length + layoutImages.length} snapshots of adventure.</p>
                </div>

                <!-- Tab Navigation -->
                <div class="flex items-center justify-center gap-1 sm:gap-4 mb-20 overflow-x-auto no-scrollbar py-2">
                    <button data-cat="exterior" class="gallery-tab active-gallery-tab px-8 py-3.5 rounded-full font-black uppercase tracking-[0.2em] text-[9px] md:text-[11px] transition-all duration-500 border border-black/5">Exterior <span class="ml-2 text-black/50">({exteriorImages.length})</span></button>
                    <button data-cat="interior" class="gallery-tab px-8 py-3.5 rounded-full font-black uppercase tracking-[0.2em] text-[9px] md:text-[11px] transition-all duration-500 border border-black/5">Interior <span class="ml-2 text-black/50">({interiorImages.length})</span></button>
                    <button data-cat="layout" class="gallery-tab px-8 py-3.5 rounded-full font-black uppercase tracking-[0.2em] text-[9px] md:text-[11px] transition-all duration-500 border border-black/5">Layouts <span class="ml-2 text-black/50">({layoutImages.length})</span></button>
                </div>

                <!-- Gallery Grids -->
                <div class="relative min-h-[800px]">
                    <!-- EXTERIOR GRID -->
                    <div id="gallery-exterior" class="gallery-content visible-gallery grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 transition-all duration-700">
                        {exteriorImages.map((src, i) => (
                            <div class={`relative group overflow-hidden rounded-[2rem] bg-black/5 aspect-square ${i === 2 ? 'lg:col-span-2 lg:row-span-2' : ''}`}>
                                <img src={src} data-src={src} alt={`Wild Drifter External ${i + 1}`} loading="lazy" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
                                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                            </div>
                        ))}
                    </div>

                    <!-- INTERIOR GRID -->
                    <div id="gallery-interior" class="gallery-content hidden-gallery grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 transition-all duration-700 absolute inset-0">
                        {interiorImages.map((src, i) => (
                            <div class={`relative group overflow-hidden rounded-[1.5rem] bg-black/5 aspect-square ${i === 5 ? 'lg:col-span-2 lg:row-span-2' : ''}`}>
                                <img src={src} data-src={src} alt={`Wild Drifter Internal ${i + 1}`} loading="lazy" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
                                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                            </div>
                        ))}
                    </div>

                    <!-- LAYOUT GRID -->
                    <div id="gallery-layout" class="gallery-content hidden-gallery grid grid-cols-1 gap-8 transition-all duration-700 absolute inset-0">
                        {layoutImages.map((item, i) => (
                            <div class="relative group overflow-hidden rounded-[2.5rem] bg-black/2 pb-12 border border-black/5 flex flex-col items-center justify-center transition-all duration-500 hover:shadow-[0_20px_50px_rgba(0,0,0,0.05)]">
                                <div class="p-8 md:p-12 w-full max-w-5xl">
                                    <img src={item.src} alt={item.title} class="w-full h-auto object-contain transition-transform duration-700 group-hover:scale-105" />
                                </div>
                                <div class="px-8 text-center text-black">
                                    <span class="text-[#E50000] font-black tracking-[0.4em] text-[10px] uppercase">{item.title}</span>
                                    <h4 class="text-3xl font-black mt-2 tracking-tight">{item.desc}</h4>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- Gallery CTA -->
                <div class="mt-24 pt-20 border-t border-black/5 flex flex-col items-center">
                    <p class="text-black/30 text-[10px] font-bold uppercase tracking-[0.3em] mb-10">Unmatched detail in every layout</p>
                    <div class="flex flex-col sm:flex-row gap-6">
                        <a href="/brochures/GTH WILD DRIFTER (4 Pages).pdf" target="_blank" download class="px-10 py-5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] rounded-full hover:bg-[#E50000] transition-all duration-500 shadow-xl">Download Brochure</a>
                        <a href="#contact" class="px-10 py-5 border border-black/20 text-black font-black uppercase tracking-[0.2em] text-[10px] rounded-full hover:bg-black hover:text-white transition-all duration-500">Book A Tour</a>
                    </div>
                </div>
            </div>
        </section>

        <script>
            function initGallery() {
                const tabs = document.querySelectorAll('.gallery-tab');
                const contents = document.querySelectorAll('.gallery-content');

                tabs.forEach(tab => {
                    tab.addEventListener('click', () => {
                        const target = tab.getAttribute('data-cat');

                        tabs.forEach(t => t.classList.remove('active-gallery-tab', 'bg-black', 'text-white'));
                        tab.classList.add('active-gallery-tab', 'bg-black', 'text-white');

                        contents.forEach(content => {
                            const id = content.getAttribute('id');
                            if (id === `gallery-${target}`) {
                                content.classList.remove('hidden-gallery', 'opacity-0', 'pointer-events-none', 'absolute', 'translate-y-[30px]');
                                content.classList.add('visible-gallery', 'opacity-100', 'z-10', 'relative', 'translate-y-0');
                            } else {
                                content.classList.add('hidden-gallery', 'opacity-0', 'pointer-events-none', 'absolute', 'translate-y-[30px]');
                                content.classList.remove('visible-gallery', 'opacity-100', 'z-10', 'relative', 'translate-y-0');
                            }
                        });
                    });
                });
            }
            initGallery();
        </script>

