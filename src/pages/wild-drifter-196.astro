    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0064.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0058.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0059.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0065.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0071.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0067.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0066.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0062.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0063.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0061.jpg",
    "/Wild Drifter/Images/Internal 4/Copy of IMG-20250402-WA0060.jpg",
