import MoodBoardSection from "../components/MoodBoardSection.astro";

const exteriorImages = [
    "/Wild Drifter/Images/External/Copy of IMG_4171.JPG",
    "/Wild Drifter/Images/External/Copy of IMG_4170.JPG",
    "/Wild Drifter/Images/External/Copy of IMG_4175.JPG",
    "/Wild Drifter/Images/External/Copy of IMG_4177.JPG",
    "/Wild Drifter/Images/External/Copy of IMG_4176.JPG",
    "/Wild Drifter/Images/External/Copy of IMG-20250402-WA0073.jpg",
    "/Wild Drifter/Images/External/Copy of IMG-20250402-WA0072.jpg",
    "/Wild Drifter/Images/External/Copy of IMG-20250402-WA0076.jpg",
