---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Invitation from "../components/Invitation.astro";

const dealers = [
    {
        name: "Get Hitched Tasmania",
        address: "30 Charbooday Dr Youngtown TAS 7249",
        phone: "0439 931 284",
        email: "gethitchedtas@hotmail.com",
        website: "https://gethitchedtas.com",
        logo: "/gethitched.png"
    }
];
---

<Layout
	title="Caravan Dealers — Melbourne & Australia | Hike RV"
	description="Find a Hike RV caravan dealer near you. Showrooms across Melbourne, Victoria and Australia stocking off road, family and luxury caravans."
	keywords="caravan dealer Melbourne, caravans Melbourne, caravans Victoria, off road caravans Melbourne, buy caravan Australia, Hike RV dealers, Australian caravans VIC"
>
    <Navbar />

    <main class="pt-32 bg-[#fdfdfd] min-h-screen text-black overflow-hidden">
        <!-- ░░ HERO SECTION ░░ -->
        <section class="relative py-24 px-6 overflow-hidden">
            <div class="max-w-[1400px] mx-auto text-center relative z-10">
                <div class="flex items-center justify-center gap-4 mb-8 opacity-40">
                    <div class="w-8 h-px bg-black"></div>
                    <span class="text-black text-[10px] uppercase font-black tracking-[0.4em]">Network</span>
                    <div class="w-8 h-px bg-black"></div>
                </div>
                <h1 class="text-black text-5xl md:text-7xl lg:text-[6rem] font-black uppercase tracking-tighter leading-none mb-8">
                    Our <span class="text-[#E50000]">Dealers.</span>
                </h1>
                <p class="text-black/60 font-medium md:text-xl max-w-2xl mx-auto leading-relaxed">
                    Hike RV is partnered with the finest dealerships across Australia to provide localized support, expert advice, and premium showrooms.
                </p>
                <div class="mt-10 flex items-center justify-center">
                    <a href="/service-centers" class="inline-flex items-center gap-3 px-8 py-3.5 border border-black/15 text-black font-black uppercase tracking-[0.2em] text-[10px] hover:bg-black hover:text-white transition-all duration-500 rounded-full">
                        Looking for a Service Center?
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                    </a>
                </div>
            </div>
            
            <!-- Atmospheric background glow -->
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-[#E50000]/5 blur-[150px] rounded-full pointer-events-none"></div>
        </section>

        <!-- ░░ DEALERS GRID (Light Version) ░░ -->
        <section class="py-24 px-6 md:px-14">
            <div class="max-w-[1400px] mx-auto flex flex-col gap-12">
                {dealers.map((dealer) => (
                    <div class="group relative overflow-hidden bg-white border border-black/5 rounded-[40px] p-8 md:p-14 flex flex-col lg:flex-row gap-12 transition-all duration-700 hover:border-[#E50000]/20 hover:shadow-[0_40px_100px_rgba(0,0,0,0.05)]">
                        <!-- Dealer Branding -->
                        <div class="w-full lg:w-[400px] flex items-center justify-center p-10 bg-black/[0.02] rounded-3xl transition-all duration-700 group-hover:bg-white group-hover:shadow-inner group-hover:scale-[1.02]">
                            <img src={dealer.logo} alt={dealer.name} class="max-w-full h-auto object-contain transition-all duration-700 group-hover:scale-105" />
                        </div>

                        <!-- Dealer Info -->
                        <div class="flex-1 flex flex-col justify-center">
                            <h2 class="text-black text-3xl md:text-4xl font-black uppercase tracking-tight mb-10 group-hover:text-[#E50000] transition-colors leading-tight">
                                {dealer.name}
                            </h2>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12">
                                <div class="flex flex-col gap-4">
                                    <span class="text-[9px] font-black uppercase tracking-[0.4em] text-black/20">Location</span>
                                    <p class="text-black/70 font-semibold md:text-lg leading-relaxed">{dealer.address}</p>
                                </div>
                                <div class="flex flex-col gap-4">
                                    <span class="text-[9px] font-black uppercase tracking-[0.4em] text-black/20">Direct Line</span>
                                    <a href={`tel:${dealer.phone.replace(/\s+/g, '')}`} class="text-black font-black text-2xl hover:text-[#E50000] transition-colors">{dealer.phone}</a>
                                </div>
                                <div class="flex flex-col gap-4">
                                    <span class="text-[9px] font-black uppercase tracking-[0.4em] text-black/20">Email Address</span>
                                    <a href={`mailto:${dealer.email}`} class="text-black/60 font-semibold hover:text-[#E50000] transition-colors break-words">{dealer.email}</a>
                                </div>
                                <div class="flex flex-col gap-4">
                                    <span class="text-[9px] font-black uppercase tracking-[0.4em] text-black/20">Official Link</span>
                                    <a href={dealer.website} target="_blank" class="w-fit flex items-center gap-3 px-6 py-3 border border-black/5 bg-black/[0.02] text-black font-black uppercase tracking-[0.2em] text-[10px] rounded-full hover:bg-black hover:text-white transition-all duration-500">
                                        Open Website
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Delicate Red Detail -->
                        <div class="absolute top-0 right-0 w-32 h-32 bg-[#E50000]/[0.02] rounded-bl-full pointer-events-none"></div>
                    </div>
                ))}
            </div>
        </section>

        <!-- Standardized Architectural Footer for Light Page -->
        <section class="py-12 border-t border-black/5 bg-[#f5f5f5]">
            <div class="max-w-[1400px] mx-auto px-6 flex flex-wrap justify-between items-center gap-8">
                <span class="text-black/20 text-[9px] font-black uppercase tracking-[0.4em]">© 2026 HIKE RV Caravans — National Dealer Network</span>
                <div class="flex gap-10">
                    <a href="#" class="text-black/40 hover:text-black transition-colors text-[9px] uppercase font-black tracking-widest">Privacy</a>
                    <a href="#" class="text-black/40 hover:text-black transition-colors text-[9px] uppercase font-black tracking-widest">Terms</a>
                </div>
            </div>
        </section>
    </main>

    <style is:global>
        /* Force Navbar visibility on white background */
        #main-nav {
            background-color: rgba(0, 0, 0, 0.95) !important;
            backdrop-filter: blur(10px);
            padding-top: 1rem !important;
            padding-bottom: 1rem !important;
        }
        
        #nav-logo span, #menu-toggle span, #nav-cta span {
            color: white !important;
        }

        #scroll-progress {
            background-color: #E50000 !important;
        }
    </style>
</Layout>
