---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import MoodBoardSection from "../components/MoodBoardSection.astro";
import LayoutSection from "../components/LayoutSection.astro";

const floorplans = [
    { title: "Grand Rover Infinity 23.6", desc: "The Flagship Floorplan", src: "/3D LAYOUTS 2024/3D LAYOUT NEW UPDATED AUG 2025/GRAND ROVER 23.6 INFINITY.png" },
    { title: "Grand Rover Infinity 24.6", desc: "Extended Luxury Variant", src: "/3D LAYOUTS 2024/3D LAYOUT NEW UPDATED AUG 2025/GRAND ROVER 24.6 INFINITY.png" }
];
---

<Layout title="Grand Rover Infinity | Hike RV Caravans" description="Crafted with precision, the Grand Rover Infinity is the epitome of luxury and durability, designed for families seeking unparalleled adventure.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO — Split Editorial Layout              -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full min-h-[100vh] flex flex-col lg:flex-row overflow-hidden bg-black">
            <div class="relative z-10 w-full lg:w-[45%] flex flex-col justify-center px-8 md:px-14 lg:px-20 py-32 lg:py-20">
                <div class="absolute top-0 right-0 hidden lg:block w-px h-full bg-gradient-to-b from-transparent via-white/10 to-transparent"></div>
                <a href="/grand-rover" class="flex items-center gap-2 text-white/40 text-[10px] font-bold uppercase tracking-[0.3em] mb-10 hover:text-[#E50000] transition-colors duration-300 w-fit animate-fade-up" style="animation-delay:100ms;animation-fill-mode:both;">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
                    Grand Rover Series
                </a>
                <div class="flex items-center gap-4 mb-6 animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="w-12 h-1 bg-[#E50000] rounded-full"></div>
                    <span class="text-[#E50000] text-[10px] font-black uppercase tracking-[0.4em]">Flagship Model</span>
                </div>
                <h1 class="text-white text-[3.5rem] md:text-[5rem] lg:text-[6rem] font-black uppercase tracking-tighter leading-[0.85] mb-3 animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Spacious.</h1>
                <h2 class="text-[2rem] md:text-[2.5rem] lg:text-[3rem] font-black uppercase tracking-tighter leading-[0.9] mb-8 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-white/80 to-white/40">Grand Rover</span> <span class="text-[#E50000]">Infinity</span>
                </h2>
                <p class="text-white/50 font-medium text-sm md:text-base leading-relaxed max-w-md mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">
                    Crafted with precision, the Grand Rover Infinity is the epitome of luxury and durability, designed for families seeking unparalleled adventure.
                </p>
                <div class="flex flex-col sm:flex-row items-start gap-4 animate-fade-up" style="animation-delay:600ms;animation-fill-mode:both;">
                    <a href="#contact" class="px-8 py-3.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)]">Get a Quote</a>
                    <a href="/brochures/gthgrandrover.pdf" target="_blank" download class="px-8 py-3.5 border border-white/20 text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full flex items-center gap-2">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                        Brochure
                    </a>
                </div>
                <div class="grid grid-cols-4 gap-x-4 gap-y-5 mt-14 pt-8 border-t border-white/10 animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">3000W</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Inverter</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 12v3.75h18V12zM4.5 15.75v3M19.5 15.75v3M6.75 9.75V8.25A2.25 2.25 0 019 6h6a2.25 2.25 0 012.25 2.25v1.5"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">Leatherette</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Club Lounge</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 3h13.5a1.5 1.5 0 011.5 1.5v15a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-15a1.5 1.5 0 011.5-1.5zM3.75 11.25h16.5M7.5 7.5v-.75M7.5 15v-.75"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">224L Dometic</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Fridge</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75A2.25 2.25 0 016 4.5h12a2.25 2.25 0 012.25 2.25v10.5A2.25 2.25 0 0118 19.5H6a2.25 2.25 0 01-2.25-2.25V6.75zM3.75 10.5h16.5M7.5 4.5v15M16.5 4.5v15"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">Aluminium</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Rivitec Frame</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v3M12 18v3M5.636 5.636l2.121 2.121M16.243 16.243l2.121 2.121M3 12h3M18 12h3M5.636 18.364l2.121-2.121M16.243 7.757l2.121-2.121"/><circle cx="12" cy="12" r="4" stroke-width="1.8"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">TufRide L3</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Airbag Susp.</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="4" y="3" width="16" height="18" rx="1.5"/><circle cx="12" cy="13" r="4"/><circle cx="8" cy="6.5" r=".5" fill="currentColor"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">3.2kg Top-Load</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Washing M/C</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 10.5h.375c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125H21M4.5 10.5H18V15H4.5v-4.5zM3.75 18h15A2.25 2.25 0 0021 15.75v-6a2.25 2.25 0 00-2.25-2.25h-15A2.25 2.25 0 001.5 9.75v6A2.25 2.25 0 003.75 18z"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">2 × 300Ah</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Lithium</span>
                    </div>
                    <div class="flex flex-col items-start gap-1.5">
                        <svg class="w-5 h-5 text-[#E50000]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="14" rx="1"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 8.5h18M3 13h18M9 4v14M15 4v14M9 21h6"/></svg>
                        <span class="block text-[11px] font-black text-white leading-tight">5 × 250W</span>
                        <span class="text-white/40 text-[8px] font-bold uppercase tracking-[0.15em] leading-tight">Solar Panel</span>
                    </div>
                </div>
            </div>
            <div class="relative w-full lg:w-[55%] min-h-[50vh] lg:min-h-full">
                <img src="/rover/grandrover/Grand Rover Infinity.png" alt="Grand Rover Infinity" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-[linear-gradient(to_right,_rgb(0_0_0)_0%,_rgb(0_0_0/0.1)_30%,_transparent_60%)] lg:block hidden"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent lg:hidden"></div>
                <div class="absolute bottom-8 right-8 hidden lg:flex flex-col items-end gap-2 animate-fade-up" style="animation-delay:1000ms;animation-fill-mode:both;">
                    <span class="text-white/20 text-[9px] font-bold uppercase tracking-[0.3em]">Scroll to explore</span>
                    <div class="w-px h-12 bg-gradient-to-b from-white/30 to-transparent animate-pulse"></div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. OVERVIEW                                   -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row gap-16 lg:gap-20 items-start">
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">Overview</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">Grand Rover<br/><span class="text-[#E50000]">Infinity.</span></h2>
                    <p class="text-black/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay:600ms;animation-fill-mode:both;">
                        Embrace the freedom of the open road with a caravan that meets all your needs, from luxury amenities to off-road prowess.
                    </p>
                    <p class="text-black/50 font-medium md:text-base leading-relaxed mb-8 animate-fade-up" style="animation-delay:700ms;animation-fill-mode:both;">
                        Step inside the Grand Rover Infinity and experience a world of comfort. The caravan boasts a queen-sized bed, L-shaped lounges, and a full ensuite, ensuring a restful retreat after a day of exploration. Every detail is meticulously crafted to provide a homely feel, making it the perfect base for your adventures.
                    </p>
                    <p class="text-black/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                        Designed with the modern traveller in mind, the Grand Rover Infinity features a sleek exterior complemented by a spacious interior layout. A 224L compressor fridge and an air fryer add a touch of luxury, allowing you to enjoy home-cooked meals on the go.
                    </p>
                </div>
                <div class="w-full lg:w-1/2 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <div class="relative rounded-[2rem] overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.08)] group">
                        <img src="/rover/grandrover/infinity/infinity1.png" alt="Grand Rover Infinity" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700" />
                        <div class="absolute inset-0 rounded-[2rem] border border-black/5 pointer-events-none"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. ONBOARD FEATURES                           -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-black text-white overflow-hidden">
            <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[40vw] h-[40vw] max-w-[500px] max-h-[500px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row-reverse gap-16 lg:gap-20 items-center">
                <!-- Premium three-image collage for flagship feel -->
                <div class="w-full lg:w-1/2 flex gap-4 md:gap-6 animate-fade-up items-start" style="animation-delay:200ms;animation-fill-mode:both;">
                    <!-- Main image featuring interior1 -->
                    <div class="flex-[1.2]">
                        <div class="relative rounded-[1.5rem] md:rounded-[2.5rem] overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.5)] group aspect-[3/4]">
                            <img src="/rover/grandrover/infinity/interior1.png" alt="Grand Rover Infinity Interior Main" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.5rem] md:rounded-[2.5rem] pointer-events-none"></div>
                        </div>
                    </div>
                    <!-- Secondary stacked images featuring interior2 and interior3 -->
                    <div class="flex-1 flex flex-col gap-4 md:gap-6 mt-8 md:mt-16">
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                            <img src="/rover/grandrover/infinity/interior2.png" alt="Grand Rover Infinity Interior Detail" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                            <img src="/rover/grandrover/infinity/interior3.png" alt="Grand Rover Infinity Interior Detail" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Onboard Features</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">Fully Equipped<br/><span class="text-[#E50000]">For Adventure.</span></h2>
                    <p class="text-white/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay:700ms;animation-fill-mode:both;">
                        With a silver-shine 6″ chassis, 2″ chassis raiser, extended A-frame, drop step, and 3500kg 10″ brakes, the Grand Rover Infinity is engineered for durability and performance on all terrains. The interior boasts leatherette upholstery, soft-close drawers, and a Nuova Mapa table.
                    </p>
                    <p class="text-white/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay:900ms;animation-fill-mode:both;">
                        Enjoy cooking with a recessed mini grill, microwave, and white ceramic sink with drainer. The ensuite features a white ceramic basin and Thetford cassette toilet. Separate shower and toilet compartments ensure privacy and practicality on extended journeys.
                    </p>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 4. 3D FLOORPLANS                              -->
        <!-- ══════════════════════════════════════════════ -->
        <LayoutSection layouts={floorplans} title="Masterful" subtitle="Spatial Design." />

        <!-- ══════════════════════════════════════════════ -->
        <!-- 5. INTERIOR STYLING — Mood Boards             -->
        <!-- ══════════════════════════════════════════════ -->
        <MoodBoardSection />

        <!-- ══════════════════════════════════════════════ -->
        <!-- 5. SPECIFICATIONS — Tabbed Comparison         -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                <div class="mb-16">
                    <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none">Specifications<span class="text-[#E50000]">.</span></h2>
                    <p class="text-black/50 font-medium md:text-lg mt-4 max-w-2xl">With spacious interiors and thoughtful features, the Grand Rover Infinity accommodates families of all sizes.</p>
                </div>
                <div class="flex flex-col lg:flex-row gap-10">
                    <div class="flex flex-row lg:flex-col gap-3 lg:w-[220px] shrink-0">
                        <button data-tier="ultra" class="tier-tab active-tier w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Ultra Pack</button>
                        <button data-tier="terrain" class="tier-tab w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Terrain Pack</button>
                        <button data-tier="hiker" class="tier-tab w-full text-left px-6 py-4 rounded-xl font-black uppercase tracking-[0.15em] text-[11px] border-2 transition-all duration-300">Hiker Pack</button>
                    </div>
                    <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Chassis</h3><ul id="spec-chassis" class="flex flex-col gap-2.5"></ul></div>
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Furniture</h3><ul id="spec-furniture" class="flex flex-col gap-2.5"></ul></div>
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Electrical</h3><ul id="spec-electrical" class="flex flex-col gap-2.5"></ul></div>
                        <div><h3 class="text-lg font-black uppercase tracking-wider text-[#E50000] mb-5">Plumbing</h3><ul id="spec-plumbing" class="flex flex-col gap-2.5"></ul></div>
                    </div>
                </div>
            </div>
        </section>

        <script>
        const specData: Record<string, Record<string, string[]>> = {
            ultra: {
                chassis: ["Silver shine chassis", '6" Chassis', '2" Chassis Raiser', '6" Extended A-frame', "Drop Legs x 4", "2 X Battery Boxes"],
                furniture: ["White stipple Furniture", "Front robe port Holes", "Postform Benchtops", "Recessed Mini grill", "Air conditioner Frame", "Smoke detector"],
                electrical: ["Gree 3500 air conditioner", "LED Boot Lights", "External 240 Power point", "HV Wingard sensor", "Grey Anderson Plug", "12 Pin Trailer Plug"],
                plumbing: ["Water fillers X 2 Lockable", "224L DOMETIC 3 way Fridge", "Fridge/Freezer", "Swift Mini grill", "Water filter system", "Thetford Cassette Toilet"]
            },
            terrain: {
                chassis: ["Silver shine chassis", '6" Chassis', '2" Chassis Raiser', '6" Extended A-frame', "Drop Step", "Do-35 Coupling"],
                furniture: ["White stipple Furniture", "Front robe port Holes", "Postform Benchtops", "Queen Bed 1900 x 500mm", "Smoke detector", "Bottom Mount Rangehood"],
                electrical: ["3500 Gree air conditioner", "LED Internal Down lights", "LED Boot Lights", "HV Wingard sensor", "Bottom mount Rangehood", "BM-pro Trail safe"],
                plumbing: ["Water fillers X 2 Lockable", "188L DOMETIC 3 way", "Fridge/Freezer", "Swift Mini grill", "1 x Elec + 3 x gas", "White Ceramic Basin"]
            },
            hiker: {
                chassis: ["Silver shine chassis", '6" Chassis', '2" Chassis Raiser', '6" A-frame', '3500KG 10" Brakes', "8\" Jockey Wheels"],
                furniture: ["White stipple Furniture", "Front robe port Holes", "Postform Benchtops", "Recessed Mini grill", "20L Microwave", "Smoke detector"],
                electrical: ["Gree 3500 air conditioner", "LED Internal Down lights", "LED Boot Lights", "External 240 Power point", "BM-pro Trail safe", "Grey Anderson Plug"],
                plumbing: ["Water fillers X 2 Lockable", "188L DOMETIC 12v", "Fridge/Freezer", "Swift Mini grill", "Flick Mixer Taps", "White Ceramic Basin"]
            }
        };

        function renderSpecs(tier: string) {
            const d = specData[tier];
            ['chassis', 'furniture', 'electrical', 'plumbing'].forEach(cat => {
                const ul = document.getElementById('spec-' + cat);
                if (ul) ul.innerHTML = d[cat].map((item: string) =>
                    `<li class="flex items-start gap-3"><span class="w-4 h-4 shrink-0 mt-0.5 text-[#E50000]"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg></span><span class="text-sm text-black/60 font-medium">${item}</span></li>`
                ).join('');
            });
        }

        document.querySelectorAll('.tier-tab').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tier-tab').forEach(b => b.classList.remove('active-tier'));
                btn.classList.add('active-tier');
                const targetTier = (btn as HTMLElement).dataset.tier;
                if (targetTier) renderSpecs(targetTier);
            });
        });
        renderSpecs('ultra');
        </script>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 6. CTA                                        -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="contact" class="relative z-10 w-full py-24 md:py-32 bg-black text-white overflow-hidden">
