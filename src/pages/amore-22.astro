---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import LayoutSection from "../components/LayoutSection.astro";
import MoodBoardSection from "../components/MoodBoardSection.astro";

const exteriorImages = [
    "Copy of IMG-20250603-WA0069.jpg", "Copy of IMG-20250603-WA0072.jpg", "Copy of IMG-20250603-WA0073.jpg", 
    "Copy of IMG-20250603-WA0075.jpg", "Copy of IMG-20250603-WA0078.jpg", "Copy of IMG-20250603-WA0079.jpg", 
    "Copy of IMG-20250603-WA0080.jpg", "Copy of IMG-20250603-WA0081.jpg", "Copy of IMG-20250603-WA0082.jpg", 
    "Copy of IMG-20250603-WA0083.jpg", "Copy of WhatsApp Image 2025-04-19 at 07.36.26_90a44680.jpg"
].map(img => `/Amore/Images/External/${img}`);

const interiorImages = [
    "Copy of IMG-20250603-WA0049.jpg", "Copy of IMG-20250603-WA0051.jpg", "Copy of IMG-20250603-WA0052.jpg", 
    "Copy of IMG-20250603-WA0053.jpg", "Copy of IMG-20250603-WA0054.jpg", "Copy of IMG-20250603-WA0055.jpg", 
    "Copy of IMG-20250603-WA0056.jpg", "Copy of IMG-20250603-WA0057.jpg", "Copy of IMG-20250603-WA0058.jpg", 
    "Copy of IMG-20250603-WA0059.jpg", "Copy of IMG-20250603-WA0060.jpg", "Copy of IMG-20250603-WA0061.jpg", 
    "Copy of IMG-20250603-WA0062.jpg", "Copy of IMG-20250603-WA0063.jpg", "Copy of IMG-20250603-WA0065.jpg", 
    "Copy of IMG-20250603-WA0067.jpg", "Copy of IMG-20250603-WA0068.jpg"
].map(img => `/Amore/Images/Internal 2/${img}`);

const layoutImages = [
    { title: "Amore 18.6", desc: "Compact Luxury 3D", src: "/3D LAYOUTS 2024/3D LAYOUT NEW UPDATED AUG 2025/AMORE 18.6.png" },
    { title: "Amore 22.6", desc: "Spacious Club Lounge", src: "/Amore/Layouts Amore/Copy of AMORE 22.6FT STD.jpg" }
];
---


<Layout title="Amore 22 | Hike RV Caravans" description="Make every getaway extraordinary in a spacious, innovative Amore 22 caravan. Comfort, style and practicality designed for adventurous couples.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO — Split Editorial Layout              -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full min-h-[100vh] flex flex-col lg:flex-row overflow-hidden bg-black">
            <!-- Left: Content -->
            <div class="relative z-10 w-full lg:w-[45%] flex flex-col justify-center px-8 md:px-14 lg:px-20 py-32 lg:py-20 text-white">
                <div class="absolute top-0 right-0 hidden lg:block w-px h-full bg-gradient-to-b from-transparent via-white/10 to-transparent"></div>
                
                <a href="/drifter" class="flex items-center gap-2 text-white/40 text-[10px] font-bold uppercase tracking-[0.3em] mb-10 hover:text-[#E50000] transition-colors duration-300 w-fit animate-fade-up" style="animation-delay:100ms;animation-fill-mode:both;">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
                    Drifter Series
                </a>

                <div class="flex items-center gap-4 mb-6 animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="w-12 h-1 bg-[#E50000] rounded-full"></div>
                    <span class="text-[#E50000] text-[10px] font-black uppercase tracking-[0.4em]">Model 22</span>
                </div>

                <h1 class="text-white text-[3.5rem] md:text-[5rem] lg:text-[6rem] font-black uppercase tracking-tighter leading-[0.85] mb-3 animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Spacious.</h1>
                <h2 class="text-[2rem] md:text-[2.5rem] lg:text-[3rem] font-black uppercase tracking-tighter leading-[0.9] mb-8 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-white/80 to-white/40">Amore</span> <span class="text-[#E50000]">22</span>
                </h2>

                <p class="text-white/50 font-medium text-sm md:text-base leading-relaxed max-w-md mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">
                    Make every getaway extraordinary in a spacious, innovative Amore 22 caravan. Comfort, style and practicality designed for adventurous couples.
                </p>

                <div class="flex flex-col sm:flex-row items-start gap-4 animate-fade-up" style="animation-delay:600ms;animation-fill-mode:both;">
                    <a href="#contact" class="px-8 py-3.5 bg-[#E50000] text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(229,0,0,0.3)]">Get it Now!</a>
                    <a href="/brochures/gthamore.pdf" target="_blank" download class="px-8 py-3.5 border border-white/20 text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-white hover:text-black transition-all duration-500 rounded-full flex items-center gap-2 group">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                        Brochure
                    </a>
                </div>

                <div class="flex items-center gap-8 mt-14 pt-8 border-t border-white/10 animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                    <div><span class="block text-2xl md:text-3xl font-black text-white">22<span class="text-[#E50000]">ft</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Length</span></div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div><span class="block text-2xl md:text-3xl font-black text-white">3<span class="text-[#E50000]"> Packs</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Available</span></div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div><span class="block text-2xl md:text-3xl font-black text-white">Club<span class="text-[#E50000]"> Lounge</span></span><span class="text-white/30 text-[9px] font-bold uppercase tracking-[0.2em]">Layout</span></div>
                </div>
            </div>
            <!-- Right: Image (Placeholder) -->
            <div class="relative w-full lg:w-[55%] min-h-[50vh] lg:min-h-full">
                <img src="/drifter/amore/amor.png" alt="Amore 22" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-r from-black via-black/30 to-transparent lg:block hidden"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent lg:hidden"></div>
                <div class="absolute bottom-8 right-8 hidden lg:flex flex-col items-end gap-2 animate-fade-up" style="animation-delay:1000ms;animation-fill-mode:both;">
                    <span class="text-white/20 text-[9px] font-bold uppercase tracking-[0.3em]">Scroll to explore</span>
                    <div class="w-px h-12 bg-gradient-to-b from-white/30 to-transparent animate-pulse"></div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. DESIGNED FOR COMFORT FIRST                 -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row gap-16 lg:gap-20 items-start">
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay:200ms;animation-fill-mode:both;">Luxury Touring</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">Designed For<br/><span class="text-[#E50000]">Comfort First.</span></h2>
                    
                    <p class="text-black/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay:600ms;animation-fill-mode:both;">
                        Discover a caravan that turns travel into delight, blending luxurious living with practical features. Every mile brings pure relaxation and enjoyment.
                    </p>
                    
                    <p class="text-black/50 font-medium md:text-base leading-relaxed mb-8 animate-fade-up" style="animation-delay:700ms;animation-fill-mode:both;">
                        The Amore 22 is built with a rear club lounge and central ensuite, creating a true home away from home for couples who value luxury and space. Every detail, from the postform benchtops to the recessed mini grill and fire extinguisher under-lounge, enhances convenience and safety during travel.
                    </p>

                    <p class="text-black/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay:800ms;animation-fill-mode:both;">
                        Relax in leatherette seating and enjoy a full entertainment suite: a 24" smart TV, Fusion sound system, and internal/external speakers designed for pure enjoyment. The spacious club lounge and centre ensuite elevate every journey. Enjoy intelligent design, user-friendly interiors, and thoughtful storage in the Amore 22.
                    </p>

                    <div class="flex flex-wrap gap-3 mt-10 animate-fade-up" style="animation-delay:900ms;animation-fill-mode:both;">
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Club Lounge</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Centre Ensuite</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Smart TV</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Fusion Sound</span>
                        <span class="px-5 py-2.5 bg-black/5 border border-black/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-black/60 hover:text-black hover:border-[#E50000]/40 transition-all duration-300">Leatherette Seating</span>
                    </div>
                </div>
                <div class="w-full lg:w-1/2 animate-fade-up" style="animation-delay:400ms;animation-fill-mode:both;">
                    <div class="relative rounded-[2rem] overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.08)] group aspect-video">
                        <img src="/drifter/amore/amor.png" alt="Amore 22 Exterior" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                        <div class="absolute inset-0 rounded-[2rem] border border-black/5 pointer-events-none"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. FEATURES FOR EVERY EXPLORER                -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-black text-white overflow-hidden">
            <div class="absolute top-1/2 right-0 -translate-y-1/2 w-[40vw] h-[40vw] max-w-[500px] max-h-[500px] bg-[#E50000]/5 rounded-full blur-[150px] pointer-events-none"></div>
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row-reverse gap-16 lg:gap-20 items-center">
                
                <!-- Premium three-image collage layout (using placeholders from Wild Drifter for now) -->
                <div class="w-full lg:w-1/2 flex gap-4 md:gap-6 animate-fade-up items-start" style="animation-delay:200ms;animation-fill-mode:both;">
                    <div class="flex-[1.2]">
                        <div class="relative rounded-[1.5rem] md:rounded-[2.5rem] overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.4)] group aspect-[3/4]">
                            <img src="/drifter/amore/interior1.png" alt="Amore 22 Interior Main" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.5rem] md:rounded-[2.5rem] pointer-events-none"></div>
                        </div>
                    </div>
                    <div class="flex-1 flex flex-col gap-4 md:gap-6 mt-8 md:mt-16">
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                            <img src="/drifter/amore/interior2.png" alt="Amore 22 Interior Detail" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                        <div class="relative rounded-[1.2rem] md:rounded-[2rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.4)] group aspect-square">
                            <img src="/drifter/amore/interior3.png" alt="Amore 22 Interior Detail" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                            <div class="absolute inset-0 border border-white/10 rounded-[1.2rem] md:rounded-[2rem] pointer-events-none"></div>
                        </div>
                    </div>
                </div>

                <!-- Text -->
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay:300ms;animation-fill-mode:both;">Interior Elegance</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay:500ms;animation-fill-mode:both;">Features For<br/><span class="text-[#E50000]">Every Explorer.</span></h2>
                    
                    <p class="text-white/60 font-medium md:text-lg leading-relaxed mb-8 animate-fade-up border-l-4 border-[#E50000] pl-6 md:pl-10" style="animation-delay:700ms;animation-fill-mode:both;">
                        The Amore 22 boasts a Meranti timber frame, composite aluminium cladding, and checkerplate protection for unbeatable strength. Generous fresh water supply, a 188L fridge, powerful air conditioning and 20L microwave means comfort wherever you go.
                    </p>
                    
                    <p class="text-white/50 font-medium md:text-base leading-relaxed animate-fade-up" style="animation-delay:900ms;animation-fill-mode:both;">
                        The spacious rear lounge transforms journeys into luxury escapes. With a fully equipped ensuite, separate shower, 2.5kg top-loader washing machine, and cassette toilet, you'll feel pampered at every destination. The layout promotes relaxation after a day's adventure, with open shelving and recessed lighting adding to its contemporary feel.
                    </p>

                    <!-- Feature chips -->
                    <div class="flex flex-wrap gap-3 mt-10 animate-fade-up" style="animation-delay:1000ms;animation-fill-mode:both;">
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">2.5kg Washer</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Meranti Frame</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Diesel Heating</span>
                        <span class="px-5 py-2.5 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-white/70 hover:text-white hover:border-[#E50000]/40 transition-all duration-300">Separate Shower</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 4. THE AMORE GALLERY — Comprehensive Visuals   -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-white">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                <div class="flex flex-col items-center text-center max-w-2xl mx-auto mb-16 gap-6">
                    <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs block">Visual Experience</span>
                    <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none text-black">The <span class="text-[#E50000]">Gallery.</span></h2>
                    <p class="text-black/50 font-medium md:text-lg">Step into the collection. {exteriorImages.length + interiorImages.length} high-resolution snapshots of premium craftsmanship.</p>
                </div>

                <!-- Tab Navigation -->
                <div class="flex items-center justify-center gap-1 sm:gap-4 mb-20 overflow-x-auto no-scrollbar py-2">
                    <button data-cat="exterior" class="gallery-tab active-gallery-tab px-8 py-3.5 rounded-full font-black uppercase tracking-[0.2em] text-[9px] md:text-[11px] transition-all duration-500 border border-black/5">Exterior <span class="ml-2 text-black/50">({exteriorImages.length})</span></button>
                    <button data-cat="interior" class="gallery-tab px-8 py-3.5 rounded-full font-black uppercase tracking-[0.2em] text-[9px] md:text-[11px] transition-all duration-500 border border-black/5">Interior <span class="ml-2 text-black/50">({interiorImages.length})</span></button>
                </div>

                <!-- Gallery Grids -->
                <div class="relative min-h-[800px]">
                    <!-- EXTERIOR GRID -->
                    <div id="gallery-exterior" class="gallery-content visible-gallery grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 transition-all duration-700">
                        {exteriorImages.map((src, i) => (
                            <div class={`relative group overflow-hidden rounded-[2rem] bg-black/5 aspect-square ${i === 0 ? 'lg:col-span-2 lg:row-span-2' : ''}`}>
                                <img src={src} data-src={src} alt={`Amore External ${i + 1}`} loading="lazy" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
                                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                            </div>
                        ))}
                    </div>

                    <!-- INTERIOR GRID -->
                    <div id="gallery-interior" class="gallery-content hidden-gallery grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 transition-all duration-700 absolute inset-0">
                        {interiorImages.map((src, i) => (
                            <div class={`relative group overflow-hidden rounded-[1.5rem] bg-black/5 aspect-square ${i % 7 === 0 ? 'lg:col-span-2 lg:row-span-2' : ''}`}>
                                <img src={src} data-src={src} alt={`Amore Internal ${i + 1}`} loading="lazy" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
                                <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                            </div>
                        ))}
                    </div>


                </div>

                <!-- CTA -->
                <div class="mt-24 pt-20 border-t border-black/5 flex flex-col items-center">
                    <p class="text-black/30 text-[10px] font-bold uppercase tracking-[0.3em] mb-10">Handcrafted detail in every pixel</p>
                    <div class="flex flex-col sm:flex-row gap-6">
                        <a href="/brochures/gthamore.pdf" target="_blank" download class="group relative px-10 py-5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] rounded-full overflow-hidden transition-all duration-300">
                             <div class="absolute inset-0 bg-[#E50000] translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
                             <span class="relative z-10 flex items-center gap-3">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                                Save Collection PDF
                             </span>
                        </a>
                        <a href="#contact" class="px-10 py-5 border border-black/20 text-black font-black uppercase tracking-[0.2em] text-[10px] rounded-full hover:bg-black hover:text-white transition-all duration-500">Book Private Viewing</a>
                    </div>
                </div>
            </div>
        </section>

        <script>
            function initGalleryTabs() {
                const tabs = document.querySelectorAll('.gallery-tab');
                const contents = document.querySelectorAll('.gallery-content');

                tabs.forEach(tab => {
                    tab.addEventListener('click', () => {
                        const target = tab.getAttribute('data-cat');

                        // Reset tabs
                        tabs.forEach(t => t.classList.remove('active-gallery-tab', 'bg-black', 'text-white'));
                        tab.classList.add('active-gallery-tab', 'bg-black', 'text-white');

                        // Switch content
                        contents.forEach(content => {
                            const id = content.getAttribute('id');
                            if (id === `gallery-${target}`) {
                                content.classList.remove('hidden-gallery', 'opacity-0', 'pointer-events-none', 'absolute');
                                content.classList.add('visible-gallery', 'opacity-100', 'z-10', 'relative');
                            } else {
                                content.classList.add('hidden-gallery', 'opacity-0', 'pointer-events-none', 'absolute');
                                content.classList.remove('visible-gallery', 'opacity-100', 'z-10', 'relative');
                            }
                        });
                    });
                });
            }
            initGalleryTabs();
        </script>

        <style>
            .gallery-tab.active-gallery-tab { background: black; color: white; border-color: black; }
            .gallery-tab.active-gallery-tab span { color: rgba(255, 255, 255, 0.5); }
            .hidden-gallery { opacity: 0; transform: translateY(30px); pointer-events: none; visibility: hidden; }
            .visible-gallery { opacity: 1; transform: translateY(0); visibility: visible; }
            .gallery-content { transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
            .no-scrollbar::-webkit-scrollbar { display: none; }
            .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        </style>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 5. 3D LAYOUTS — Architectural View             -->
        <!-- ══════════════════════════════════════════════ -->
        <LayoutSection layouts={layoutImages} title="Premium" subtitle="Space Mastery." />

        <!-- ══════════════════════════════════════════════ -->
        <!-- 6. INTERIOR STYLING — Mood Boards             -->
        <!-- ══════════════════════════════════════════════ -->
        <MoodBoardSection />

        <!-- ══════════════════════════════════════════════ -->
        <!-- 7. SPECIFICATIONS — Tabbed Comparison         -->
        <!-- ══════════════════════════════════════════════ -->

        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                <div class="mb-16">
                    <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-none">Specifications<span class="text-[#E50000]">.</span></h2>
                    <p class="text-black/50 font-medium md:text-lg mt-4 max-w-2xl">Meranti timber and composite aluminium structure combine flexibility and durability for Australian conditions.</p>
                </div>
                
                <div class="flex flex-col lg:flex-row gap-10">
                    <div class="flex flex-row lg:flex-col gap-3 lg:w-[220px] shrink-0">
