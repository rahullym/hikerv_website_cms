---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { Image } from "astro:assets";
import eliteSeries from "../assets/elite-series.png";
---

<Layout title="Elite Series | Hike RV Caravans" description="The pinnacle of caravan engineering. Our Elite Series sets new standards in luxury touring with premium materials and cutting-edge technology.">
    <Navbar />

    <main class="w-full bg-white text-black min-h-screen relative font-sans overflow-hidden">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. HERO SECTION                               -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="elite-hero" class="relative z-10 w-full min-h-[100vh] flex flex-col items-center justify-center text-center overflow-hidden">
            <!-- Background Image -->
            <div class="absolute inset-0 z-0">
                <img src="/elite/armadillo.png" alt="Elite Series Hero" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/60 to-black"></div>
            </div>

            <!-- Luxury Accent Lines -->
            <div class="absolute top-0 left-0 w-full h-[3px] bg-gradient-to-r from-transparent via-[#D4AF37] to-transparent z-20"></div>

            <!-- Hero Content -->
            <div class="relative z-10 flex flex-col items-center px-6 md:px-14 max-w-5xl mx-auto">
                
                <div class="flex items-center justify-center gap-4 sm:gap-6 mb-8 animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">
                    <div class="w-8 sm:w-16 h-px bg-[#D4AF37]/50"></div>
                    <span class="text-[#D4AF37] text-[10px] sm:text-xs font-black uppercase tracking-[0.5em] text-center">
                        Luxury Adventure Range
                    </span>
                    <div class="w-8 sm:w-16 h-px bg-[#D4AF37]/50"></div>
                </div>

                <h1 class="text-white text-5xl md:text-7xl lg:text-[8rem] font-black uppercase tracking-tighter leading-[0.85] mb-8 animate-fade-up drop-shadow-2xl" style="animation-delay: 400ms; animation-fill-mode: both;">
                    Elite <br/>
                    <span class="bg-gradient-to-r from-[#D4AF37] to-[#F5E6A3] bg-clip-text text-transparent">Series.</span>
                </h1>

                <p class="text-white/70 font-medium text-sm md:text-lg tracking-wide max-w-3xl mb-12 leading-relaxed animate-fade-up" style="animation-delay: 600ms; animation-fill-mode: both;">
                    The pinnacle of caravan engineering, our Elite Series sets new standards in luxury touring. Premium materials, cutting-edge technology, and sophisticated design create an unmatched travel experience.
                </p>

                <div class="flex flex-col sm:flex-row items-center gap-5 animate-fade-up" style="animation-delay: 800ms; animation-fill-mode: both;">
                    <a href="#contact" class="px-10 py-4 bg-gradient-to-r from-[#D4AF37] to-[#B8941E] text-black font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:from-white hover:to-white transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(212,175,55,0.3)]">
                        Get a Quote
                    </a>
                    <a href="#models" class="px-10 py-4 border border-[#D4AF37]/40 text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-[#D4AF37] hover:text-black transition-all duration-500 rounded-full backdrop-blur-sm">
                        Explore Models
                    </a>
                </div>
            </div>

            <!-- Scroll Indicator -->
            <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 animate-fade-up" style="animation-delay: 1200ms; animation-fill-mode: both;">
                <span class="text-[#D4AF37]/60 text-[9px] uppercase tracking-[0.3em] font-bold">Scroll</span>
                <div class="w-px h-10 bg-gradient-to-b from-[#D4AF37]/60 to-transparent animate-pulse"></div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. DESCRIPTION + KEY FEATURES                 -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-24 md:py-40 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14 flex flex-col lg:flex-row gap-20">
                
                <!-- Left: Description -->
                <div class="w-full lg:w-1/2 flex flex-col">
                    <span class="text-[#D4AF37] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up" style="animation-delay: 200ms; animation-fill-mode: both;">The Pinnacle</span>
                    <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-10 animate-fade-up" style="animation-delay: 400ms; animation-fill-mode: both;">
                        Unmatched<br/>Luxury.
                    </h2>
                    
                    <p class="text-black/60 font-medium md:text-xl leading-relaxed mb-12 animate-fade-up border-l-4 border-[#D4AF37] pl-6 md:pl-10" style="animation-delay: 600ms; animation-fill-mode: both;">
                        From the finest fixtures to state-of-the-art systems, every element is carefully selected to satisfy the most discerning traveler. The Elite Series combines premium materials, cutting-edge technology, and sophisticated design to create an unmatched travel experience.
                    </p>

                    <div class="w-full h-px bg-black/10 mb-10 animate-fade-up" style="animation-delay: 800ms; animation-fill-mode: both;"></div>

                    <!-- Caravan Image -->
                    <div class="w-full rounded-3xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.08)] animate-fade-up relative" style="animation-delay: 900ms; animation-fill-mode: both;">
                        <Image src={eliteSeries} alt="Elite Series Caravan" class="w-full h-auto object-cover hover:scale-105 transition-transform duration-700" />
                        <!-- Gold accent border -->
                        <div class="absolute inset-0 rounded-3xl border-2 border-[#D4AF37]/20 pointer-events-none"></div>
                    </div>
                </div>

                <!-- Right: Key Features -->
                <div class="w-full lg:w-1/2 flex flex-col justify-center animate-fade-up" style="animation-delay: 600ms; animation-fill-mode: both;">
                    <h3 class="font-black uppercase tracking-widest text-[#D4AF37] mb-10 md:text-lg">Key Features</h3>
                    
                    <div class="flex flex-col gap-5">
                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#D4AF37]/40 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#D4AF37]/10 flex items-center justify-center shrink-0 group-hover:bg-[#D4AF37] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#D4AF37] group-hover:text-black transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">High-End Appliances</span>
                                <span class="text-black/50 text-sm">Premium appliances and designer finishes</span>
                            </div>
                        </div>

                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#D4AF37]/40 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#D4AF37]/10 flex items-center justify-center shrink-0 group-hover:bg-[#D4AF37] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#D4AF37] group-hover:text-black transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Advanced Climate Control</span>
                                <span class="text-black/50 text-sm">Multi-zone climate management system</span>
                            </div>
                        </div>

                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#D4AF37]/40 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#D4AF37]/10 flex items-center justify-center shrink-0 group-hover:bg-[#D4AF37] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#D4AF37] group-hover:text-black transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 20.25h12m-7.5-3v3m3-3v3m-10.125-3h17.25c.621 0 1.125-.504 1.125-1.125V4.875c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125z"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Premium Entertainment</span>
                                <span class="text-black/50 text-sm">State-of-the-art entertainment system</span>
                            </div>
                        </div>

                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#D4AF37]/40 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#D4AF37]/10 flex items-center justify-center shrink-0 group-hover:bg-[#D4AF37] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#D4AF37] group-hover:text-black transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Designer Interior</span>
                                <span class="text-black/50 text-sm">Bespoke interior styling and materials</span>
                            </div>
                        </div>

                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#D4AF37]/40 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#D4AF37]/10 flex items-center justify-center shrink-0 group-hover:bg-[#D4AF37] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#D4AF37] group-hover:text-black transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Superior Insulation</span>
                                <span class="text-black/50 text-sm">Premium insulation for year-round comfort</span>
                            </div>
                        </div>

                        <div class="group flex items-start gap-6 bg-white p-7 rounded-2xl border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] hover:-translate-y-1 hover:border-[#D4AF37]/40 transition-all duration-500">
                            <div class="w-12 h-12 rounded-xl bg-[#D4AF37]/10 flex items-center justify-center shrink-0 group-hover:bg-[#D4AF37] transition-colors duration-500">
                                <svg class="w-6 h-6 text-[#D4AF37] group-hover:text-black transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z"/></svg>
                            </div>
                            <div>
                                <span class="text-sm md:text-base font-black uppercase tracking-wide text-black block mb-1">Smart Technology</span>
                                <span class="text-black/50 text-sm">Latest smart home technology integration</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. ELITE DIFFERENCE BANNER                    -->
        <!-- ══════════════════════════════════════════════ -->
        <section class="relative z-10 w-full py-20 md:py-28 bg-gradient-to-r from-[#111] to-[#1a1a1a] text-white overflow-hidden">
            <!-- Gold accent lines -->
            <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#D4AF37]/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#D4AF37]/40 to-transparent"></div>
            <!-- Gold glow -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[50vw] h-[50vw] max-w-[500px] max-h-[500px] bg-[#D4AF37]/5 rounded-full blur-[120px] pointer-events-none"></div>

            <div class="max-w-4xl mx-auto px-6 md:px-14 text-center relative z-10">
                <span class="text-[#D4AF37] font-black uppercase tracking-[0.5em] text-[10px] md:text-xs mb-6 block">The Elite Difference</span>
                <h2 class="text-3xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-8">
                    Where Engineering<br/>Meets <span class="bg-gradient-to-r from-[#D4AF37] to-[#F5E6A3] bg-clip-text text-transparent">Artistry.</span>
                </h2>
                <p class="text-white/50 font-medium md:text-lg leading-relaxed max-w-2xl mx-auto">
                    Every Elite caravan undergoes rigorous quality control with over 200 inspection points. Our master craftsmen bring decades of experience to every build, ensuring perfection at every level.
                </p>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 4. MODELS SECTION                             -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="models" class="relative z-10 w-full py-24 md:py-40 bg-white">
            <div class="max-w-[1600px] mx-auto px-6 md:px-14">
                <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8">
                    <div class="max-w-2xl">
                        <span class="text-[#D4AF37] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up">Elite Model Range</span>
                        <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none animate-fade-up" style="animation-delay: 200ms;">Explore The<br/><span class="text-[#D4AF37]">Collection.</span></h2>
                    </div>
                    <p class="text-black/50 font-medium md:text-lg max-w-md animate-fade-up" style="animation-delay: 300ms;">
                        The Elite series represents the absolute height of our craft. Discover our flagship models, each designed without compromise.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12 pb-16">
                    
                    <!-- Armadillo -->
                    <div class="group relative rounded-[2rem] overflow-hidden border border-black/5 hover:border-[#D4AF37]/40 transition-all duration-700 hover:-translate-y-2 bg-white shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
                        <div class="w-full h-64 md:h-72 bg-[#f4f4f4] flex items-center justify-center overflow-hidden relative">
                            <img src="/elite/armadillo.png" alt="Armadillo" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                            <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
                            <!-- Gold Badge -->
                            <div class="absolute top-6 right-6 px-4 py-1.5 bg-[#D4AF37] text-black text-[9px] font-black uppercase tracking-widest rounded-full shadow-lg">
                                Flagship
                            </div>
                        </div>
                        <div class="p-8 md:p-10 flex flex-col">
                            <span class="text-[#D4AF37] text-[10px] font-black uppercase tracking-[0.3em] mb-3">Model Armadillo</span>
                            <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight mb-4 text-black">Armadillo</h3>
                            <p class="text-black/50 text-sm font-medium mb-10 leading-relaxed">The ultimate luxury adventure companion for the discerning explorer.</p>
                            <div class="flex items-center justify-between">
                                <a href="/armadillo" class="w-fit px-8 py-3.5 bg-black text-white font-black uppercase tracking-[0.2em] text-[10px] hover:bg-[#D4AF37] hover:text-black transition-all duration-500 rounded-full shadow-md">
                                    Know More
                                </a>
                                <div class="flex gap-2">
                                    <div class="w-1.5 h-1.5 rounded-full bg-[#D4AF37]"></div>
                                    <div class="w-1.5 h-1.5 rounded-full bg-[#D4AF37]/30"></div>
                                    <div class="w-1.5 h-1.5 rounded-full bg-[#D4AF37]/30"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Future models can be added here -->
                    
                </div>
                
                <div class="w-full h-px bg-black/5"></div>
            </div>
        </section>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 5. CTA SECTION                                -->
        <!-- ══════════════════════════════════════════════ -->
        <section id="contact" class="relative z-10 w-full py-24 md:py-32 bg-[#fdfdfd] text-black border-t border-black/5">
            <div class="max-w-3xl mx-auto px-6 md:px-14 text-center">
                <span class="text-[#D4AF37] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block">Experience Luxury</span>
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-none mb-8">
                    Elevate Your<br/>Journey.
                </h2>
                <p class="text-black/60 font-medium md:text-lg leading-relaxed mb-12 max-w-xl mx-auto">
                    Contact our elite advisory team for a private consultation. Discover the bespoke options available to customize your perfect touring companion.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
                    <a href="/#contact" class="px-12 py-5 bg-gradient-to-r from-[#D4AF37] to-[#B8941E] text-black font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:from-black hover:to-black hover:text-[#D4AF37] transition-all duration-500 rounded-full shadow-[0_10px_40px_rgba(212,175,55,0.2)]">
                        Request Consultation
                    </a>
                    <a href="/" class="px-12 py-5 border border-black/20 text-black font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-black hover:text-white transition-all duration-500 rounded-full">
                        Back to Home
                    </a>
                </div>
            </div>
        </section>

    </main>
</Layout>

<style>
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>
