---
/**
 * Reusable image picker modal. Drop the markup on an admin page, then call
 * the global `openImagePicker(targetInputId)` to launch it. The selected
 * image's public URL is written into the input.
 *
 * The modal lazy-loads from /api/images (GET) the first time it opens, so it
 * has zero render cost on pages that never invoke it.
 */
---

<div id="img-picker-root" data-open="false"
  style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 200; align-items: center; justify-content: center; padding: 2rem;">
  <div style="background: #fff; border-radius: 1rem; width: 100%; max-width: 960px; max-height: 90vh; display: flex; flex-direction: column; overflow: hidden;">
    <header style="padding: 1.25rem 1.5rem; border-bottom: 1px solid rgba(0,0,0,0.06); display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
      <h2 style="margin: 0; font-size: 1rem; font-weight: 800;">Pick an image</h2>
      <input id="img-picker-search" type="text" placeholder="Search by filename, alt or tag…" style="flex: 1; max-width: 320px;" />
      <label for="img-picker-upload"
        style="padding: 0.4rem 0.875rem; background: #E50000; color: #fff; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; cursor: pointer;">
        + Upload
        <input id="img-picker-upload" type="file" accept="image/*" multiple style="display: none;" />
      </label>
      <button id="img-picker-close" type="button"
        style="padding: 0.4rem 0.875rem; background: transparent; border: 1px solid rgba(0,0,0,0.12); border-radius: 9999px; font-size: 0.75rem; font-weight: 700;">Close</button>
    </header>
    <div id="img-picker-grid" style="flex: 1; overflow-y: auto; padding: 1.25rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0.75rem;"></div>
    <footer style="padding: 0.875rem 1.5rem; border-top: 1px solid rgba(0,0,0,0.06); display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: rgba(0,0,0,0.5);">
      <span>Click any image to insert its URL. Upload new images from <a href="/admin/images" style="color: #E50000; text-decoration: underline;">/admin/images</a>.</span>
      <span id="img-picker-count"></span>
    </footer>
  </div>
</div>

<script is:inline>
  (function () {
    const root = document.getElementById('img-picker-root');
    const grid = document.getElementById('img-picker-grid');
    const search = document.getElementById('img-picker-search');
    const count = document.getElementById('img-picker-count');
    const closeBtn = document.getElementById('img-picker-close');
    const uploadInput = document.getElementById('img-picker-upload');
    let targetInputId = null;

    async function load(query) {
      grid.innerHTML = '<p style="grid-column: 1 / -1; color: rgba(0,0,0,0.4); padding: 2rem; text-align: center;">Loading…</p>';
      const qs = query ? `?q=${encodeURIComponent(query)}` : '';
      const res = await fetch('/api/images' + qs);
      if (!res.ok) {
        grid.innerHTML = '<p style="grid-column: 1 / -1; color: #c00; padding: 2rem; text-align: center;">Failed to load images.</p>';
        return;
      }
      const data = await res.json();
      const images = data.images || [];
      count.textContent = `${images.length} image${images.length === 1 ? '' : 's'}`;
      if (!images.length) {
        grid.innerHTML = '<p style="grid-column: 1 / -1; color: rgba(0,0,0,0.4); padding: 2rem; text-align: center;">No images match.</p>';
        return;
      }
      grid.innerHTML = images.map((img) => `
        <button type="button" class="img-picker-cell" data-url="${img.url.replace(/"/g, '&quot;')}"
          style="padding: 0; border: 1px solid rgba(0,0,0,0.08); border-radius: 0.5rem; overflow: hidden; background: #fff; cursor: pointer;">
          <div style="width: 100%; aspect-ratio: 1; background: #f0f0f0; overflow: hidden;">
            <img src="${img.url}" alt="${(img.alt || img.filename).replace(/"/g, '&quot;')}" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
          </div>
          <div style="padding: 0.4rem 0.5rem; text-align: left; font-size: 0.7rem; color: rgba(0,0,0,0.6); word-break: break-all;">${img.filename}</div>
        </button>
      `).join('');
      grid.querySelectorAll('.img-picker-cell').forEach((btn) => {
        btn.addEventListener('click', () => {
          const url = btn.dataset.url;
          if (targetInputId) {
            const input = document.getElementById(targetInputId);
            if (input) {
              input.value = url;
              input.dispatchEvent(new Event('input', { bubbles: true }));
              input.dispatchEvent(new Event('change', { bubbles: true }));
            }
          }
          close();
        });
      });
    }

    function open(inputId) {
      targetInputId = inputId;
      root.style.display = 'flex';
      root.dataset.open = 'true';
      load(search.value.trim() || null);
    }
    function close() {
      root.style.display = 'none';
      root.dataset.open = 'false';
    }

    closeBtn.addEventListener('click', close);
    root.addEventListener('click', (e) => { if (e.target === root) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && root.dataset.open === 'true') close(); });

    let searchTimer;
    search.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => load(search.value.trim() || null), 250);
    });

    // Inline upload: presign → PUT to S3 → POST DB record → refresh grid
    async function uploadOne(file) {
      const ps = await fetch('/api/images/presign', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ filename: file.name, contentType: file.type || 'application/octet-stream' }),
      });
      if (!ps.ok) {
        const b = await ps.json().catch(() => ({}));
        throw new Error(b.error || `Presign failed (HTTP ${ps.status})`);
      }
      const { key, uploadUrl, publicUrl } = await ps.json();
      const put = await fetch(uploadUrl, { method: 'PUT', headers: { 'Content-Type': file.type || 'application/octet-stream' }, body: file });
      if (!put.ok) throw new Error(`S3 upload failed (HTTP ${put.status})`);
      const rec = await fetch('/api/images', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key, url: publicUrl, filename: file.name, mime: file.type || 'application/octet-stream', size: file.size }),
      });
      if (!rec.ok) {
        const b = await rec.json().catch(() => ({}));
        throw new Error(b.error || `DB save failed (HTTP ${rec.status})`);
      }
    }
    uploadInput.addEventListener('change', async () => {
      const files = Array.from(uploadInput.files || []);
      if (!files.length) return;
      grid.innerHTML = `<p style="grid-column: 1 / -1; color: rgba(0,0,0,0.4); padding: 2rem; text-align: center;">Uploading ${files.length} image${files.length===1?'':'s'}…</p>`;
      try {
        for (const f of files) await uploadOne(f);
        uploadInput.value = '';
        await load(search.value.trim() || null);
      } catch (err) {
        grid.innerHTML = `<p style="grid-column: 1 / -1; color: #c00; padding: 2rem; text-align: center;">Upload failed: ${err && err.message ? err.message : 'unknown error'}</p>`;
      }
    });

    window.openImagePicker = open;
  })();
</script>
