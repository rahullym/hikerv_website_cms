---
const items = [
    {
        label: "Get a Quote",
        href: "/contact",
        accent: true,
        icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.39 7.36H22l-6.18 4.49L18.21 22 12 17.27 5.79 22l2.39-8.15L2 9.36h7.61z"/></svg>`
    },
    {
        label: "Email Us",
        href: "mailto:info@hikerv.com.au",
        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>`
    },
    {
        label: "Find a Dealer",
        href: "/dealers",
        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.58 7-13a7 7 0 10-14 0c0 5.42 7 13 7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>`
    },
    {
        label: "Facebook",
        href: "https://www.facebook.com/hikervcaravan?mibextid=ZbWKwL",
        external: true,
        icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.9 3.78-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0022 12z"/></svg>`
    },
    {
        label: "YouTube",
        href: "https://youtube.com/@hikervcaravans?si=_jyOU1Pfv64SOOat",
        external: true,
        icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.6 3.6 12 3.6 12 3.6s-7.6 0-9.4.5A3 3 0 00.5 6.2C0 8 0 12 0 12s0 4 .5 5.8a3 3 0 002.1 2.1c1.8.5 9.4.5 9.4.5s7.6 0 9.4-.5a3 3 0 002.1-2.1C24 16 24 12 24 12s0-4-.5-5.8zM9.6 15.6V8.4l6.4 3.6-6.4 3.6z"/></svg>`
    },
    {
        label: "Instagram",
        href: "https://www.instagram.com/hikervcaravans?igsh=dzR4a3VkN3BocmUw",
        external: true,
        icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>`
    },
    {
        label: "TikTok",
        href: "https://www.tiktok.com/@hike.rv.caravans?_r=1&_t=ZS-9634KinG57x",
        external: true,
        icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005.8 20.1a6.34 6.34 0 0010.86-4.43V8.91a8.27 8.27 0 004.83 1.54V7a4.83 4.83 0 01-1.9-.31z"/></svg>`
    }
];
---

<aside
    aria-label="Quick actions"
    class="right-sidebar fixed right-0 top-1/2 z-[55] hidden md:flex flex-col gap-1.5 pr-2"
    style="transform: translateY(-50%);"
>
    {items.map((item) => (
        <a
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            aria-label={item.label}
            class:list={[
                "sidebar-item group/item relative flex items-center justify-end h-11 rounded-l-lg overflow-hidden",
                "transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]",
                "hover:pr-2",
                item.accent ? "bg-[#E50000] text-white hover:bg-[#ff1a1a]" : "bg-black/85 text-white/80 hover:bg-[#E50000] hover:text-white",
                "shadow-[0_4px_14px_rgba(0,0,0,0.3)] backdrop-blur-sm"
            ]}
        >
            <span class="label-text whitespace-nowrap text-[11px] font-black uppercase tracking-[0.18em] max-w-0 opacity-0 group-hover/item:max-w-[180px] group-hover/item:opacity-100 group-hover/item:pl-4 group-hover/item:pr-2 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">
                {item.label}
            </span>
            <span class="shrink-0 w-11 h-11 flex items-center justify-center [&>svg]:w-[18px] [&>svg]:h-[18px]" set:html={item.icon} />
        </a>
    ))}
</aside>

<style>
    @keyframes sidebarIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .right-sidebar {
        animation: sidebarIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1.4s both;
    }
</style>
