---
const features = [
    { title: "100% Australian-Built", desc: "Forged in Victoria. Engineered exclusively with premium local steel to dominate the harsh, demanding outback climate.", image: "/chasis1.png" },
    { title: "Off-Grid Energy Systems", desc: "High-capacity solar arrays and advanced lithium battery management allow for total self-sufficiency in remote locations.", image: "/solar.png" },
    { title: "Heavy-Duty Suspension", desc: "Rugged, independent trailing arm suspension with dual shock absorbers to conquer extreme off-road corrugations.", image: "/suspenison.png" },
    { title: "Precision Craftsmanship", desc: "Impeccably handcrafted by a specialised team, offering absolute flexibility in structural layout and weight distribution.", image: "/craft.png" },
    { title: "Factory-Backed Warranty", desc: "A 2-year manufacturer’s structural warranty stands behind the immense durability of our CNC-cut, interlocking frames.", image: "/approved.png" }
];
---

<section id="machine" class="relative bg-[#fdfdfd] text-black h-[400vh] border-t border-black/5 z-10">
    
    <!-- Blueprint Grid Background Pattern -->
    <div class="absolute inset-0 z-0 pointer-events-none opacity-[0.02]" style="background-image: linear-gradient(#000 1px, transparent 1px), linear-gradient(90deg, #000 1px, transparent 1px); background-size: 60px 60px;"></div>

    <!-- The Sticky Viewport Container -->
    <div class="sticky top-0 h-screen w-full flex flex-col justify-center pb-20 overflow-hidden z-10 gap-8 md:gap-12 pt-24 md:pt-32">
        
        <!-- Persistent Header -->
        <div class="w-full max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-14 text-black flex-shrink-0 z-10 pointer-events-none">
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-[2px] bg-[#E50000]"></div>
                <span class="text-[#E50000] text-[10px] md:text-sm font-black uppercase tracking-[0.4em]">
                    Anatomy of the Machine
                </span>
            </div>
            <h2 class="text-5xl md:text-7xl lg:text-8xl font-black uppercase tracking-tighter leading-[0.85]">
                TECHNICAL<br><span class="text-[#E50000]">SPECS</span>
            </h2>
        </div>

        <!-- The Horizontal Scrolling Track bound to JS -->
        <div id="machine-track" class="flex gap-8 md:gap-12 w-max items-start relative z-20 will-change-transform pr-12 lg:pr-32 pl-[max(1.5rem,calc((100vw-100rem)/2+1.5rem))] sm:pl-[max(2.5rem,calc((100vw-100rem)/2+2.5rem))] lg:pl-[max(3.5rem,calc((100vw-100rem)/2+3.5rem))]">
            
            {features.map((feature, index) => (
                <!-- Clean Interactive Card Block -->
                <div class="shrink-0 w-[85vw] sm:w-[55vw] md:w-[45vw] lg:w-[400px] group flex flex-col relative cursor-pointer">
                    
                    <!-- Floating Clean Image Container -->
                    <div class="w-full aspect-[4/3] rounded-[2rem] overflow-hidden bg-white shadow-[0_15px_40px_rgba(0,0,0,0.02)] border border-black/5 group-hover:shadow-[0_40px_80px_rgba(0,0,0,0.08)] md:group-hover:-translate-y-4 transition-all duration-[800ms] ease-[cubic-bezier(0.16,1,0.3,1)] relative z-10 origin-bottom">
                        {feature.image && (
                            <img 
                                src={feature.image} 
                                alt={feature.title} 
                                class="w-full h-full object-cover p-2 scale-[1.01] group-hover:scale-105 transition-transform duration-[2s] ease-[cubic-bezier(0.16,1,0.3,1)]" 
                            />
                        )}
                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/[0.03] transition-colors duration-700 pointer-events-none"></div>
                    </div>

                    <!-- Separated Clean Typography Beneath -->
                    <div class="w-full mt-6 md:mt-10 px-2 flex flex-col items-start md:opacity-80 md:group-hover:opacity-100 transition-opacity duration-700">
                        
                        <div class="flex items-center gap-4 mb-4 transform translate-y-1 group-hover:translate-y-0 transition-transform duration-[600ms] ease-out">
                            <span class="text-[#E50000] font-mono font-bold text-xs tracking-widest drop-shadow-sm">
                                {(index + 1).toString().padStart(2, '0')}
                            </span>
                            <div class="h-[1px] w-6 bg-[#E50000]/20"></div>
                        </div>

                        <h3 class="text-black text-2xl lg:text-3xl font-black uppercase tracking-tight mb-3 transition-colors duration-500 group-hover:text-[#E50000]">
                            {feature.title}
                        </h3>
                        
                        <p class="text-black/50 text-xs md:text-sm font-semibold max-w-[95%] tracking-wide leading-relaxed transform translate-y-1 group-hover:translate-y-0 transition-transform duration-[600ms] ease-out delay-100">
                            {feature.desc}
                        </p>

                    </div>

                </div>
            ))}
            
            <!-- End Spacer -->
            <div class="w-[10vw] flex-shrink-0"></div>
        </div>
    </div>
</section>

<script>
    function initMachineTrack() {
        const section = document.getElementById('machine');
        const track = document.getElementById('machine-track');
        let ticking = false;

        if (!section || !track) return;

        function updateTrack() {
            if (!section || !track) return;
            const rect = section.getBoundingClientRect();
            const start = rect.top; 
            const totalScroll = section.offsetHeight - window.innerHeight;

            if (start <= 0 && rect.bottom >= window.innerHeight) {
                // We are inside the pinned stick area
                const progress = Math.abs(start) / totalScroll; // 0.0 to 1.0
                const maxTranslate = track.scrollWidth - window.innerWidth;
                
                track.style.transform = `translate3d(-${progress * maxTranslate}px, 0, 0)`;
            } else if (start > 0) {
                // Before section
                track.style.transform = `translate3d(0, 0, 0)`;
            } else if (rect.bottom < window.innerHeight) {
                // After section
                const maxTranslate = track.scrollWidth - window.innerWidth;
                track.style.transform = `translate3d(-${maxTranslate}px, 0, 0)`;
            }

            ticking = false;
        }

        window.addEventListener('scroll', () => {
            if (!ticking) {
                window.requestAnimationFrame(updateTrack);
                ticking = true;
            }
        }, { passive: true });

        // Run once to initialize if loaded mid-page
        updateTrack();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMachineTrack);
    } else {
        initMachineTrack();
    }
</script>
