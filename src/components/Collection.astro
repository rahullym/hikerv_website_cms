---
import { Image } from "astro:assets";
import model01 from "../assets/rover-series.png";
import model02 from "../assets/drifter-series.png";
import model03 from "../assets/elite-series.png";

const models = [
    { id: "01", name: "Rover Series", desc: "The ultimate family adventurer, featuring spacious bunks and safety-first design.", image: "/roverbg.png", link: "/rover", cta: "Explore Series" },
    { id: "02", name: "Drifter Series", desc: "The ultimate balance of agility, precision, and modern style.", image: "/drifterbg.png", link: "/drifter", cta: "Explore Series" },
    { id: "03", name: "Elite Series", desc: "The absolute pinnacle of mobile opulence and craftsmanship.", image: model03, link: "/elite", cta: "Explore Series" },
    { id: "04", name: "Huttle", desc: "Compact freedom on wheels — agile, efficient, ready for the open road.", image: "/huttle/exterior.jpg", link: "/huttle", cta: "Explore Series" },
    { id: "05", name: "Toy Haulers", desc: "Extreme gear capacity meets premium living spaces.", image: "/roverbg.png", link: "/toy-haulers", cta: "Coming Soon" },
];

---

<section id="collection-zoom" class="relative z-20 bg-black h-[1000vh]">
    <div class="sticky top-0 h-screen w-full overflow-hidden bg-black flex items-center justify-center border-t border-black/20 shadow-[0_-40px_100px_rgba(0,0,0,0.8)]">

        <!-- Initial Pure Black Intro Screen -->
        <div id="collection-intro" class="absolute inset-0 z-50 flex flex-col items-center justify-center bg-black">
            <div class="flex flex-col items-center text-center transform -translate-y-8">
                <span class="text-[#E50000] font-black uppercase tracking-[0.5em] text-[10px] md:text-sm mb-5 drop-shadow-2xl">The Collection</span>
                <h2 class="text-white text-5xl md:text-7xl lg:text-[7rem] font-black uppercase tracking-tighter leading-none mb-16 drop-shadow-2xl">
                    The <span class="text-[#E50000]">Lineup.</span>
                </h2>
                
                <!-- Scroll down bouncing indicator -->
                <div class="flex flex-col items-center gap-4 mt-8 opacity-70 animate-bounce">
                    <span class="text-white text-[9px] uppercase tracking-[0.3em] font-bold">Scroll to Explore</span>
                    <div class="w-[1px] h-12 bg-gradient-to-b from-white to-transparent"></div>
                </div>
            </div>
        </div>

        {models.map((model, index) => (
            <div id={`zoom-slide-${index}`} class="absolute inset-0 w-full h-full will-change-transform flex items-center justify-center opacity-0">
                <img 
                    src={typeof model.image === 'string' ? model.image : model.image.src} 
                    alt={model.name} 
                    class="absolute inset-0 w-full h-full object-cover z-0 scale-[1.4] object-center"
                />
                
                <!-- Heavy Vignette to make text pop -->
                <div class="absolute inset-0 z-10 bg-gradient-to-b from-black/80 via-black/30 to-black/90 pointer-events-none"></div>

                <!-- Text Overlay -->
                <div class="relative z-20 flex flex-col items-center justify-center text-center px-6" id={`zoom-text-${index}`}>
                    <h3 class="text-white text-6xl md:text-8xl lg:text-[9rem] font-black uppercase tracking-tighter leading-none mb-6 drop-shadow-[0_10px_30px_rgba(0,0,0,0.5)]">
                        {model.name}
                    </h3>
                    <p class="text-white/80 font-semibold max-w-lg text-sm md:text-lg leading-relaxed drop-shadow-lg mb-10">
                        {model.desc}
                    </p>
                    <a href={model.link} class="group relative px-10 py-5 bg-transparent border border-white/30 text-white font-black uppercase tracking-[0.2em] text-[10px] md:text-xs overflow-hidden transition-all duration-500 hover:border-white hover:shadow-[0_0_30px_rgba(255,255,255,0.1)] rounded-full flex items-center gap-3">
                        <div class="absolute inset-0 bg-white translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-[cubic-bezier(0.19,1,0.22,1)]"></div>
                        <span class="relative z-10 group-hover:text-black transition-colors duration-500">{model.cta}</span>
                        <svg class="relative z-10 w-4 h-4 text-white group-hover:text-black transform -translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                    </a>
                </div>
            </div>
        ))}
    </div>
</section>

<script>
    function initZoomGallery() {
        const section = document.getElementById('collection-zoom');
        const intro = document.getElementById('collection-intro');
        if (!section) return;

        // Get all slides and texts dynamically
        const slideElements = section.querySelectorAll('[id^="zoom-slide-"]');
        const textElements = section.querySelectorAll('[id^="zoom-text-"]');
        const numModels = slideElements.length;
        const totalPhases = numModels * 2;
        const phaseSize = 1 / totalPhases;

        let ticking = false;

        function updateGallery() {
            const rect = section!.getBoundingClientRect();
            const start = rect.top;
            const totalScroll = section!.offsetHeight - window.innerHeight;

            if (start <= 0 && rect.bottom >= window.innerHeight) {
                const progress = Math.min(Math.max(Math.abs(start) / totalScroll, 0), 0.999);
                const currentPhase = Math.floor(progress / phaseSize);
                const localProg = (progress % phaseSize) / phaseSize;

                // Handle Intro
                if (currentPhase === 0) {
                    if (intro) {
                        intro.style.opacity = `${1 - localProg}`;
                        intro.style.transform = `scale(${1 + localProg * 0.1})`;
                        intro.style.pointerEvents = localProg > 0.9 ? 'none' : 'auto';
                    }
                } else if (intro) {
                    intro.style.opacity = '0';
                    intro.style.pointerEvents = 'none';
                }

                // Handle Slides
                slideElements.forEach((slide: any, idx) => {
                    const text = textElements[idx] as HTMLElement;
                    
                    // Each model has two phases: Transition In (if not first), Hold, Transition Out (if not last)
                    // Wait, let's simplify:
                    // Phase 0: Intro -> S0 transition
                    // Phase 1: S0 Hold
                    // Phase 2: S0 -> S1 transition
                    // Phase 3: S1 Hold
                    // ...and so on
                    
                    const enterPhase = idx * 2;
                    const holdPhase = idx * 2 + 1;
                    const exitPhase = idx * 2 + 2;

                    if (currentPhase === enterPhase) {
                        // Transitions in
                        slide.style.opacity = idx === 0 ? '1' : `${localProg}`;
                        slide.style.transform = idx === 0 ? `scale(${1.2 - (localProg * 0.2)})` : `scale(${1.2 - (localProg * 0.2)})`;
                        slide.style.pointerEvents = (idx === 0 || localProg > 0.5) ? 'auto' : 'none';
                        if (text) text.style.transform = idx === 0 ? 'translateY(0)' : `translateY(${(1 - localProg) * 80}px)`;
                    } 
                    else if (currentPhase === holdPhase) {
                        // Holds
                        slide.style.opacity = '1';
                        slide.style.transform = 'scale(1)';
                        slide.style.pointerEvents = 'auto';
                        if (text) text.style.transform = 'translateY(0)';
                    }
                    else if (currentPhase === exitPhase) {
                        // Transitions out
                        slide.style.opacity = `${1 - localProg}`;
                        slide.style.transform = `scale(${1 - (localProg * 0.2)})`;
                        slide.style.pointerEvents = localProg < 0.5 ? 'auto' : 'none';
                        if (text) text.style.transform = `translateY(${localProg * -80}px)`;
                    }
                    else {
                        // Hidden
                        slide.style.opacity = '0';
                        slide.style.pointerEvents = 'none';
                    }
                });

            } else if (start > 0) {
                if (intro) {
                    intro.style.opacity = '1';
                    intro.style.transform = 'scale(1)';
                    intro.style.pointerEvents = 'auto';
                }
                slideElements.forEach((s: any) => s.style.opacity = '0');
            } else if (rect.bottom < window.innerHeight) {
                if (intro) intro.style.opacity = '0';
                slideElements.forEach((s: any, idx) => {
                    if (idx === numModels - 1) {
                        s.style.opacity = '1';
                        s.style.transform = 'scale(1)';
                    } else {
                        s.style.opacity = '0';
                    }
                });
            }

            ticking = false;
        }

        window.addEventListener('scroll', () => {
            if (!ticking) {
                window.requestAnimationFrame(updateGallery);
                ticking = true;
            }
        }, { passive: true });

        // Run once
        updateGallery();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initZoomGallery);
    } else {
        initZoomGallery();
    }
</script>
