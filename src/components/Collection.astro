---
import { Image } from "astro:assets";
import model01 from "../assets/rover-series.png";
import model02 from "../assets/drifter-series.png";
import model03 from "../assets/elite-series.png";

const models = [
    { id: "01", name: "Rover Series", desc: "Rugged durability meets uncompromised internal luxury.", image: "/roverbg.png", link: "/rover" },
    { id: "02", name: "Drifter Series", desc: "The ultimate balance of agility, precision, and modern style.", image: "/drifterbg.png", link: "/drifter" },
    { id: "03", name: "Elite Series", desc: "The absolute pinnacle of mobile opulence and craftsmanship.", image: model03, link: "/elite" },
];
---

<section id="collection-zoom" class="relative z-20 bg-black h-[800vh]">
    <div class="sticky top-0 h-screen w-full overflow-hidden bg-black flex items-center justify-center border-t border-black/20 shadow-[0_-40px_100px_rgba(0,0,0,0.8)]">

        <!-- Initial Pure Black Intro Screen -->
        <div id="collection-intro" class="absolute inset-0 z-50 flex flex-col items-center justify-center bg-black">
            <div class="flex flex-col items-center text-center transform -translate-y-8">
                <span class="text-[#E50000] font-black uppercase tracking-[0.5em] text-[10px] md:text-sm mb-5 drop-shadow-2xl">The Collection</span>
                <h2 class="text-white text-5xl md:text-7xl lg:text-[7rem] font-black uppercase tracking-tighter leading-none mb-16 drop-shadow-2xl">
                    The <span class="text-[#E50000]">Lineup.</span>
                </h2>
                
                <!-- Scroll down bouncing indicator -->
                <div class="flex flex-col items-center gap-4 mt-8 opacity-70 animate-bounce">
                    <span class="text-white text-[9px] uppercase tracking-[0.3em] font-bold">Scroll to Explore</span>
                    <div class="w-[1px] h-12 bg-gradient-to-b from-white to-transparent"></div>
                </div>
            </div>
        </div>

        {models.map((model, index) => (
            <div id={`zoom-slide-${index}`} class="absolute inset-0 w-full h-full will-change-transform flex items-center justify-center opacity-0">
                <img 
                    src={typeof model.image === 'string' ? model.image : model.image.src} 
                    alt={model.name} 
                    class="absolute inset-0 w-full h-full object-cover z-0"
                />
                
                <!-- Heavy Vignette to make text pop -->
                <div class="absolute inset-0 z-10 bg-gradient-to-b from-black/80 via-black/30 to-black/90 pointer-events-none"></div>

                <!-- Text Overlay -->
                <div class="relative z-20 flex flex-col items-center justify-center text-center px-6" id={`zoom-text-${index}`}>
                    <h3 class="text-white text-6xl md:text-8xl lg:text-[9rem] font-black uppercase tracking-tighter leading-none mb-6 drop-shadow-[0_10px_30px_rgba(0,0,0,0.5)]">
                        {model.name}
                    </h3>
                    <p class="text-white/80 font-semibold max-w-lg text-sm md:text-lg leading-relaxed drop-shadow-lg mb-10">
                        {model.desc}
                    </p>
                    <a href={model.link} class="group relative px-10 py-4 bg-transparent border border-white/50 text-white font-bold uppercase tracking-widest text-[10px] md:text-xs hover:bg-white hover:border-white hover:text-black transition-all duration-500 rounded-full">
                        <span>Explore Series</span>
                    </a>
                </div>
            </div>
        ))}
    </div>
</section>

<script>
    function initZoomGallery() {
        const section = document.getElementById('collection-zoom');
        const intro = document.getElementById('collection-intro');
        if (!section) return;

        const slides = [
            document.getElementById('zoom-slide-0'),
            document.getElementById('zoom-slide-1'),
            document.getElementById('zoom-slide-2')
        ];

        const texts = [
            document.getElementById('zoom-text-0'),
            document.getElementById('zoom-text-1'),
            document.getElementById('zoom-text-2')
        ];

        let ticking = false;

        function updateGallery() {
            const rect = section!.getBoundingClientRect();
            const start = rect.top;
            const totalScroll = section!.offsetHeight - window.innerHeight;

            if (start <= 0 && rect.bottom >= window.innerHeight) {
                const progress = Math.abs(start) / totalScroll; // 0.0 to 1.0

                // Phase 0: Intro leaves, Slide 0 enters (0.00 -> 0.166)
                if (progress <= 0.166) {
                    const localProg = progress / 0.166; 
                    
                    if (intro) {
                        intro.style.opacity = `${1 - localProg}`;
                        intro.style.transform = `scale(${1 + localProg * 0.1})`;
                    }
                    
                    if (slides[0]) slides[0].style.transform = `scale(${1.2 - (localProg * 0.2)})`;
                    if (slides[0]) slides[0].style.opacity = `${localProg}`;
                    if (texts[0]) texts[0].style.transform = `translateY(${(1 - localProg) * 80}px)`;

                    if (slides[1]) slides[1].style.opacity = '0';
                    if (slides[2]) slides[2].style.opacity = '0';
                } 
                // Phase 1: Hold Slide 0 (0.166 -> 0.333) [Exactly 1 Scroll]
                else if (progress > 0.166 && progress <= 0.333) {
                    if (intro) intro.style.opacity = '0';

                    if (slides[0]) slides[0].style.transform = `scale(1.0)`;
                    if (slides[0]) slides[0].style.opacity = `1`;
                    if (texts[0]) texts[0].style.transform = `translateY(0px)`;

                    if (slides[1]) slides[1].style.opacity = '0';
                    if (slides[2]) slides[2].style.opacity = '0';
                }
                // Phase 2: Slide 0 leaves, Slide 1 enters (0.333 -> 0.500) [Slow Transition]
                else if (progress > 0.333 && progress <= 0.500) {
                    const localProg = (progress - 0.333) / 0.166; 
                    
                    if (intro) intro.style.opacity = '0';

                    if (slides[0]) slides[0].style.transform = `scale(${1 - (localProg * 0.2)})`;
                    if (slides[0]) slides[0].style.opacity = `${1 - localProg}`;
                    if (texts[0]) texts[0].style.transform = `translateY(${localProg * -80}px)`;

                    if (slides[1]) slides[1].style.transform = `scale(${1.2 - (localProg * 0.2)})`;
                    if (slides[1]) slides[1].style.opacity = `${localProg}`;
                    if (texts[1]) texts[1].style.transform = `translateY(${(1 - localProg) * 80}px)`;
                    
                    if (slides[2]) slides[2].style.opacity = '0';
                } 
                // Phase 3: Hold Slide 1 (0.500 -> 0.666) [Exactly 1 Scroll]
                else if (progress > 0.500 && progress <= 0.666) {
                    if (intro) intro.style.opacity = '0';
                    if (slides[0]) slides[0].style.opacity = '0';

                    if (slides[1]) slides[1].style.transform = `scale(1.0)`;
                    if (slides[1]) slides[1].style.opacity = `1`;
                    if (texts[1]) texts[1].style.transform = `translateY(0px)`;

                    if (slides[2]) slides[2].style.opacity = '0';
                }
                // Phase 4: Slide 1 leaves, Slide 2 enters (0.666 -> 0.833) [Slow Transition]
                else if (progress > 0.666 && progress <= 0.833) {
                    const localProg = (progress - 0.666) / 0.166; 
                    
                    if (intro) intro.style.opacity = '0';
                    if (slides[0]) slides[0].style.opacity = '0';

                    if (slides[1]) slides[1].style.transform = `scale(${1 - (localProg * 0.2)})`;
                    if (slides[1]) slides[1].style.opacity = `${1 - localProg}`;
                    if (texts[1]) texts[1].style.transform = `translateY(${localProg * -80}px)`;

                    if (slides[2]) slides[2].style.transform = `scale(${1.2 - (localProg * 0.2)})`;
                    if (slides[2]) slides[2].style.opacity = `${localProg}`;
                    if (texts[2]) texts[2].style.transform = `translateY(${(1 - localProg) * 80}px)`;
                } 
                // Phase 5: Hold Slide 2 (0.833 -> 1.000) [Exactly 1 Scroll]
                else {
                    if (intro) intro.style.opacity = '0';
                    if (slides[0]) slides[0].style.opacity = '0';
                    if (slides[1]) slides[1].style.opacity = '0';

                    if (slides[2]) slides[2].style.transform = `scale(1.0)`;
                    if (slides[2]) slides[2].style.opacity = `1`;
                    if (texts[2]) texts[2].style.transform = `translateY(0px)`;
                }

            } else if (start > 0) {
                // Completely Before section
                if (intro) {
                    intro.style.opacity = '1';
                    intro.style.transform = 'scale(1)';
                }
                if (slides[0]) slides[0].style.opacity = '0';
                if (slides[1]) slides[1].style.opacity = '0';
                if (slides[2]) slides[2].style.opacity = '0';
            } else if (rect.bottom < window.innerHeight) {
                // Completely After section
                if (intro) intro.style.opacity = '0';
                if (slides[0]) slides[0].style.opacity = '0';
                if (slides[1]) slides[1].style.opacity = '0';
                if (slides[2]) {
                    slides[2].style.transform = `scale(1)`;
                    slides[2].style.opacity = '1';
                }
                if (texts[2]) texts[2].style.transform = `translateY(0px)`;
            }

            ticking = false;
        }

        window.addEventListener('scroll', () => {
            if (!ticking) {
                window.requestAnimationFrame(updateGallery);
                ticking = true;
            }
        }, { passive: true });

        // Run once
        updateGallery();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initZoomGallery);
    } else {
        initZoomGallery();
    }
</script>
