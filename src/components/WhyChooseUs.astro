---

<section id="why-choose-scroll" class="relative z-10 w-full h-[300vh] bg-[#fcfcfc] border-t border-black/5">
    
    <!-- Sticky Full Viewport Block -->
    <div class="sticky top-0 h-screen w-full flex items-center overflow-hidden">
        <div class="max-w-[1500px] mx-auto w-full flex flex-col md:flex-row items-center justify-between px-6 sm:px-10 lg:px-14 relative z-10">
            
            <!-- Left Header -->
            <div class="md:w-[40%] flex flex-col justify-center pb-12 md:pb-0 z-20 relative">
                <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-6 block">The Hike RV Difference</span>
                <h2 class="text-black text-5xl md:text-6xl lg:text-[6rem] font-black uppercase tracking-tighter leading-[0.9] mb-8">
                    Why<br />
                    <span class="text-[#E50000]">Choose Us?</span>
                </h2>
                <p class="text-black/60 font-semibold text-sm md:text-base leading-relaxed max-w-sm border-l-2 border-[#E50000] pl-6 py-2">
                    Hike RV Caravans enhancing your travels. Elevate your journey with us!
                </p>
            </div>

            <!-- Right Scrub Swap Container -->
            <div class="md:w-[50%] relative h-[400px] md:h-[600px] flex items-center w-full z-10">
                
                <!-- View 1: Stats Grid -->
                <div class="absolute inset-x-0 w-full will-change-transform will-change-opacity" id="wcu-stats-slide" style="opacity: 1; transform: translateY(0);">
                    <div class="grid grid-cols-2 gap-x-8 md:gap-x-16 gap-y-16 md:gap-y-24">
                        {stats.map((stat) => (
                            <div class="flex flex-col items-start">
                                <Fragment set:html={stat.icon} />
                                <div class="flex items-center text-black mb-3">
                                    <span class="text-6xl lg:text-[5.5rem] font-black tracking-tighter leading-none wcu-number drop-shadow-sm" data-target={stat.number} data-format={stat.display}>0</span>
                                    {stat.suffix && <span class="text-[#E50000] text-6xl lg:text-[5.5rem] font-black tracking-tighter leading-none drop-shadow-sm ml-1">{stat.suffix}</span>}
                                </div>
                                <span class="text-black/40 text-[10px] md:text-xs font-bold uppercase tracking-[0.2em]">{stat.label}</span>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- View 2: Trust Factors -->
                <div class="absolute inset-x-0 w-full will-change-transform will-change-opacity pointer-events-none" id="wcu-trust-slide" style="opacity: 0; transform: translateY(40px);">
                    <div class="flex flex-col gap-12 lg:gap-16 relative">
                        
                        <!-- Timeline track -->
                        <div class="absolute left-[-2px] md:left-[3px] top-4 bottom-8 w-[2px] bg-black/5"></div>

                        {pillars.map((pillar, i) => (
                            <div class="flex flex-col md:flex-row md:items-start gap-4 md:gap-8 relative z-10 pl-6 md:pl-10">
                                
                                <!-- Dot Marker -->
                                <div class="absolute left-[-7px] md:left-[-2px] top-2 w-3 h-3 rounded-full bg-[#E50000] shadow-[0_0_0_6px_#fcfcfc]"></div>
                                
                                <div class="flex flex-col">
                                    <div class="flex items-center gap-4 mb-2 md:mb-4">
                                        <Fragment set:html={pillar.icon} />
                                        <h3 class="text-2xl md:text-3xl font-black uppercase tracking-tight text-black">
                                            {pillar.title}
                                        </h3>
                                    </div>
                                    <p class="text-black/50 text-sm md:text-base font-medium leading-relaxed max-w-sm">
                                        {pillar.desc}
                                    </p>
                                </div>

                            </div>
                        ))}
                    </div>
                </div>

            </div>
        </div>
        
        <!-- Subtle Scroll Indicator -->
        <div class="absolute bottom-12 left-1/2 transform -translate-x-1/2 flex flex-col items-center gap-3 opacity-30 select-none hidden md:flex">
            <span class="text-[10px] font-bold uppercase tracking-widest text-black">Keep Scrolling</span>
            <div class="w-[1px] h-12 bg-black/50 overflow-hidden relative">
                <div class="absolute top-0 left-0 w-full h-1/2 bg-black animate-slideDown"></div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const section = document.getElementById('why-choose-scroll');
        const statsSlide = document.getElementById('wcu-stats-slide');
        const trustSlide = document.getElementById('wcu-trust-slide');
        const counters = document.querySelectorAll('.wcu-number');
        
        let countersFired = false;

        function fireCounters() {
            counters.forEach((num) => {
                const targetVal = parseFloat(num.getAttribute('data-target') || '0');
                const targetStr = num.getAttribute('data-format') || '';
                const duration = 800; // Dramatically faster spin-up
                let start: number | null = null;
                
                function animate(time: number) {
                    if (start === null) start = time;
                    const elapsed = time - start;
                    const progress = Math.min(elapsed / duration, 1);
                    
                    // Snappy easeOutQuad
                    const easeOut = 1 - (1 - progress) * (1 - progress);
                    const current = Math.floor(targetVal * easeOut);
                    
                    if (targetStr.includes(',')) num.textContent = current.toLocaleString();
                    else num.textContent = current.toString();

                    if (progress < 1) {
                        requestAnimationFrame(animate);
                    } else {
                        num.textContent = targetStr;
                    }
                }
                requestAnimationFrame(animate);
            });
        }

        function updateWCU() {
            if (!section || !statsSlide || !trustSlide) return;
            const rect = section.getBoundingClientRect();
            const start = rect.top;
            const totalScroll = section.offsetHeight - window.innerHeight;
            
            if (start <= 0 && start >= -totalScroll) {
                const progress = Math.abs(start) / totalScroll;
                
                // Fire counters precisely when they lock into the screen
                if (progress > 0.05 && !countersFired) {
                    countersFired = true;
                    fireCounters();
                }

                // Scrubbing logic: 
                // 0.0 -> 0.4: Hold Stats
                // 0.4 -> 0.6: Crossfade Transform
                // 0.6 -> 1.0: Hold Trust Factors
                if (progress <= 0.4) {
                    statsSlide.style.opacity = '1';
                    statsSlide.style.transform = 'translateY(0)';
                    statsSlide.style.pointerEvents = 'auto';

                    trustSlide.style.opacity = '0';
                    trustSlide.style.transform = 'translateY(40px)';
                    trustSlide.style.pointerEvents = 'none';
                } else if (progress >= 0.6) {
                    statsSlide.style.opacity = '0';
                    statsSlide.style.transform = 'translateY(-40px)';
                    statsSlide.style.pointerEvents = 'none';

                    trustSlide.style.opacity = '1';
                    trustSlide.style.transform = 'translateY(0)';
                    trustSlide.style.pointerEvents = 'auto';
                } else {
                    const localProg = (progress - 0.4) / 0.2; // mapping 0.4->0.6 into 0.0->1.0
                    
                    statsSlide.style.opacity = `${parseFloat((1 - localProg).toFixed(4))}`;
                    statsSlide.style.transform = `translateY(${-(localProg * 60)}px)`; // aggressive drift up
                    statsSlide.style.pointerEvents = 'none';

                    trustSlide.style.opacity = `${parseFloat(localProg.toFixed(4))}`;
                    trustSlide.style.transform = `translateY(${60 - (localProg * 60)}px)`; // aggressive drift up from bottom
                    trustSlide.style.pointerEvents = 'none';
                }
            } else if (start > 0) {
                // Before mapping
                statsSlide.style.opacity = '1';
                statsSlide.style.transform = 'translateY(0)';
                trustSlide.style.opacity = '0';
                trustSlide.style.transform = 'translateY(40px)';
            } else if (start < -totalScroll) {
                // After mapping
                statsSlide.style.opacity = '0';
                statsSlide.style.transform = 'translateY(-40px)';
                trustSlide.style.opacity = '1';
                trustSlide.style.transform = 'translateY(0)';
            }
        }

        window.addEventListener('scroll', () => requestAnimationFrame(updateWCU), { passive: true });
        updateWCU(); // trigger immediately on mount
    });
</script>
