<section class="relative w-full h-[100svh] min-h-[600px] flex items-center justify-center overflow-hidden bg-black" id="hero">
    
    <!-- ░░ Background ░░ -->
    <div class="absolute inset-0 z-0">
        <video 
            preload="none"
            data-lazy-video
            autoplay 
            muted 
            loop 
            playsinline 
            class="w-full h-full object-cover object-center translate-z-0 filter contrast-[1.15] brightness-[0.85] saturate-[1.1]"
        >
            <source data-src="/herobgvideo.mp4" type="video/mp4" />
        </video>
        <!-- Pixelation Correction: Grain & Soft Blur Overlay -->
        <div class="absolute inset-0 z-10 opacity-60 bg-[radial-gradient(circle_at_center,_transparent_0%,_black_100%),url('https://grainy-gradients.vercel.app/noise.svg')] mix-blend-overlay backdrop-blur-[1px] pointer-events-none"></div>
        <!-- Clean Modern Vignette -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/30 to-black/90"></div>
    </div>

    <!-- ░░ Content ░░ -->
    <div class="relative z-10 flex flex-col items-center text-center px-6 mb-12 md:mb-16 lg:mb-20 mt-16 md:mt-0 translate-y-12">
        
        <div class="flex items-center justify-center gap-4 sm:gap-6 mb-6 animate-fade-up anim-delay-200 anim-fill-both">
            <div class="w-8 sm:w-16 h-px bg-white"></div>
            <span class="text-white text-[10px] sm:text-xs font-black uppercase tracking-[0.5em] text-center">
                The Pinnacle of Mobile Living
            </span>
            <div class="w-8 sm:w-16 h-px bg-white"></div>
        </div>
        
        <h1 class="text-white text-5xl md:text-8xl lg:text-[10rem] font-black uppercase tracking-tighter leading-[0.85] mb-8 animate-fade-up anim-delay-400 anim-fill-both">
            Engineered <br/>
            <span class="text-white/40">for the</span> <span class="text-[#E50000]">Wild.</span>
        </h1>
        
        <p class="text-white/70 font-semibold text-sm md:text-lg tracking-wide max-w-xl animate-fade-up anim-delay-600 anim-fill-both">
            Where uncompromising engineering meets untamed terrain.
        </p>

        <!-- Minimal Luxury Scroll Anchor -->
        <div class="mt-12 mb-6 flex flex-col items-center gap-6 opacity-40 animate-fade-up anim-delay-1200 anim-fill-both">
            <span class="text-white text-[9px] uppercase tracking-[0.8em] font-light">Explore</span>
            <div class="w-[1px] h-12 bg-gradient-to-b from-white to-transparent animate-pulse-slow"></div>
        </div>

    </div>

    <!-- ░░ Bottom Strip (Logos) ░░ -->
    <div class="absolute bottom-10 left-0 w-full z-10 flex flex-col items-center px-6 animate-fade-up anim-delay-800 anim-fill-both">
        <span class="text-white/30 text-[9px] md:text-[11px] font-black uppercase tracking-[0.4em] mb-6">Featured Across</span>
        
        <!-- Mobile: 4×2 grid so all 8 logos remain visible. Desktop: single inline row. -->
        <div class="w-full max-w-[1200px] grid grid-cols-4 md:flex md:flex-wrap md:justify-between items-center gap-x-3 sm:gap-x-6 gap-y-4 opacity-60 hover:opacity-100 transition-opacity duration-1000">
            <img src="/featuredlogos/logo1.webp" alt="Featured in publication logo" width="400" height="92" loading="lazy" class="h-4 sm:h-6 md:h-7 object-contain mx-auto md:mx-0 logo-invert" />
            <img src="/featuredlogos/logo13.webp" alt="Featured in publication logo" width="232" height="88" loading="lazy" class="h-4 sm:h-6 md:h-7 object-contain mx-auto md:mx-0 logo-invert" />
            <img src="/featuredlogos/logo15.webp" alt="Featured in publication logo" width="362" height="88" loading="lazy" class="h-4 sm:h-6 md:h-7 object-contain mx-auto md:mx-0 logo-invert" />
            <img src="/featuredlogos/logo189.webp" alt="Featured in publication logo" width="362" height="88" loading="lazy" class="h-4 sm:h-6 md:h-7 object-contain mx-auto md:mx-0 logo-invert" />
            <img src="/featuredlogos/redarc.webp" alt="Redarc" width="600" height="103" loading="lazy" class="h-4 sm:h-6 md:h-7 object-contain mx-auto md:mx-0" />
            <img src="/featuredlogos/victron.webp" alt="Victron Energy" width="600" height="179" loading="lazy" class="h-4 sm:h-6 md:h-7 object-contain mx-auto md:mx-0" />
            <img src="/featuredlogos/tuffride.webp" alt="Tuffride" width="600" height="337" loading="lazy" class="h-6 sm:h-9 md:h-11 object-contain mx-auto md:mx-0" />
            <img src="/featuredlogos/cruisemaster.webp" alt="Cruisemaster" width="600" height="480" loading="lazy" class="h-6 sm:h-9 md:h-11 object-contain mx-auto md:mx-0" />
        </div>
    </div>

</section>

<script>
    // Defer the 4.6 MB background video until the page has loaded and the browser is idle,
    // and skip it entirely for data-saver / reduced-motion users.
    const video = document.querySelector<HTMLVideoElement>('video[data-lazy-video]');
    const conn = (navigator as any).connection;
    const skip = matchMedia('(prefers-reduced-motion: reduce)').matches || conn?.saveData;
    if (video && !skip) {
        const start = () => {
            const src = video.querySelector<HTMLSourceElement>('source[data-src]');
            if (!src) return;
            src.src = src.dataset.src!;
            video.load();
            video.play().catch(() => {});
        };
        const whenLoaded = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(start, { timeout: 3000 }) : setTimeout(start, 1500));
        if (document.readyState === 'complete') whenLoaded();
        else window.addEventListener('load', whenLoaded, { once: true });
    }
</script>

<style>
    /* Simplistic but incredibly premium animations natively hooked into CSS */
    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(40px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    @keyframes slowZoom {
        from { transform: scale(1.1); }
        to { transform: scale(1); }
    }

    .animate-fade-up {
        animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes pulse-slow {
        0%, 100% { opacity: 0.2; transform: translateY(0); }
        50% { opacity: 1; transform: translateY(10px); }
    }

    .animate-pulse-slow {
        animation: pulse-slow 3s ease-in-out infinite;
    }
</style>
