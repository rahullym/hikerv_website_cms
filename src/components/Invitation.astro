---

<section id="contact" class="bg-[#0a0a0a] relative overflow-hidden py-40 md:py-64 px-6 sm:px-10 lg:px-14 w-full">
    
    <!-- Immersive Cinematic Center Glow -->
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[300px] md:w-[600px] lg:w-[1000px] h-[300px] md:h-[600px] lg:h-[1000px] bg-[#E50000]/10 blur-[100px] md:blur-[150px] rounded-full pointer-events-none"></div>
    
    <!-- Massive Watermark Text -->
    <h2 class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-[12rem] md:text-[20rem] lg:text-[40rem] font-black text-white/[0.02] tracking-tighter mix-blend-overlay pointer-events-none select-none w-full text-center">
        HIKE
    </h2>

    <div class="max-w-[1400px] mx-auto w-full flex flex-col items-center justify-center text-center relative z-10">
        
        <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-sm mb-8 block">
            The Invitation
        </span>
        
        <h3 class="text-white text-5xl md:text-7xl lg:text-[9rem] xl:text-[11rem] font-black uppercase tracking-tighter leading-[0.85] mb-10 md:mb-16 drop-shadow-2xl">
            Begin Your<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#E50000] to-[#ff4d4d]">Journey</span>
        </h3>
        
        <p class="text-white/50 text-sm md:text-lg lg:text-xl font-semibold leading-relaxed max-w-2xl mx-auto mb-16 md:mb-24">
            Experience the pinnacle of mobile living. Schedule a private consultation or visit our engineering facility in Campbellfield to craft your custom sanctuary.
        </p>

        <!-- Magnetic Premium Button -->
        <a href="/contact" class="group relative inline-flex items-center justify-center bg-[#E50000] text-white px-10 md:px-16 py-5 md:py-6 lg:py-7 rounded-full font-black uppercase text-xs md:text-sm tracking-[0.2em] overflow-hidden transition-all duration-500 hover:scale-105 hover:shadow-[0_0_40px_rgba(229,0,0,0.4)] ring-1 ring-[#E50000]/50">
            <span class="relative z-10 transition-transform duration-500 ease-[cubic-bezier(0.19,1,0.22,1)] group-hover:-translate-y-[250%] block">Contact an Advisor</span>
            
            <div class="absolute inset-0 bg-white translate-y-[100%] group-hover:translate-y-0 transition-transform duration-500 ease-[cubic-bezier(0.19,1,0.22,1)] rounded-full"></div>
            
            <span class="absolute inset-0 z-20 text-[#E50000] translate-y-[100%] group-hover:translate-y-0 transition-transform duration-500 ease-[cubic-bezier(0.19,1,0.22,1)] flex items-center justify-center gap-3">
                <span>Start Building</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </span>
        </a>

    </div>
</section>
