---
interface LayoutItem {
  title: string;
  desc: string;
  src: string;
}

interface Props {
  layouts: LayoutItem[];
  title?: string;
  subtitle?: string;
}

const {
  layouts,
  title = "Intelligent",
  subtitle = "Space Mapping."
} = Astro.props;
---

<section class="relative z-10 w-full py-24 md:py-40 bg-white text-black overflow-hidden border-t border-black/5">
    <!-- Background elements -->
    <div class="absolute top-0 left-0 w-full h-full opacity-40 pointer-events-none">
        <div class="absolute top-0 left-[10%] w-px h-full bg-gradient-to-b from-transparent via-black/10 to-transparent"></div>
        <div class="absolute top-0 right-[10%] w-px h-full bg-gradient-to-b from-transparent via-black/10 to-transparent"></div>
    </div>

    <div class="max-w-[1600px] mx-auto px-6 md:px-14">
        <div class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8">
            <div class="max-w-xl">
                <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up">3D Floorplans</span>
                <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none animate-fade-up">
                    {title}<br/><span class="text-[#E50000]">{subtitle}</span>
                </h2>
            </div>
            <p class="text-black/50 font-medium md:text-lg max-w-sm border-l border-black/10 pl-8 py-2 animate-fade-up">
                Experience the architectural flow and spatial optimization of our custom layouts.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 items-center">
            <!-- Large Display Area (2/3 width on desktop) -->
            <div class="relative group aspect-[16/10] bg-white rounded-[2.5rem] border border-black/10 overflow-hidden flex items-center justify-center p-4 md:p-6 order-2 lg:order-1 lg:col-span-2 shadow-[0_30px_80px_rgba(0,0,0,0.08)]">
                {layouts.map((layout, i) => (
                    <img
                        src={layout.src}
                        alt={layout.title}
                        id={`layout-img-${i}`}
                        class={`layout-preview-img absolute inset-0 w-full h-full object-contain p-4 md:p-6 transition-all duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] ${i === 0 ? 'opacity-100 scale-100 translate-y-0' : 'opacity-0 scale-95 translate-y-8 pointer-events-none'}`}
                    />
                ))}

                <!-- Corner markings for blueprint feel -->
                <div class="absolute top-6 left-6 w-3 h-3 border-t-2 border-l-2 border-black/15"></div>
                <div class="absolute top-6 right-6 w-3 h-3 border-t-2 border-r-2 border-black/15"></div>
                <div class="absolute bottom-6 left-6 w-3 h-3 border-b-2 border-l-2 border-black/15"></div>
                <div class="absolute bottom-6 right-6 w-3 h-3 border-b-2 border-r-2 border-black/15"></div>
            </div>

            <!-- Configuration List (1/3 width on desktop, compact cards) -->
            <div class="flex flex-col gap-3 order-1 lg:order-2 lg:col-span-1">
                {layouts.map((layout, i) => (
                    <button
                        class={`layout-selector-btn group flex flex-col px-5 py-4 rounded-2xl border transition-all duration-500 text-left ${i === 0 ? 'bg-black text-white border-black shadow-[0_12px_30px_rgba(0,0,0,0.12)]' : 'bg-white border-black/10 text-black/40 hover:border-black/30 hover:text-black/70'}`}
                        data-index={i}
                    >
                        <div class="flex items-center justify-between mb-1.5">
                            <span class={`text-[9px] font-black uppercase tracking-[0.25em] font-label ${i === 0 ? 'text-[#E50000]' : 'text-black/30'}`}>Configuration {i + 1}</span>
                            <div class={`dot w-1.5 h-1.5 rounded-full transition-colors duration-500 ${i === 0 ? 'bg-[#E50000]' : 'bg-black/10'}`}></div>
                        </div>
                        <h3 class={`desc text-base md:text-lg font-black uppercase tracking-tight leading-tight transition-colors duration-500 ${i === 0 ? 'text-white/60' : 'text-black/40'}`}>{layout.desc}</h3>
                    </button>
                ))}
            </div>
        </div>
    </div>
</section>

<script>
    function initLayoutSelectors() {
        const btns = document.querySelectorAll('.layout-selector-btn');
        const imgs = document.querySelectorAll('.layout-preview-img');

        btns.forEach(btn => {
            btn.addEventListener('click', () => {
                const index = btn.getAttribute('data-index');

                // Reset buttons
                btns.forEach(b => {
                    b.classList.remove('bg-black', 'text-white', 'border-black', 'shadow-[0_20px_50px_rgba(0,0,0,0.15)]');
                    b.classList.add('bg-white', 'border-black/10', 'text-black/40');

                    const label = b.querySelector('.font-label');
                    if (label) {
                        label.classList.add('text-black/30');
                        label.classList.remove('text-[#E50000]');
                    }

                    const dot = b.querySelector('.dot');
                    if (dot) {
                        dot.classList.add('bg-black/10');
                        dot.classList.remove('bg-[#E50000]');
                    }

                    const desc = b.querySelector('.desc');
                    if (desc) {
                        desc.classList.add('text-black/40');
                        desc.classList.remove('text-white/60');
                    }
                });

                // Active button
                btn.classList.add('bg-black', 'text-white', 'border-black', 'shadow-[0_20px_50px_rgba(0,0,0,0.15)]');
                btn.classList.remove('bg-white', 'border-black/10', 'text-black/40');

                const label = btn.querySelector('.font-label');
                if (label) {
                    label.classList.remove('text-black/30');
                    label.classList.add('text-[#E50000]');
                }

                const dot = btn.querySelector('.dot');
                if (dot) {
                    dot.classList.remove('bg-black/10');
                    dot.classList.add('bg-[#E50000]');
                }

                const desc = btn.querySelector('.desc');
                if (desc) {
                    desc.classList.remove('text-black/40');
                    desc.classList.add('text-white/60');
                }

                // Switch images
                imgs.forEach(img => {
                    img.classList.remove('opacity-100', 'scale-100', 'translate-y-0');
                    img.classList.add('opacity-0', 'scale-95', 'translate-y-8', 'pointer-events-none');
                });

                const targetImg = document.getElementById(`layout-img-${index}`);
                if (targetImg) {
                    targetImg.classList.add('opacity-100', 'scale-100', 'translate-y-0');
                    targetImg.classList.remove('opacity-0', 'scale-95', 'translate-y-8', 'pointer-events-none');
                }
            });
        });
    }

    // Run on first load
    initLayoutSelectors();
    // Run on view transitions if using them
    document.addEventListener('astro:after-swap', initLayoutSelectors);
</script>
