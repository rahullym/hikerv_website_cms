<script>
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const status = document.getElementById('newsletter-status') as HTMLParagraphElement | null;
    const btn = document.getElementById('newsletter-submit') as HTMLButtonElement | null;
    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form || !status || !btn) return;
        status.style.color = ''; status.textContent = '';
        const data = new FormData(form);
        const email = String(data.get('email') ?? '').trim();
        const website = String(data.get('website') ?? '');
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            status.style.color = '#ff8a8a';
            status.textContent = 'Please enter a valid email address.';
            return;
        }
        const original = btn.textContent;
        btn.disabled = true; btn.textContent = 'Subscribing…';
        try {
            const res = await fetch('/api/subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, website }),
            });
            if (res.ok) {
                const body = await res.json().catch(() => ({}));
                status.style.color = '#9be38b';
                status.textContent = body.alreadySubscribed
                    ? 'You’re already on the list — thanks!'
                    : 'Thanks — you’re subscribed.';
                form.reset();
            } else {
                const body = await res.json().catch(() => ({} as { error?: string }));
                status.style.color = '#ff8a8a';
                status.textContent = body.error || 'Could not subscribe. Please try again.';
            }
        } catch {
            status.style.color = '#ff8a8a';
            status.textContent = 'Network error. Please try again.';
        } finally {
            btn.disabled = false; btn.textContent = original;
        }
    });
</script>
