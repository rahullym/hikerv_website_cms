---
import { Image } from "astro:assets";
import model01 from "../assets/rover-series.png";
import model02 from "../assets/drifter-series.png";
import model03 from "../assets/elite-series.png";
---

<!-- Navbar Top Border/Progress Line -->
<div class="fixed top-0 left-0 h-[3px] bg-[#E50000] z-[100] transition-all duration-150 origin-left" id="scroll-progress" style="width: 0%"></div>

<nav
    class="fixed top-0 left-0 w-full py-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] bg-transparent"
    style="z-index: 50;"
    id="main-nav"
>
    <!-- Dark gradient backing for standard navbar legibility -->
    <div id="nav-backdrop" class="absolute inset-0 bg-gradient-to-b from-black/80 to-transparent pointer-events-none transition-opacity duration-500"></div>

    <div class="w-full max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-14 flex items-center justify-between relative z-[100]">
        <!-- Left: Menu Toggle (Porsche Style) -->
        <button id="menu-toggle" class="flex items-center gap-4 group text-white hover:text-[#E50000] transition-colors duration-300 z-[100]">
            <div class="relative w-8 h-8 flex items-center justify-center">
                <!-- Top Line -->
                <div id="burger-1" class="absolute w-6 h-[1.5px] bg-current transition-all duration-[400ms] -translate-y-2 group-hover:w-8"></div>
                <!-- Middle Line -->
                <div id="burger-2" class="absolute w-6 h-[1.5px] bg-current transition-all duration-[400ms]"></div>
                <!-- Bottom Line -->
                <div id="burger-3" class="absolute w-6 h-[1.5px] bg-current transition-all duration-[400ms] translate-y-2 group-hover:w-4"></div>
            </div>
            <span class="text-[12px] font-bold uppercase tracking-[0.2em] hidden md:block">Menu</span>
        </button>

        <!-- Center: Logo -->
        <div id="nav-logo" class="absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 transition-opacity duration-300">
            <a href="/" class="flex items-center justify-center transition-all duration-500 hover:scale-[1.03] active:scale-95 group px-4 py-2">
                <img src="/hikerv.png" alt="Hike RV Logo" class="h-10 sm:h-12 md:h-14 w-auto object-contain drop-shadow-lg" />
            </a>
        </div>

        <!-- Right: CTA -->
        <div id="nav-cta" class="flex items-center gap-8 z-[60] transition-opacity duration-300">
            <a href="#contact" class="hidden md:flex items-center gap-3 text-white group relative px-6 py-2 transition-all duration-300">
                <span class="relative z-10 text-[11px] font-bold uppercase tracking-[0.2em] group-hover:text-[#E50000] transition-colors">Contact Us</span>
                <div class="absolute bottom-0 left-0 w-full h-[1.5px] bg-[#E50000] scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-right"></div>
            </a>
    </div>
</nav>

    <!-- ░░ Sidebar Backdrop ░░ -->
    <div id="menu-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-md z-[70] opacity-0 pointer-events-none transition-all duration-500"></div>

    <!-- ░░ TWO-COLUMN SIDEBAR SYSTEM ░░ -->
    <div id="sidebar-wrapper" class="menu-closed fixed top-0 left-0 h-[100vh] z-[80] flex pointer-events-none">
        
        <!-- PANEL 1: MAIN MENU -->
        <div id="panel-main" class="h-full w-[85vw] md:w-[400px] lg:w-[450px] shrink-0 bg-[#fdfdfd] shadow-[20px_0_50px_rgba(0,0,0,0.15)] flex flex-col pointer-events-auto relative z-20 transition-transform duration-[600ms] ease-[cubic-bezier(0.16,1,0.3,1)]">
            
            <div class="w-full px-8 md:px-12 pt-12 pb-6 flex items-center justify-between border-b border-black/5 relative justify-between">
                <span class="text-black text-[10px] md:text-xs font-black uppercase tracking-[0.3em]">Hike RV Main</span>
                <button id="inner-close" class="text-black/50 hover:text-[#E50000] text-[10px] font-bold uppercase tracking-[0.2em] transition-colors p-2">Close</button>
            </div>

            <div class="w-full h-full pb-20 px-8 md:px-12 flex flex-col justify-center bg-[#fdfdfd]">
                <div class="flex flex-col gap-6">
                    <button id="btn-models" class="group flex items-center justify-between py-4 border-b border-black/5 text-left transition-all duration-300 hover:pl-4">
                        <span class="text-4xl md:text-5xl lg:text-[52px] leading-none font-black uppercase tracking-tighter text-black">Models</span>
                        <svg class="w-8 h-8 text-[#E50000] opacity-0 group-hover:opacity-100 transition-opacity transform -translate-x-4 group-hover:translate-x-0 duration-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    </button>
                    <a href="/about" class="nav-link group flex items-center justify-between py-4 border-b border-black/5 text-left transition-all duration-300 hover:pl-4">
                        <span class="text-4xl md:text-5xl lg:text-[52px] leading-none font-black uppercase tracking-tighter text-black/30 group-hover:text-black">About Us</span>
                    </a>
                    <a href="/warranty" class="nav-link group flex items-center justify-between py-4 border-b border-black/5 text-left transition-all duration-300 hover:pl-4">
                        <span class="text-4xl md:text-5xl lg:text-[52px] leading-none font-black uppercase tracking-tighter text-black/30 group-hover:text-black">Warranty</span>
                    </a>
                    <a href="/videos" class="nav-link group flex items-center justify-between py-4 border-b border-black/5 text-left transition-all duration-300 hover:pl-4">
                        <span class="text-4xl md:text-5xl lg:text-[52px] leading-none font-black uppercase tracking-tighter text-black/30 group-hover:text-black">Videos</span>
                    </a>
                    <a href="#machine" class="nav-link group flex items-center justify-between py-4 border-b border-black/5 text-left transition-all duration-300 hover:pl-4">
                        <span class="text-4xl md:text-5xl lg:text-[52px] leading-none font-black uppercase tracking-tighter text-black/30 group-hover:text-black">Machine</span>
                    </a>
                    <a href="#collection" class="nav-link group flex items-center justify-between py-4 border-b border-black/5 text-left transition-all duration-300 hover:pl-4">
                        <span class="text-4xl md:text-5xl lg:text-[52px] leading-none font-black uppercase tracking-tighter text-black/30 group-hover:text-black">Gallery</span>
                    </a>
                </div>

                <div class="mt-16 pt-8 border-t border-black/5">
                    <a href="#contact" class="text-xs font-black uppercase tracking-[0.2em] text-[#E50000] hover:text-black transition-colors relative group py-2 inline-block">
                        Contact An Advisor
                        <div class="absolute bottom-0 left-0 w-8 h-[2px] bg-[#E50000] group-hover:w-full transition-all duration-500"></div>
                    </a>
                </div>
            </div>
            
        </div>

        <!-- PANEL 2: MODELS SUBMENU (Slides out to the right) -->
        <div id="panel-models" class="absolute md:relative top-0 left-0 md:left-auto h-full w-[85vw] md:w-[400px] lg:w-[450px] shrink-0 bg-[#f4f4f4] md:border-l border-black/5 flex flex-col pointer-events-auto z-10 transition-transform duration-[600ms] ease-[cubic-bezier(0.16,1,0.3,1)] overflow-hidden">
            
            <div class="w-full px-8 md:px-12 pt-12 pb-6 flex items-center justify-between border-b border-black/5 relative">
                <button id="btn-back" class="flex items-center gap-3 text-black/40 hover:text-[#E50000] text-[10px] font-bold uppercase tracking-[0.2em] transition-colors group w-fit">
                    <svg class="w-4 h-4 transform group-hover:-translate-x-1.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    Back
                </button>
            </div>

            <div class="w-full h-full pb-20 pt-8 px-8 md:px-12 flex flex-col overflow-y-auto scroller-hide">
                <h3 class="text-[10px] font-black uppercase tracking-[0.3em] text-[#E50000] mb-6">Select a Model</h3>
                <div class="flex flex-col gap-4">
                    
                    <a href="/rover" class="nav-link group flex flex-col p-5 rounded-3xl bg-white border border-black/5 hover:border-[#E50000]/30 hover:shadow-[0_10px_40px_rgba(0,0,0,0.06)] transition-all duration-500 hover:-translate-y-1">
                        <div class="w-full h-36 md:h-40 bg-[#111] rounded-2xl flex items-center justify-center group-hover:bg-[#E50000]/5 transition-colors duration-500 relative overflow-hidden mb-5">
                            <img src="/roverbg.png" alt="Rover Model" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                        </div>
                        <div class="flex items-center justify-between px-2">
                            <span class="text-3xl font-black uppercase tracking-tight text-black">Rover</span>
                            <svg class="w-6 h-6 text-[#E50000] opacity-0 group-hover:opacity-100 transform -translate-x-4 group-hover:translate-x-0 transition-all duration-500 delay-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        </div>
                    </a>

                    <a href="/drifter" class="nav-link group flex flex-col p-5 rounded-3xl bg-white border border-black/5 hover:border-[#E50000]/30 hover:shadow-[0_10px_40px_rgba(0,0,0,0.06)] transition-all duration-500 hover:-translate-y-1">
                        <div class="w-full h-36 md:h-40 bg-[#111] rounded-2xl flex items-center justify-center group-hover:bg-[#E50000]/5 transition-colors duration-500 relative overflow-hidden mb-5">
                            <img src="/drifterbg.png" alt="Drifter Model" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                        </div>
                        <div class="flex items-center justify-between px-2">
                            <span class="text-3xl font-black uppercase tracking-tight text-black">Drifter</span>
                            <svg class="w-6 h-6 text-[#E50000] opacity-0 group-hover:opacity-100 transform -translate-x-4 group-hover:translate-x-0 transition-all duration-500 delay-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        </div>
                    </a>

                    <a href="/elite" class="nav-link group flex flex-col p-5 rounded-3xl bg-white border border-black/5 hover:border-[#E50000]/30 hover:shadow-[0_10px_40px_rgba(0,0,0,0.06)] transition-all duration-500 hover:-translate-y-1">
                        <div class="w-full h-36 md:h-40 bg-[#111] rounded-2xl flex items-center justify-center group-hover:bg-[#E50000]/5 transition-colors duration-500 relative overflow-hidden mb-5">
                            <Image src={model03} alt="Elite Series" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]" />
                        </div>
                        <div class="flex items-center justify-between px-2">
                            <div class="flex flex-col">
                                <span class="text-[#E50000] text-[9px] uppercase tracking-widest font-black mb-1">Flagship</span>
                                <span class="text-3xl font-black uppercase tracking-tight text-black">Elite</span>
                            </div>
                            <svg class="w-6 h-6 text-[#E50000] opacity-0 group-hover:opacity-100 transform -translate-x-4 group-hover:translate-x-0 transition-all duration-500 delay-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        </div>
                    </a>

                </div>
            </div>
            
        </div>

    </div>

<script>
    const nav = document.getElementById("main-nav");
    const backdrop = document.getElementById("nav-backdrop");
    const menuBackdrop = document.getElementById("menu-backdrop");
    const sidebarWrapper = document.getElementById("sidebar-wrapper");
    
    // Toggle Controllers
    const menuToggle = document.getElementById("menu-toggle");
    const innerClose = document.getElementById("inner-close");
    const btnModels = document.getElementById("btn-models");
    const btnBack = document.getElementById("btn-back");

    const navLogo = document.getElementById("nav-logo");
    const navCta = document.getElementById("nav-cta");
    const progressBar = document.getElementById("scroll-progress");

    // State
    let isMenuOpen = false;

    // Submenu Handlers
    btnModels?.addEventListener("click", () => {
        sidebarWrapper?.classList.remove("menu-open");
        sidebarWrapper?.classList.add("models-open");
    });

    // Desktop hover support for Models
    btnModels?.addEventListener("mouseenter", () => {
        if (window.innerWidth >= 768) {
            sidebarWrapper?.classList.remove("menu-open");
            sidebarWrapper?.classList.add("models-open");
        }
    });

    const panelModels = document.getElementById("panel-models");
    const panelMain = document.getElementById("panel-main");

    // Close submenu when mouse leaves the sidebar area back to the main panel
    panelModels?.addEventListener("mouseleave", (e) => {
        if (window.innerWidth >= 768) {
            const related = e.relatedTarget as HTMLElement;
            // If we move back to panel-main or outside entirely, go back to menu-open
            if (panelMain?.contains(related) || !sidebarWrapper?.contains(related)) {
                sidebarWrapper?.classList.remove("models-open");
                sidebarWrapper?.classList.add("menu-open");
            }
        }
    });

    btnBack?.addEventListener("click", () => {
        sidebarWrapper?.classList.remove("models-open");
        sidebarWrapper?.classList.add("menu-open");
    });

    // Scroll Progress
    let lastScroll = 0;
    window.addEventListener("scroll", () => {
        const scrolled = window.scrollY;
        
        const winHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolledPerc = (scrolled / winHeight) * 100;
        if (progressBar) progressBar.style.width = `${scrolledPerc}%`;

        if (scrolled > lastScroll && scrolled > 150) {
            nav?.classList.add("-translate-y-full");
        } else {
            nav?.classList.remove("-translate-y-full");
        }
        
        lastScroll = scrolled;

        if (scrolled > 50) {
            nav?.classList.add("bg-black/90", "backdrop-blur-xl", "py-4");
            nav?.classList.remove("py-8", "bg-transparent");
            if(backdrop) backdrop.style.opacity = '0'; 
        } else {
            nav?.classList.remove("bg-black/90", "backdrop-blur-xl", "py-4");
            nav?.classList.add("py-8", "bg-transparent");
            if(backdrop) backdrop.style.opacity = '1';
        }
    });

    // Toggle logic
    function toggleMenu() {
        if (isMenuOpen) closeMenu();
        else openMenu();
    }

    menuToggle?.addEventListener("click", toggleMenu);
    innerClose?.addEventListener("click", closeMenu);
    menuBackdrop?.addEventListener("click", closeMenu);

    function openMenu() {
        isMenuOpen = true;
        
        if (menuBackdrop) {
            menuBackdrop.classList.remove("opacity-0", "pointer-events-none");
            menuBackdrop.classList.add("opacity-100", "pointer-events-auto");
        }

        // Apply open state
        sidebarWrapper?.classList.remove("menu-closed", "models-open");
        sidebarWrapper?.classList.add("menu-open");

        document.body.style.overflow = "hidden";
        
        if (navLogo) navLogo.style.opacity = "0";
        if (navCta) navCta.style.opacity = "0";
        if (menuToggle) {
            menuToggle.style.opacity = "0";
            menuToggle.style.pointerEvents = "none";
        }
    }

    function closeMenu() {
        isMenuOpen = false;

        if (menuBackdrop) {
            menuBackdrop.classList.add("opacity-0", "pointer-events-none");
            menuBackdrop.classList.remove("opacity-100", "pointer-events-auto");
        }

        // Reset to closed state natively
        sidebarWrapper?.classList.remove("menu-open", "models-open");
        sidebarWrapper?.classList.add("menu-closed");

        document.body.style.overflow = "";

        if (navLogo) navLogo.style.opacity = "1";
        if (navCta) navCta.style.opacity = "1";
        if (menuToggle) {
            menuToggle.style.opacity = "1";
            menuToggle.style.pointerEvents = "auto";
        }
    }

    document.querySelectorAll(".nav-link").forEach(link => {
        link.addEventListener("click", () => closeMenu());
    });

    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
    });
</script>

<style>
    /* 
       Native state management flawlessly overriding Tailwind layers
       mathematically preventing render collisions.
    */
    .menu-closed #panel-main {
        transform: translateX(-100%);
    }
    .menu-open #panel-main {
        transform: translateX(0);
    }
    .models-open #panel-main {
        transform: translateX(0);
    }

    /* Mobile Logic (<768px) */
    @media (max-width: 767px) {
        .menu-closed #panel-models { transform: translateX(-100%); }
        .menu-open #panel-models { transform: translateX(-100%); }
        .models-open #panel-models { transform: translateX(0); }
        .models-open #panel-main { transform: translateX(-100%); }
    }

    /* Desktop Submenu Logic (>=768px). Extends seamlessly identically sideways. */
    @media (min-width: 768px) {
        .menu-closed #panel-models { transform: translateX(-200%); }
        .menu-open #panel-models { transform: translateX(-100%); }
        .models-open #panel-models { transform: translateX(0); }
    }

    .scroller-hide::-webkit-scrollbar {
        display: none;
    }
    .scroller-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
