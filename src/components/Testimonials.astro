---
const reviews = [
    {
        name: "Daniel Whitmore",
        initial: "D",
        date: "2 weeks ago",
        rating: 5,
        text: "From the first showroom walk-through to handover day, the Hike RV team was exceptional. The build quality on our Grand Rover is unmatched — every weld, every finish, every detail. Three months on the road and not a single rattle."
    },
    {
        name: "Sarah Mendelson",
        initial: "S",
        date: "1 month ago",
        rating: 5,
        text: "We did months of research before settling on Hike RV, and it was the right call. The off-grid setup is genuinely capable — solar, lithium, water capacity all dialled in. Took it through the Flinders without issue."
    },
    {
        name: "Mark Thompson",
        initial: "M",
        date: "3 weeks ago",
        rating: 5,
        text: "Custom interior trim, exact spec, on time. The team understood what we wanted, suggested smarter alternatives where it mattered, and delivered a caravan that feels like ours from day one. Worth every dollar."
    },
    {
        name: "Linda Caruso",
        initial: "L",
        date: "2 months ago",
        rating: 5,
        text: "The aftercare is what sets them apart. Had a tiny issue with a window seal six weeks in — sorted same week, no fuss, no invoice. That kind of follow-through is rare."
    },
    {
        name: "James O'Brien",
        initial: "J",
        date: "5 weeks ago",
        rating: 5,
        text: "Toured the Campbellfield workshop before ordering. You can see the difference between assembly-line builds and craft. Hike is the latter. The chassis work alone convinced me."
    },
    {
        name: "Rebecca Hayes",
        initial: "R",
        date: "1 month ago",
        rating: 5,
        text: "First-time caravan owners and they took the time to walk us through every system. No rushed handover, no pressure, just patient and thorough. The Wild Drifter has been a dream for our family."
    }
];

const overall = { score: "4.9", count: "1,200+", platform: "Google Reviews" };
---

<section id="testimonials" class="relative z-10 w-full py-24 md:py-40 bg-[#fcfcfc] text-black overflow-hidden border-t border-black/5">

    <!-- Subtle background glow -->
    <div class="absolute top-1/4 -left-[10%] w-[40vw] h-[40vw] max-w-[600px] max-h-[600px] bg-[#E50000]/[0.04] rounded-full blur-[150px] pointer-events-none"></div>
    <div class="absolute bottom-0 -right-[10%] w-[40vw] h-[40vw] max-w-[600px] max-h-[600px] bg-black/[0.03] rounded-full blur-[150px] pointer-events-none"></div>

    <div class="max-w-[1600px] mx-auto px-6 md:px-14 relative z-10">

        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 md:mb-24 gap-10">
            <div class="max-w-2xl">
                <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up">Verified On Google</span>
                <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-[0.9] text-black animate-fade-up" style="animation-delay: 200ms;">
                    What Our<br/><span class="text-[#E50000]">Customers Say.</span>
                </h2>
                <p class="text-black/50 font-medium md:text-lg mt-8 leading-relaxed max-w-xl animate-fade-up" style="animation-delay: 400ms;">
                    A decade of building caravans worth talking about — and over a thousand owners who do.
                </p>
            </div>

            <!-- Rating Summary Card -->
            <div class="bg-white border border-black/5 rounded-[2rem] p-6 md:p-8 shadow-[0_20px_60px_rgba(0,0,0,0.06)] flex items-center gap-6 animate-fade-up" style="animation-delay: 500ms;">
                <!-- Google G -->
                <div class="w-12 h-12 md:w-14 md:h-14 shrink-0 rounded-full bg-white border border-black/5 flex items-center justify-center shadow-[0_4px_12px_rgba(0,0,0,0.04)]">
                    <svg class="w-6 h-6 md:w-7 md:h-7" viewBox="0 0 48 48">
                        <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
                        <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
                        <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0124 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
                        <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 01-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
                    </svg>
                </div>
                <div class="flex flex-col">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-3xl md:text-4xl font-black text-black tracking-tighter leading-none">{overall.score}</span>
                        <div class="flex items-center gap-0.5">
                            {[1,2,3,4,5].map(() => (
                                <svg class="w-3.5 h-3.5 md:w-4 md:h-4 text-[#FFB400]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279L12 18.896l-7.416 4.517 1.48-8.279L0 9.306l8.332-1.151z"/></svg>
                            ))}
                        </div>
                    </div>
                    <span class="text-black/50 text-[10px] md:text-xs font-bold uppercase tracking-[0.2em]">{overall.count} {overall.platform}</span>
                </div>
            </div>
        </div>

        <!-- Reviews Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            {reviews.map((review, i) => (
                <article
                    class="group relative flex flex-col bg-white rounded-[2rem] border border-black/5 p-8 md:p-10 transition-all duration-700 hover:-translate-y-2 hover:shadow-[0_30px_60px_rgba(0,0,0,0.08)] hover:border-[#E50000]/20 animate-fade-up"
                    style={`animation-delay: ${600 + (i * 100)}ms;`}
                >
                    <!-- Top Row: Stars + Google Glyph -->
                    <div class="flex items-center justify-between mb-6">
                        <div class="flex items-center gap-1">
                            {Array.from({length: review.rating}).map(() => (
                                <svg class="w-4 h-4 text-[#FFB400]" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279L12 18.896l-7.416 4.517 1.48-8.279L0 9.306l8.332-1.151z"/></svg>
                            ))}
                        </div>
                        <svg class="w-5 h-5 opacity-80 group-hover:opacity-100 transition-opacity duration-500" viewBox="0 0 48 48">
                            <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
                            <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
                            <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0124 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
                            <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 01-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
                        </svg>
                    </div>

                    <!-- Quote -->
                    <p class="text-black/70 text-base md:text-[15px] font-medium leading-relaxed mb-8 flex-1">
                        “{review.text}”
                    </p>

                    <!-- Author -->
                    <div class="flex items-center gap-4 pt-6 border-t border-black/5">
                        <div class="w-11 h-11 shrink-0 rounded-full bg-[#E50000] text-white flex items-center justify-center font-black text-sm tracking-wide">
                            {review.initial}
                        </div>
                        <div class="flex flex-col">
                            <span class="text-black font-black text-sm uppercase tracking-wide">{review.name}</span>
                            <span class="text-black/40 text-[10px] font-bold uppercase tracking-[0.2em] mt-0.5">{review.date}</span>
                        </div>
                    </div>

                    <!-- Hover accent line -->
                    <div class="absolute bottom-0 left-10 right-10 h-px bg-gradient-to-r from-transparent via-[#E50000]/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                </article>
            ))}
        </div>

        <!-- Footer CTA -->
        <div class="mt-16 md:mt-24 flex flex-col md:flex-row items-center justify-between gap-8 pt-12 border-t border-black/5">
            <p class="text-black/40 text-[10px] md:text-xs font-bold uppercase tracking-[0.3em] text-center md:text-left">
                Real Owners. Real Roads. Real Stories.
            </p>
            <a href="https://www.google.com/search?q=hike+rv+caravans+reviews" target="_blank" rel="noopener noreferrer"
               class="group inline-flex items-center gap-3 px-8 py-4 bg-black text-white rounded-full font-black uppercase tracking-[0.2em] text-[10px] md:text-xs hover:bg-[#E50000] transition-all duration-500 shadow-[0_10px_30px_rgba(0,0,0,0.1)]">
                <span>Read All Reviews</span>
                <svg class="w-3.5 h-3.5 transition-transform duration-500 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
            </a>
        </div>
    </div>
</section>

<style>
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }
</style>
