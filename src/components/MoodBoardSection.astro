---
const moodBoards = [
    { name: "Billabong", image: "/Hike RV Mood Boards/Hike RV Mood Board Billabong.jpg", desc: "A serene blend of natural textures and cool tones." },
    { name: "Outrider", image: "/Hike RV Mood Boards/Hike RV Mood Board Outrider.jpg", desc: "Rugged elegance with bold contrasts and warm accents." },
    { name: "Roamer", image: "/Hike RV Mood Boards/Hike RV Mood Board Roamer.jpg", desc: "Minimalist sophistication for the modern explorer." },
    { name: "Sundown", image: "/Hike RV Mood Boards/Hike RV Mood Board Sundown.jpg", desc: "Warm, inviting palettes inspired by the golden hour." },
    { name: "Trackside", image: "/Hike RV Mood Boards/Hike RV Mood Board Trackside.jpg", desc: "Sporty and dynamic with technical finishes." }
];
---

<section id="mood-boards" class="relative z-10 w-full py-24 md:py-40 bg-white overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-black/5 to-transparent"></div>
    <div class="absolute -top-[20%] -right-[10%] w-[50vw] h-[50vw] bg-black/[0.02] rounded-full blur-[120px] pointer-events-none"></div>

    <div class="max-w-[1600px] mx-auto px-6 md:px-14">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 md:mb-24 gap-8">
            <div class="max-w-2xl">
                <span class="text-[#E50000] font-black uppercase tracking-[0.4em] text-[10px] md:text-xs mb-4 block animate-fade-up">Personalization</span>
                <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-tighter leading-[0.9] text-black animate-fade-up" style="animation-delay: 200ms;">
                    Interior <br/><span class="text-[#E50000]">Styling.</span>
                </h2>
                <p class="text-black/50 font-medium md:text-lg mt-8 leading-relaxed max-w-xl animate-fade-up" style="animation-delay: 400ms;">
                    Your RV is an extension of your lifestyle. Choose from our curated selection of interior mood boards to define your sanctuary on the road.
                </p>
            </div>
            <div class="hidden md:block">
                <div class="flex items-center gap-4 text-[10px] font-bold uppercase tracking-[0.3em] text-black/30">
                    <span>Explore Options</span>
                    <div class="w-20 h-px bg-black/10"></div>
                </div>
            </div>
        </div>

        <!-- Mood Board Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">
            {moodBoards.map((board, i) => (
                <div 
                    class="group relative flex flex-col bg-[#f8f8f8] rounded-[2rem] overflow-hidden border border-black/5 transition-all duration-700 hover:shadow-[0_30px_60px_rgba(0,0,0,0.1)] hover:-translate-y-2 animate-fade-up"
                    style={`animation-delay: ${600 + (i * 100)}ms;`}
                >
                    <!-- Image Container -->
                    <div class="relative aspect-[4/5] overflow-hidden">
                        <img 
                            src={board.image} 
                            alt={board.name} 
                            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                        
                        <!-- Hover Action Button -->
                        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 z-20">
                            <button class="view-mood-board px-6 py-3 bg-white text-black font-black uppercase tracking-[0.2em] text-[9px] rounded-full shadow-xl hover:bg-[#E50000] hover:text-white transition-all duration-300" data-img={board.image} data-name={board.name}>
                                Full Preview
                            </button>
                        </div>
                    </div>

                    <!-- Info Area -->
                    <div class="p-8 flex flex-col flex-1">
                        <h3 class="text-xl font-black uppercase tracking-tight text-black mb-2">{board.name}</h3>
                        <p class="text-black/40 text-xs font-medium leading-relaxed">
                            {board.desc}
                        </p>
                    </div>
                    
                    <!-- Decorative corner accent -->
                    <div class="absolute top-0 right-0 w-12 h-12 bg-black/[0.03] rounded-bl-3xl translate-x-4 -translate-y-4 group-hover:translate-x-0 group-hover:translate-y-0 transition-transform duration-500"></div>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Lightbox Modal (Script handled globally or here) -->
<div id="mood-board-modal" class="fixed inset-0 z-[100] bg-black/95 flex items-center justify-center opacity-0 pointer-events-none transition-all duration-500 backdrop-blur-xl">
    <button id="close-mood-modal" class="absolute top-10 right-10 p-4 text-white/50 hover:text-white hover:rotate-90 transition-all duration-500 z-[110]">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    
    <div class="relative max-w-[90vw] max-h-[85vh] flex flex-col items-center">
        <h4 id="modal-board-name" class="text-white font-black uppercase tracking-[0.5em] text-xs md:text-sm mb-6 opacity-0 translate-y-4 transition-all duration-700"></h4>
        <div class="relative overflow-hidden rounded-2xl shadow-2xl scale-95 opacity-0 transition-all duration-700" id="modal-img-container">
            <img id="modal-mood-img" src="" alt="Mood Board Preview" class="max-w-full max-h-[75vh] object-contain shadow-2xl" />
        </div>
    </div>
</div>

<script>
    function initMoodBoards() {
        const modal = document.getElementById('mood-board-modal');
        const modalImg = document.getElementById('modal-mood-img') as HTMLImageElement;
        const modalName = document.getElementById('modal-board-name');
        const modalContainer = document.getElementById('modal-img-container');
        const closeBtn = document.getElementById('close-mood-modal');
        const viewBtns = document.querySelectorAll('.view-mood-board');

        function openModal(img: string, name: string) {
            if (!modal || !modalImg || !modalName || !modalContainer) return;
            
            modalImg.src = img;
            modalName.textContent = name;
            
            modal.classList.remove('opacity-0', 'pointer-events-none');
            
            setTimeout(() => {
                modalName.classList.remove('opacity-0', 'translate-y-4');
                modalContainer.classList.remove('opacity-0', 'scale-95');
            }, 100);
        }

        function closeModal() {
            if (!modal || !modalName || !modalContainer) return;
            
            modalName.classList.add('opacity-0', 'translate-y-4');
            modalContainer.classList.add('opacity-0', 'scale-95');
            
            setTimeout(() => {
                modal.classList.add('opacity-0', 'pointer-events-none');
            }, 300);
        }

        viewBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const img = btn.getAttribute('data-img');
                const name = btn.getAttribute('data-name');
                if (img && name) openModal(img, name);
            });
        });

        closeBtn?.addEventListener('click', closeModal);
        modal?.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
        });

        // Close on ESC
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });
    }

    // Run on load
    initMoodBoards();
</script>

<style>
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }
</style>
